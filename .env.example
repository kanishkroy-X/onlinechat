# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Example: https://your-real-domain.com
PUBLIC_SITE_URL=

# Public inbox shown on /contact and in the footer.
# Example: hello@your-real-domain.com
PUBLIC_CONTACT_EMAIL=

# Google Analytics measurement ID. Leave empty to disable.
# PUBLIC_GA_ID=G-XXXXXXXXXX
PUBLIC_GA_ID=
