---
// SafetyModals.astro - Report and Block user dialogs with enhanced safety categorization
---

<!-- 1. REPORT USER MODAL -->
<div
  id="report-modal"
  class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="report-modal-title"
>
  <div class="w-full max-w-md bg-[var(--bg-surface)] border border-[var(--border)] rounded-3xl p-6 sm:p-7 flex flex-col gap-5 shadow-2xl animate-modal-in transition-colors text-left">
    <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-rose-500/15 text-rose-500 flex items-center justify-center font-bold">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
        </div>
        <h3 id="report-modal-title" class="text-base font-bold text-[var(--text-primary)]">Report & Block Stranger</h3>
      </div>
      <button type="button" id="report-close-btn" class="p-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
      Submitting a report will automatically sever your session, block this stranger from ever matching with you again, and submit their session hash for safety review.
    </p>

    <!-- Report Reasons Form -->
    <form id="report-form" class="flex flex-col gap-3">
      <div class="flex flex-col gap-1.5">
        <label for="report-reason-select" class="text-xs font-semibold text-[var(--text-secondary)]">Reason for report</label>
        <select
          id="report-reason-select"
          required
          class="w-full px-3 py-2.5 rounded-xl bg-[var(--bg-input)] border border-[var(--border)] text-[var(--text-primary)] text-xs focus:outline-none focus:border-rose-500 transition-colors cursor-pointer shadow-xs"
        >
          <option value="csam_underage">🚨 Child Safety / Underage user (Report to NCMEC)</option>
          <option value="harassment">Harassment / Hate speech</option>
          <option value="nonconsensual_media">Non-consensual sexual media</option>
          <option value="scam">Scam / Phishing / Bot solicitation</option>
          <option value="threatening">Threats or illegal activity</option>
          <option value="other">Other abusive behavior</option>
        </select>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="report-details-input" class="text-xs font-semibold text-[var(--text-secondary)]">Incident Details (optional)</label>
        <textarea
          id="report-details-input"
          rows="3"
          placeholder="Provide any additional context for moderators..."
          class="w-full px-3 py-2 rounded-xl bg-[var(--bg-input)] border border-[var(--border)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-xs focus:outline-none focus:border-rose-500 transition-colors shadow-xs"
        ></textarea>
      </div>

      <div class="flex items-center gap-3 mt-2">
        <button
          type="button"
          id="report-cancel-btn"
          class="w-1/2 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-semibold border border-[var(--border)] transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="report-submit-btn"
          class="w-1/2 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-all shadow-md cursor-pointer"
        >
          Submit & Block
        </button>
      </div>
    </form>
  </div>
</div>

<!-- 2. BLOCK USER MODAL -->
<div
  id="block-modal"
  class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-md flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="block-modal-title"
>
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border)] rounded-3xl p-6 sm:p-7 flex flex-col items-center gap-4 shadow-2xl text-center animate-modal-in transition-colors">
    <div class="w-12 h-12 rounded-2xl bg-rose-500/15 text-rose-500 flex items-center justify-center">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
    </div>

    <div class="flex flex-col gap-1">
      <h3 id="block-modal-title" class="text-lg font-bold text-[var(--text-primary)]">Block Stranger?</h3>
      <p id="block-modal-desc" class="text-xs text-[var(--text-secondary)] leading-relaxed">
        This will disconnect the chat immediately and ensure you never match with this session again.
      </p>
    </div>

    <div class="flex items-center gap-3 w-full mt-2">
      <button
        type="button"
        id="block-cancel-btn"
        class="w-1/2 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs font-semibold border border-[var(--border)] transition-colors cursor-pointer"
      >
        Cancel
      </button>
      <button
        type="button"
        id="block-confirm-btn"
        class="w-1/2 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-all shadow-md cursor-pointer"
      >
        Block Stranger
      </button>
    </div>
  </div>
</div>

<!-- 3. TOAST CONTAINER (For error & status alerts) -->
<div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none max-w-sm"></div>
