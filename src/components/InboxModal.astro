---
import { MOCK_INBOX_ITEMS } from '../data/mockData';
---

<div
  id="inbox-modal"
  class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-md flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="inbox-modal-title"
>
  <div class="w-full max-w-lg bg-[var(--bg-surface)] border border-[var(--border)] rounded-3xl p-6 sm:p-7 flex flex-col gap-5 shadow-2xl animate-modal-in max-h-[85vh] overflow-hidden transition-colors">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-xl bg-[#6C4DFF]/15 text-[#6C4DFF] flex items-center justify-center font-bold">
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <h3 id="inbox-modal-title" class="text-lg font-bold text-[var(--text-primary)]">Inbox</h3>
      </div>

      <button
        type="button"
        id="inbox-close-btn"
        class="p-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        aria-label="Close Inbox"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Tabs: All, Chats, Calls, Requests -->
    <div class="flex items-center gap-1.5 bg-[var(--bg-surface-elevated)] p-1 rounded-xl border border-[var(--border)]">
      <button
        type="button"
        class="inbox-tab-btn flex-1 py-1.5 rounded-lg text-xs font-semibold text-center transition-all bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border)] shadow-xs cursor-pointer"
        data-tab="all"
      >
        All
      </button>
      <button
        type="button"
        class="inbox-tab-btn flex-1 py-1.5 rounded-lg text-xs font-semibold text-center transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
        data-tab="chats"
      >
        Chats
      </button>
      <button
        type="button"
        class="inbox-tab-btn flex-1 py-1.5 rounded-lg text-xs font-semibold text-center transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
        data-tab="calls"
      >
        Calls
      </button>
      <button
        type="button"
        class="inbox-tab-btn flex-1 py-1.5 rounded-lg text-xs font-semibold text-center transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
        data-tab="requests"
      >
        Requests
      </button>
    </div>

    <!-- Thread List -->
    <div id="inbox-thread-list" class="flex flex-col gap-2 overflow-y-auto pr-1">
      {MOCK_INBOX_ITEMS.map((item) => (
        <div
          class="inbox-row p-3 rounded-2xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] flex items-center justify-between gap-3 transition-colors cursor-pointer shadow-xs"
          data-id={item.id}
          data-user-id={item.participant.id}
          data-type={item.type}
        >
          <div class="flex items-center gap-3 min-w-0">
            <div class="relative w-11 h-11 rounded-full overflow-hidden bg-[var(--bg-surface)] shrink-0 border border-[var(--border)] shadow-xs">
              <img src={item.participant.avatarUrl} alt={item.participant.username} class="w-full h-full object-cover" />
              {item.participant.isOnline && (
                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#18D889] border-2 border-[var(--bg-surface)]"></span>
              )}
            </div>

            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-2">
                <span class="text-sm font-bold text-[var(--text-primary)] truncate">{item.participant.username}</span>
                <span class="text-[10px] text-[var(--text-muted)] shrink-0">{item.timestamp}</span>
              </div>
              <p class="text-xs text-[var(--text-secondary)] truncate mt-0.5">
                {item.lastMessage}
              </p>
            </div>
          </div>

          {item.unreadCount > 0 && (
            <span class="w-5 h-5 rounded-full bg-[#6C4DFF] text-white text-[10px] font-bold flex items-center justify-center shrink-0 shadow-xs">
              {item.unreadCount}
            </span>
          )}
        </div>
      ))}
    </div>
  </div>
</div>
