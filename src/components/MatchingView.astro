---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<div id="matching-view" class="hidden w-full flex-1 max-w-md mx-auto flex flex-col items-center justify-center text-center p-4 sm:p-6 my-auto">
  
  <!-- STATE 1: SIGNATURE CONNECTION ORB (FINDING MATCH) -->
  <div id="matching-radar-container" class="w-full bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-8 shadow-2xl flex flex-col items-center gap-6 animate-in fade-in zoom-in-95 duration-200 relative overflow-hidden">
    <!-- Ambient Neon Background Aura -->
    <div class="absolute -top-16 -left-16 w-48 h-48 bg-[var(--color-sunset-pink)]/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-16 -right-16 w-48 h-48 bg-[var(--color-vice-cyan)]/20 rounded-full blur-3xl pointer-events-none"></div>

    <!-- The Signature Connection Orb -->
    <div class="relative w-44 h-44 sm:w-52 sm:h-52 flex items-center justify-center my-2">
      <!-- Expanding Radar Ripple Rings -->
      <div class="absolute inset-0 rounded-full border border-[var(--color-sunset-pink)]/35 animate-radar-wave"></div>
      <div class="absolute inset-4 rounded-full border border-[var(--color-vice-cyan)]/45 animate-radar-wave" style="animation-delay: 0.6s;"></div>
      <div class="absolute inset-8 rounded-full border border-[var(--color-neon-purple)]/55 animate-radar-wave" style="animation-delay: 1.2s;"></div>

      <!-- Orbiting Chat Elements -->
      <div class="absolute inset-2 animate-orb-orbit pointer-events-none">
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-7 h-7 rounded-full bg-gradient-to-tr from-[#FF5CA8] to-[#BC6CFF] flex items-center justify-center text-white text-[11px] shadow-lg shadow-[#FF5CA8]/50">
          💬
        </div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-6 rounded-full bg-gradient-to-tr from-[#00F0FF] to-[#BC6CFF] flex items-center justify-center text-white text-[10px] shadow-lg shadow-[#00F0FF]/50">
          ✨
        </div>
      </div>

      <!-- Core Neon Center Orb -->
      <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#FF5CA8] via-[#BC6CFF] to-[#00F0FF] p-1 shadow-2xl animate-orb-pulse z-10">
        <div class="w-full h-full rounded-full bg-[var(--bg-surface)] flex items-center justify-center text-white">
          <svg class="w-9 h-9 text-[var(--color-vice-cyan)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Status Headings -->
    <div class="flex flex-col gap-2 z-10">
      <h2 id="matching-status-title" class="text-xl sm:text-2xl font-black text-[var(--text-main)] tracking-tight">
        Finding someone awesome...
      </h2>
      <p id="matching-status-subtitle" class="text-xs sm:text-sm text-[var(--text-muted)] max-w-xs leading-relaxed">
        Please wait a moment while we connect you to a compatible stranger.
      </p>
    </div>

    <!-- Active Criteria Pill -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-[var(--text-subtle)] bg-[var(--bg-surface-elevated)] px-4 py-2 rounded-xl border border-[var(--border-color)] z-10">
      <span>Matching:</span>
      <span id="matching-pref-display" class="text-[var(--color-vice-cyan)] capitalize font-bold">Anyone</span>
      <div id="matching-pref-details" class="hidden flex items-center gap-1.5 border-l border-[var(--border-color)] pl-2">
        <span id="matching-country-display" class="hidden text-[var(--text-main)]"></span>
        <span id="matching-language-display" class="hidden text-[var(--text-main)]"></span>
      </div>
    </div>

    <!-- Cancel Button -->
    <button
      id="matching-cancel-btn"
      type="button"
      class="text-xs sm:text-sm font-semibold text-[var(--text-muted)] hover:text-red-400 py-2 px-5 rounded-xl border border-transparent hover:border-red-500/20 hover:bg-red-500/10 transition-all cursor-pointer z-10"
    >
      Cancel Matchmaking
    </button>
  </div>

  <!-- STATE 2: MATCH FOUND SEQUENCE (Avatars Gliding Together) -->
  <div id="match-found-container" class="hidden w-full bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-8 shadow-2xl flex flex-col items-center gap-6 relative overflow-hidden animate-in fade-in duration-300">
    <div class="absolute -top-16 left-1/2 -translate-x-1/2 w-56 h-56 bg-[var(--color-sunset-pink)]/25 rounded-full blur-3xl pointer-events-none"></div>

    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-sunset-pink)]/15 border border-[var(--color-sunset-pink)]/30 text-[var(--color-sunset-pink)] text-xs font-bold z-10">
      <span class="w-2 h-2 rounded-full bg-[var(--color-sunset-pink)] animate-pulse"></span>
      <span>Match Established!</span>
    </div>

    <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-main)] tracking-tight z-10">
      It's a Match! 🎉
    </h2>
    <p class="text-xs sm:text-sm text-[var(--text-muted)] max-w-xs z-10">
      You are now connected. Say hello and start the conversation!
    </p>

    <!-- Avatars Slide-Together Animation -->
    <div class="flex items-center justify-center gap-4 my-3 z-10">
      <!-- Me Avatar -->
      <div class="flex flex-col items-center gap-1.5 animate-avatar-left-in">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#00F0FF] to-[#BC6CFF] p-0.5 shadow-xl">
          <div class="w-full h-full rounded-2xl bg-[var(--bg-surface)] flex items-center justify-center text-xl font-black text-[var(--color-vice-cyan)]">
            You
          </div>
        </div>
        <span class="text-[11px] font-semibold text-[var(--text-subtle)]">You</span>
      </div>

      <!-- Connection Heart -->
      <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#FF5CA8] to-[#BC6CFF] flex items-center justify-center text-white text-base shadow-lg animate-match-heart">
        ❤️
      </div>

      <!-- Stranger Avatar -->
      <div class="flex flex-col items-center gap-1.5 animate-avatar-right-in">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-[#FF5CA8] to-[#BC6CFF] p-0.5 shadow-xl">
          <div class="w-full h-full rounded-2xl bg-[var(--bg-surface)] flex items-center justify-center text-xl font-black text-[var(--color-sunset-pink)]">
            <span id="match-found-stranger-letter">S</span>
          </div>
        </div>
        <span id="match-found-stranger-name" class="text-[11px] font-semibold text-[var(--text-main)]">Stranger</span>
      </div>
    </div>

    <!-- Start Chatting Direct Trigger CTA -->
    <button
      id="match-found-start-btn"
      type="button"
      class="gradient-vice-cta text-white font-bold text-sm sm:text-base px-8 py-3.5 rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-200 transform hover:scale-105 active:scale-95 cursor-pointer z-10 w-full"
    >
      Start Chatting &rarr;
    </button>
  </div>
</div>
