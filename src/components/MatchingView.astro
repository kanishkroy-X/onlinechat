---
import Icon from './icons/Icon.astro';
import { siteConfig } from '../config/site';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
---

<div id="matching-view" class="hidden w-full flex-1 max-w-md mx-auto flex flex-col items-center justify-center text-center p-4 sm:p-6 my-auto">
  
  <!-- RADAR / MATCHING CONTAINER -->
  <div id="matching-radar-container" class="w-full card-tactile p-8 shadow-2xl flex flex-col items-center gap-6 animate-modal-in relative overflow-hidden">
    
    <!-- Connection Radar Pulse -->
    <div class="relative w-32 h-32 sm:w-36 sm:h-36 flex items-center justify-center my-2">
      <div class="absolute inset-0 rounded-full bg-[var(--primary-soft)] animate-ping opacity-30"></div>
      <div class="w-16 h-16 rounded-2xl bg-[var(--primary)] text-white flex items-center justify-center shadow-lg z-10">
        <Icon name="refresh-cw" class="w-7 h-7 animate-spin" />
      </div>
    </div>

    <!-- Status Headings -->
    <div class="flex flex-col gap-2 z-10">
      <h2 id="matching-status-title" class="text-xl sm:text-2xl font-black text-[var(--text-primary)] tracking-tight">
        Connecting to 1-on-1 Chat...
      </h2>
      <p id="matching-status-subtitle" class="text-xs sm:text-sm text-[var(--text-secondary)] max-w-xs leading-relaxed">
        Searching for an active real stranger. We never use automated chat bots.
      </p>
    </div>

    <!-- Active Criteria Pill -->
    <div class="flex flex-wrap items-center justify-center gap-2 text-xs font-semibold text-[var(--text-muted)] bg-[var(--bg-surface-elevated)] px-4 py-2 rounded-xl border border-[var(--border)] z-10">
      <span>Matching Preference:</span>
      <span id="matching-pref-display" class="text-[var(--primary)] capitalize font-bold">Anyone</span>
    </div>

    <!-- Action Buttons: Enter Chat Room & Cancel -->
    <div class="flex flex-col sm:flex-row items-center gap-2.5 w-full z-10">
      <button
        id="matching-enter-direct-btn"
        type="button"
        class="btn-primary text-xs py-2.5 px-4 w-full text-center"
      >
        <span>Enter Chat Room</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </button>

      <button
        id="matching-cancel-btn"
        type="button"
        class="btn-secondary text-xs py-2.5 px-4 w-full text-center"
      >
        Cancel
      </button>
    </div>
  </div>

  <!-- STATE 2: MATCH FOUND SEQUENCE -->
  <div id="match-found-container" class="hidden w-full card-tactile p-8 shadow-2xl flex flex-col items-center gap-6 relative overflow-hidden animate-modal-in">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold z-10">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>Match Established!</span>
    </div>

    <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] tracking-tight z-10">
      Stranger Connected
    </h2>
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] max-w-xs z-10">
      You are now connected 1-on-1 with a real human stranger.
    </p>

    <!-- Avatars -->
    <div class="flex items-center justify-center gap-4 my-2 z-10">
      <div class="flex flex-col items-center gap-1.5">
        <div class="w-14 h-14 rounded-2xl bg-[var(--primary)] text-white flex items-center justify-center text-lg font-black shadow-sm">
          You
        </div>
        <span class="text-[11px] font-semibold text-[var(--text-muted)]">You</span>
      </div>

      <div class="w-8 h-8 rounded-full bg-[var(--primary-soft)] text-[var(--primary)] flex items-center justify-center text-sm shadow-xs">
        <Icon name="zap" class="w-4 h-4" />
      </div>

      <div class="flex flex-col items-center gap-1.5">
        <div class="w-14 h-14 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-primary)] flex items-center justify-center text-lg font-black shadow-sm">
          <span id="match-found-stranger-letter">S</span>
        </div>
        <span id="match-found-stranger-name" class="text-[11px] font-semibold text-[var(--text-primary)]">Stranger</span>
      </div>
    </div>

    <!-- Start Chatting Direct Trigger CTA -->
    <button
      id="match-found-start-btn"
      type="button"
      class="btn-primary text-sm sm:text-base py-3 px-6 w-full"
    >
      <span>Start Conversation</span>
      <Icon name="arrow-right" class="w-4 h-4" />
    </button>
  </div>
</div>
