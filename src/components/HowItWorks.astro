---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<section class="w-full py-12 sm:py-16 border-t border-[var(--border-color)] bg-[var(--bg-surface)]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-main)] mb-3">
        {t.howItWorks.title}
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-muted)]">
        Start chatting with someone new in three effortless steps.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Step 1 -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-page)]/50 flex flex-col gap-3 relative group hover:border-[#D55882]/40 shadow-sm interactive-tactile">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-xl gradient-accent flex items-center justify-center text-white shadow-md group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <span class="text-2xl font-black text-[var(--border-color)] group-hover:text-[#FF808A] transition-colors">01</span>
        </div>
        <h3 class="text-lg font-bold text-[var(--text-main)] mt-2">
          {t.howItWorks.step1Title}
        </h3>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          {t.howItWorks.step1Desc}
        </p>
      </div>

      <!-- Step 2 -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-page)]/50 flex flex-col gap-3 relative group hover:border-[#D55882]/40 shadow-sm interactive-tactile">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-xl gradient-accent flex items-center justify-center text-white shadow-md group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="2"></circle>
              <path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"></path>
            </svg>
          </div>
          <span class="text-2xl font-black text-[var(--border-color)] group-hover:text-[#FF808A] transition-colors">02</span>
        </div>
        <h3 class="text-lg font-bold text-[var(--text-main)] mt-2">
          {t.howItWorks.step2Title}
        </h3>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          {t.howItWorks.step2Desc}
        </p>
      </div>

      <!-- Step 3 -->
      <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-page)]/50 flex flex-col gap-3 relative group hover:border-[#D55882]/40 shadow-sm interactive-tactile">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-xl gradient-accent flex items-center justify-center text-white shadow-md group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <span class="text-2xl font-black text-[var(--border-color)] group-hover:text-[#FF808A] transition-colors">03</span>
        </div>
        <h3 class="text-lg font-bold text-[var(--text-main)] mt-2">
          {t.howItWorks.step3Title}
        </h3>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed">
          {t.howItWorks.step3Desc}
        </p>
      </div>
    </div>
  </div>
</section>
