---
import { SITE } from '../config/site';

interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'brand-mark', title = SITE.name } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={title}
>
  <rect width="64" height="64" rx="10" fill="var(--paper-2)" />
  <rect x="10" y="16" width="34" height="28" rx="4" fill="var(--elevated)" stroke="var(--ink)" stroke-width="2" />
  <rect x="22" y="24" width="34" height="28" rx="4" fill="var(--ink)" />
  <circle cx="48" cy="20" r="7" fill="var(--wax)" />
  <circle cx="48" cy="20" r="3.2" fill="none" stroke="#fffdf8" stroke-width="1.4" />
</svg>
