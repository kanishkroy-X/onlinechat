---
// ActiveChat.astro - Realtime Chat Interface with Progressive Feature Unlock System
---

<div id="active-chat-container" class="w-full h-full flex flex-col bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-card relative transition-colors">
  <!-- Default / Unselected Person State -->
  <div id="chat-unselected-state" class="flex-1 flex flex-col items-center justify-center p-8 text-center gap-3">
    <div class="w-16 h-16 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] flex items-center justify-center text-[#6C4DFF] shadow-xs">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </div>
    <div class="flex flex-col gap-1 max-w-sm">
      <h3 class="text-base font-bold text-[var(--text-primary)]">Select someone online to chat</h3>
      <p class="text-xs text-[var(--text-secondary)]">
        Choose a person from the online list to start an instant conversation and progressively unlock voice & video calling.
      </p>
    </div>
  </div>

  <!-- Active Chat View (Shown when a person is selected) -->
  <div id="chat-selected-state" class="hidden flex-1 flex-col h-full overflow-hidden">
    <!-- 1. CHAT HEADER -->
    <div class="px-4 py-3 bg-[var(--bg-surface)] border-b border-[var(--border)] flex flex-col gap-2.5 shrink-0 transition-colors">
      <div class="flex items-center justify-between gap-2">
        <!-- Left: Back Button (Mobile) + Avatar & Info -->
        <div class="flex items-center gap-3 min-w-0">
          <button
            type="button"
            id="chat-back-btn"
            class="md:hidden p-1.5 rounded-lg text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer"
            aria-label="Back to People List"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>

          <div class="relative w-10 h-10 rounded-full overflow-hidden bg-[var(--bg-surface-elevated)] shrink-0 border border-[var(--border)] shadow-xs">
            <img
              id="active-chat-avatar"
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#18D889] border-2 border-[var(--bg-surface)]"></span>
          </div>

          <div class="flex flex-col min-w-0">
            <div class="flex items-center gap-1.5">
              <span id="active-chat-username" class="font-bold text-sm text-[var(--text-primary)] truncate">User</span>
              <span id="active-chat-flag" class="text-xs"></span>
            </div>
            <div class="flex items-center gap-1 text-[11px] text-[var(--text-secondary)] truncate">
              <span class="text-[#18D889] font-medium flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#18D889]"></span> Online
              </span>
              <span>•</span>
              <span id="active-chat-details">22 · Barcelona, Spain</span>
            </div>
          </div>
        </div>

        <!-- Right: Actions (Calls, Safety, Menu) -->
        <div class="flex items-center gap-1 sm:gap-2">
          <!-- Voice Chat Trigger -->
          <button
            type="button"
            id="chat-voice-chat-btn"
            class="chat-call-btn w-8 h-8 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-muted)] flex items-center justify-center transition-all cursor-not-allowed opacity-60 shadow-xs"
            title="Voice Chat (Locked until unlocked)"
            disabled
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="23"></line>
              <line x1="8" y1="23" x2="16" y2="23"></line>
            </svg>
          </button>

          <!-- Voice Call Trigger -->
          <button
            type="button"
            id="chat-voice-call-btn"
            class="chat-call-btn w-8 h-8 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-muted)] flex items-center justify-center transition-all cursor-not-allowed opacity-60 shadow-xs"
            title="Voice Call (Locked until unlocked)"
            disabled
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </button>

          <!-- Video Call Trigger -->
          <button
            type="button"
            id="chat-video-call-btn"
            class="chat-call-btn w-8 h-8 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-muted)] flex items-center justify-center transition-all cursor-not-allowed opacity-60 shadow-xs"
            title="Video Call (Locked until unlocked)"
            disabled
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
          </button>

          <!-- Safety / More Menu Dropdown Trigger -->
          <div class="relative">
            <button
              type="button"
              id="chat-safety-menu-btn"
              class="w-8 h-8 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center transition-colors cursor-pointer shadow-xs"
              title="Safety & Actions"
              aria-label="Chat options"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="12" cy="5" r="1"></circle>
                <circle cx="12" cy="19" r="1"></circle>
              </svg>
            </button>

            <!-- Safety Menu Dropdown -->
            <div
              id="chat-safety-dropdown"
              class="hidden absolute right-0 top-10 w-44 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl shadow-2xl p-1.5 z-50 flex flex-col gap-1"
            >
              <button
                type="button"
                id="menu-report-user-btn"
                class="w-full px-3 py-2 text-left text-xs font-semibold text-[#FF4D5F] hover:bg-[#FF4D5F]/10 rounded-xl flex items-center gap-2 transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
                <span>Report User</span>
              </button>
              <button
                type="button"
                id="menu-block-user-btn"
                class="w-full px-3 py-2 text-left text-xs font-semibold text-[var(--text-secondary)] hover:text-[#FF4D5F] hover:bg-[#FF4D5F]/10 rounded-xl flex items-center gap-2 transition-colors cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                <span>Block User</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. FEATURE UNLOCK BAR (Progressive System) -->
      <div class="flex items-center justify-between bg-[var(--bg-surface-elevated)] border border-[var(--border)] rounded-xl p-2 px-3 gap-2 overflow-x-auto text-[11px] transition-colors">
        <div class="flex items-center gap-1 sm:gap-2 shrink-0">
          <!-- Voice Note Indicator -->
          <div id="unlock-badge-voice-note" class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border)] transition-all font-medium">
            <span class="unlock-icon">🔒</span>
            <span>Voice Note</span>
          </div>

          <span class="text-[var(--text-subtle)]">→</span>

          <!-- Voice Chat Indicator -->
          <div id="unlock-badge-voice-chat" class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border)] transition-all font-medium">
            <span class="unlock-icon">🔒</span>
            <span>Voice Chat</span>
          </div>

          <span class="text-[var(--text-subtle)]">→</span>

          <!-- Voice Call Indicator -->
          <div id="unlock-badge-voice-call" class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border)] transition-all font-medium">
            <span class="unlock-icon">🔒</span>
            <span>Voice Call</span>
          </div>

          <span class="text-[var(--text-subtle)]">→</span>

          <!-- Video Call Indicator -->
          <div id="unlock-badge-video-call" class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border)] transition-all font-medium">
            <span class="unlock-icon">🔒</span>
            <span>Video Call</span>
          </div>
        </div>

        <!-- Help Info Button -->
        <button
          type="button"
          id="unlock-help-btn"
          class="shrink-0 text-[var(--text-secondary)] hover:text-[#6C4DFF] p-1 rounded-md transition-colors cursor-pointer"
          title="How features unlock"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- 3. WAITING FOR REPLY BANNER -->
    <div id="chat-waiting-banner" class="hidden bg-[#6C4DFF]/10 border-b border-[#6C4DFF]/25 px-4 py-2 flex items-center justify-between text-xs text-[var(--text-primary)]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#6C4DFF] animate-ping"></span>
        <span class="font-medium">Waiting for a reply — features remain locked until they respond.</span>
      </div>
      <!-- Fast Simulation button for interactive testing -->
      <button
        type="button"
        id="simulate-reply-btn"
        class="px-2.5 py-1 rounded-lg bg-[#6C4DFF] hover:bg-[#7B61FF] text-white text-[11px] font-bold transition-all shadow-xs cursor-pointer"
      >
        Simulate Reply
      </button>
    </div>

    <!-- 4. MESSAGE HISTORY LIST -->
    <div id="chat-messages-list" class="flex-1 overflow-y-auto p-4 flex flex-col gap-3 min-h-0 bg-[var(--bg-page)] transition-colors">
      <!-- Welcome conversation banner -->
      <div class="my-3 flex flex-col items-center justify-center text-center gap-1.5 p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] shadow-xs">
        <span class="text-xs font-bold text-[var(--text-primary)]">This is the beginning of your chat</span>
        <p class="text-[11px] text-[var(--text-secondary)] max-w-xs">
          Send a polite text to break the ice. When they reply, Voice Notes will unlock!
        </p>
      </div>

      <!-- Messages dynamically injected here -->
    </div>

    <!-- 5. TYPING INDICATOR -->
    <div id="chat-typing-indicator" class="hidden px-5 py-1 text-xs text-[var(--text-secondary)] flex items-center gap-1.5 bg-[var(--bg-page)]">
      <span id="typing-user-name">Ava</span> is typing
      <span class="inline-flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[#6C4DFF] animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#6C4DFF] animate-bounce" style="animation-delay: 0.15s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#6C4DFF] animate-bounce" style="animation-delay: 0.3s"></span>
      </span>
    </div>

    <!-- 6. ATTACHMENT PREVIEW (Before sending) -->
    <div id="chat-media-preview-container" class="hidden px-4 py-2 bg-[var(--bg-surface-elevated)] border-t border-[var(--border)] flex items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="relative w-12 h-12 rounded-lg bg-[var(--bg-surface)] overflow-hidden border border-[var(--border)] flex items-center justify-center shadow-xs">
          <img id="preview-img" src="" alt="preview" class="hidden w-full h-full object-cover" />
          <video id="preview-video" src="" class="hidden w-full h-full object-cover"></video>
        </div>
        <div class="flex flex-col">
          <span id="preview-file-name" class="text-xs font-semibold text-[var(--text-primary)] truncate max-w-xs">file.png</span>
          <span id="preview-file-size" class="text-[10px] text-[var(--text-muted)]">1.2 MB</span>
        </div>
      </div>
      <button
        type="button"
        id="cancel-media-preview-btn"
        class="p-1.5 rounded-lg bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[#FF4D5F] transition-colors cursor-pointer"
        aria-label="Remove media"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- 7. VOICE NOTE RECORDING OVERLAY (Inside composer) -->
    <div id="voice-recorder-bar" class="hidden px-4 py-3 bg-[var(--bg-surface-elevated)] border-t border-[var(--border)] items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-3 h-3 rounded-full bg-[#FF4D5F] animate-ping"></div>
        <span id="recording-timer" class="text-xs font-mono font-bold text-[var(--text-primary)]">00:00</span>
        <!-- Waveform Simulation -->
        <div class="flex items-center gap-1 h-5">
          <span class="w-1 bg-[#00D9A3] rounded-full wave-bar" style="animation-delay: 0.1s; height: 6px;"></span>
          <span class="w-1 bg-[#00D9A3] rounded-full wave-bar" style="animation-delay: 0.3s; height: 14px;"></span>
          <span class="w-1 bg-[#00D9A3] rounded-full wave-bar" style="animation-delay: 0.2s; height: 18px;"></span>
          <span class="w-1 bg-[#00D9A3] rounded-full wave-bar" style="animation-delay: 0.4s; height: 10px;"></span>
          <span class="w-1 bg-[#00D9A3] rounded-full wave-bar" style="animation-delay: 0.15s; height: 16px;"></span>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="cancel-record-btn"
          class="px-3 py-1.5 rounded-lg bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[#FF4D5F] text-xs font-semibold border border-[var(--border)] transition-colors cursor-pointer"
        >
          Cancel
        </button>
        <button
          type="button"
          id="send-record-btn"
          class="px-3.5 py-1.5 rounded-lg bg-[#00D9A3] hover:bg-[#00D9A3]/90 text-[#07111B] text-xs font-bold transition-all shadow-xs cursor-pointer flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          <span>Send Voice</span>
        </button>
      </div>
    </div>

    <!-- 8. COMPOSER BAR -->
    <div id="normal-composer-bar" class="p-3 bg-[var(--bg-surface)] border-t border-[var(--border)] flex items-center gap-2 shrink-0 transition-colors">
      <!-- Attachment Trigger -->
      <div class="relative">
        <button
          type="button"
          id="chat-attach-btn"
          class="w-10 h-10 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center transition-colors cursor-pointer shadow-xs"
          title="Attach photo or video"
          aria-label="Attach File"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
        </button>

        <!-- STRICT ATTACHMENT MENU (Only PNG up to 10MB & MP4 up to 50MB) -->
        <div
          id="chat-attachment-menu"
          class="hidden absolute bottom-12 left-0 w-64 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl shadow-2xl p-2 z-50 flex flex-col gap-1.5"
        >
          <div class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border)]">
            Allowed Attachments
          </div>

          <!-- Option 1: Photo (PNG) -->
          <button
            type="button"
            id="attach-png-btn"
            class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer text-left group"
          >
            <div class="w-8 h-8 rounded-lg bg-[#6C4DFF]/15 text-[#6C4DFF] group-hover:bg-[#6C4DFF] group-hover:text-white flex items-center justify-center transition-colors shadow-xs">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-[var(--text-primary)]">Photo (PNG)</span>
              <span class="text-[10px] text-[var(--text-secondary)]">Up to 10 MB</span>
            </div>
          </button>

          <!-- Option 2: Video (MP4) -->
          <button
            type="button"
            id="attach-mp4-btn"
            class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer text-left group"
          >
            <div class="w-8 h-8 rounded-lg bg-[#00D9A3]/15 text-[#00D9A3] group-hover:bg-[#00D9A3] group-hover:text-[#07111B] flex items-center justify-center transition-colors shadow-xs">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
            </div>
            <div class="flex flex-col">
              <span class="text-xs font-semibold text-[var(--text-primary)]">Video (MP4)</span>
              <span class="text-[10px] text-[var(--text-secondary)]">Up to 50 MB</span>
            </div>
          </button>

          <!-- Hidden strict file input -->
          <input
            id="hidden-file-input"
            type="file"
            accept=".png, .mp4, image/png, video/mp4"
            class="hidden"
          />
        </div>
      </div>

      <!-- Text Input Form -->
      <form id="chat-input-form" class="flex-1 flex items-center gap-2 min-w-0">
        <input
          id="chat-text-input"
          type="text"
          placeholder="Type a message..."
          autocomplete="off"
          class="flex-1 px-4 py-2.5 rounded-xl bg-[var(--bg-input)] border border-[var(--border)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-sm focus:outline-none focus:border-[#6C4DFF] transition-colors shadow-xs"
        />

        <!-- Voice Note Microphone Trigger (Locked by default) -->
        <button
          type="button"
          id="chat-mic-btn"
          class="w-10 h-10 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-muted)] flex items-center justify-center transition-all cursor-not-allowed opacity-60 shrink-0 shadow-xs"
          title="Voice Note (Locked until reply)"
          disabled
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <line x1="12" y1="19" x2="12" y2="23"></line>
            <line x1="8" y1="23" x2="16" y2="23"></line>
          </svg>
        </button>

        <!-- Send Button -->
        <button
          type="submit"
          id="chat-send-btn"
          class="w-10 h-10 rounded-xl bg-[#6C4DFF] hover:bg-[#7B61FF] text-white flex items-center justify-center transition-all shadow-md cursor-pointer shrink-0"
          aria-label="Send message"
        >
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Lightbox Modal for Photo Attachments -->
  <div id="chat-lightbox" class="hidden fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative max-w-3xl max-h-[85vh] flex flex-col items-center">
      <button
        type="button"
        id="lightbox-close-btn"
        class="absolute -top-10 right-0 p-1.5 text-white hover:text-[#FF4D5F] transition-colors cursor-pointer"
        aria-label="Close image"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <img id="lightbox-img" src="" alt="Full view" class="max-w-full max-h-[80vh] rounded-2xl object-contain shadow-2xl border border-[var(--border)]" />
    </div>
  </div>

