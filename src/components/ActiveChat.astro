---
// ActiveChat.astro - 1-on-1 Direct & Stranger Chat Interface
// Built according to RandomChat UI/UX Specification v3.1 and chatcn architectural patterns
import CountryFlag from './CountryFlag.astro';
---

<div id="active-chat-container" class="w-full h-full flex flex-col bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl overflow-hidden shadow-xs relative transition-colors">
  <!-- State A: Unselected Person State (Lobby Default) -->
  <div id="chat-unselected-state" class="flex-1 flex flex-col items-center justify-center p-8 text-center gap-3">
    <div class="w-16 h-16 rounded-3xl bg-gradient-to-br from-[#FF808A]/15 via-[#D55882]/15 to-[#492351]/15 border border-[var(--border)] flex items-center justify-center text-[#FF808A] shadow-xs">
      <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
    </div>
    <div class="flex flex-col gap-1 max-w-sm">
      <h3 class="text-base font-bold text-[var(--text-primary)]">Select someone online to chat</h3>
      <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
        Choose a person from the online list to start an instant 1-on-1 conversation, or enter Random Chat for unfiltered matchmaking.
      </p>
    </div>
  </div>

  <!-- State B: Active Conversation View -->
  <div id="chat-selected-state" class="hidden flex-1 flex-col h-full overflow-hidden">
    <!-- 1. CHAT HEADER -->
    <div class="px-3 sm:px-4 py-2.5 sm:py-3 bg-[var(--bg-surface)] border-b border-[var(--border)] flex items-center justify-between gap-2 shrink-0 transition-colors">
      <!-- Left: Mobile Back + Partner Info -->
      <div class="flex items-center gap-2 sm:gap-2.5 min-w-0">
        <button
          type="button"
          id="chat-back-btn"
          class="lg:hidden w-10 h-10 flex items-center justify-center rounded-xl text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer touch-target shrink-0"
          aria-label="Back to People List"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <!-- Initial-based Avatar -->
        <div class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full shrink-0 border border-[var(--border)] shadow-xs flex items-center justify-center font-bold text-sm bg-gradient-to-br from-[#FF808A]/20 to-[#D55882]/30 text-[#FF808A] overflow-hidden">
          <span id="active-chat-initial">S</span>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#10B981] border-2 border-[var(--bg-surface)]"></span>
        </div>

        <div class="flex flex-col min-w-0">
          <div class="flex items-center gap-1.5">
            <span id="active-chat-username" class="font-bold text-sm text-[var(--text-primary)] truncate">Sarah</span>
            <span id="active-chat-flag-container">
              <CountryFlag code="US" size="sm" />
            </span>
          </div>
          <div class="flex items-center gap-1.5 text-[11px] text-[var(--text-secondary)] truncate">
            <span id="active-chat-age-gender">24 yrs &bull; Female</span>
            <span class="text-[var(--text-muted)]">&bull;</span>
            <span class="text-[#10B981] font-medium flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span> Online
            </span>
          </div>
        </div>
      </div>

      <!-- Right: Action Controls (Voice, Next Stranger, Safety Menu) -->
      <div class="flex items-center gap-1.5 sm:gap-2">
        <!-- Request Voice Button (WebRTC opt-in escalation) -->
        <button
          type="button"
          id="chat-request-voice-btn"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[#FF808A]/10 border border-[var(--border)] hover:border-[#FF808A]/30 text-xs font-semibold text-[var(--text-primary)] hover:text-[#FF808A] transition-all cursor-pointer shadow-xs min-h-[38px] sm:min-h-[40px]"
          title="Request WebRTC Voice Chat"
        >
          <svg class="w-3.5 h-3.5 text-[#FF808A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <line x1="12" y1="19" x2="12" y2="23"></line>
            <line x1="8" y1="23" x2="16" y2="23"></line>
          </svg>
          <span class="hidden sm:inline">Request Voice</span>
        </button>

        <!-- Next Stranger Trigger -->
        <button
          type="button"
          id="chat-next-stranger-btn"
          class="p-2 sm:px-3 sm:py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer shadow-xs flex items-center gap-1.5 min-h-[38px] sm:min-h-[40px]"
          title="Find Another Stranger"
        >
          <svg class="w-4 h-4 text-[#D55882]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
          </svg>
          <span class="hidden sm:inline">Next</span>
        </button>

        <!-- Safety / More Menu Trigger (40px touch area) -->
        <div class="relative">
          <button
            type="button"
            id="chat-safety-menu-btn"
            class="w-10 h-10 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center transition-colors cursor-pointer shadow-xs touch-target"
            aria-label="Safety & Moderation Options"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="1"></circle>
              <circle cx="12" cy="5" r="1"></circle>
              <circle cx="12" cy="19" r="1"></circle>
            </svg>
          </button>

          <!-- Dropdown Menu: Report & Block -->
          <div
            id="chat-safety-dropdown"
            class="hidden absolute right-0 top-12 w-44 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl shadow-2xl p-1.5 z-50 flex-col gap-1"
          >
            <button
              type="button"
              id="menu-report-btn"
              class="w-full px-3 py-2 text-left text-xs font-semibold text-rose-500 hover:bg-rose-500/10 rounded-xl flex items-center gap-2 transition-colors cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>
              <span>Report Stranger</span>
            </button>
            <button
              type="button"
              id="menu-block-btn"
              class="w-full px-3 py-2 text-left text-xs font-semibold text-[var(--text-secondary)] hover:text-rose-500 hover:bg-rose-500/10 rounded-xl flex items-center gap-2 transition-colors cursor-pointer"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
              <span>Block User</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. SERVER-AUTHORITATIVE 2-MESSAGE COLD GATE ALERT -->
    <div id="chat-cold-gate-banner" class="hidden bg-[#FF808A]/10 border-b border-[#FF808A]/25 px-4 py-2.5 flex items-center justify-between gap-3 text-xs text-[var(--text-primary)] transition-all">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#FF808A] animate-ping shrink-0"></span>
        <span class="font-medium">
          You've sent 2 messages. Wait for a reply before sending another.
        </span>
      </div>
      <!-- Interactive Simulate Reply Action for instant testing -->
      <button
        type="button"
        id="simulate-reply-btn"
        class="px-2.5 py-1 rounded-lg bg-[#FF808A] hover:bg-[#D55882] text-white text-[11px] font-bold transition-all shadow-xs cursor-pointer shrink-0"
      >
        Simulate Reply
      </button>
    </div>

    <!-- 3. MESSAGE STREAM CONTAINER (chatcn auto-scroll pattern) -->
    <div class="relative flex-1 min-h-0">
      <div id="chat-messages-list" class="w-full h-full overflow-y-auto p-4 flex flex-col gap-3.5 bg-[var(--bg-page)] transition-colors scroll-smooth">
        <!-- Beginning of Conversation Notice -->
        <div class="my-2 flex flex-col items-center justify-center text-center gap-1 p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] shadow-2xs max-w-sm mx-auto">
          <span class="text-xs font-bold text-[var(--text-primary)]">Beginning of your anonymous conversation</span>
          <p class="text-[11px] text-[var(--text-secondary)]">
            Send a polite message to break the ice. Zero logs are saved.
          </p>
        </div>

        <!-- Dynamic Messages Injected Here -->
      </div>

      <!-- Floating Scroll-To-Bottom Pill with Unseen Count (chatcn useAutoScroll pattern) -->
      <button
        type="button"
        id="chat-scroll-bottom-pill"
        class="hidden absolute bottom-3 right-4 px-3 py-1.5 rounded-full bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-[var(--text-primary)] text-xs font-semibold shadow-lg items-center gap-1.5 transition-all cursor-pointer z-10 animate-bounce"
        aria-label="Scroll to bottom"
      >
        <svg class="w-3.5 h-3.5 text-[#FF808A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        <span>New messages</span>
        <span id="chat-unseen-badge" class="px-1.5 py-0.2 rounded-full bg-[#FF808A] text-white text-[10px] font-bold">1</span>
      </button>
    </div>

    <!-- 4. TYPING INDICATOR -->
    <div id="chat-typing-indicator" class="hidden px-5 py-1 text-xs text-[var(--text-secondary)] flex items-center gap-2 bg-[var(--bg-page)] border-t border-[var(--border)]/30">
      <span id="typing-user-name">Stranger</span> is typing
      <span class="inline-flex gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF808A] animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF808A] animate-bounce" style="animation-delay: 0.15s"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[#FF808A] animate-bounce" style="animation-delay: 0.3s"></span>
      </span>
    </div>

    <!-- 5. COMPOSER BAR (chatcn multi-line useAutoResize pattern) with Safe-Area padding -->
    <div class="p-2.5 sm:p-3 pb-[max(0.65rem,env(safe-area-inset-bottom,0px))] bg-[var(--bg-surface)] border-t border-[var(--border)] flex flex-col gap-2 shrink-0 transition-colors">
      <!-- Media Attachment Preview Bar -->
      <div id="chat-media-preview" class="hidden items-center justify-between p-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)]">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-lg bg-[var(--bg-surface)] border border-[var(--border)] overflow-hidden flex items-center justify-center">
            <img id="preview-img" src="" alt="attachment" class="w-full h-full object-cover hidden" />
            <span id="preview-file-icon" class="text-xs">📎</span>
          </div>
          <span id="preview-file-name" class="text-xs text-[var(--text-primary)] font-medium truncate max-w-xs">attachment.png</span>
        </div>
        <button type="button" id="remove-preview-btn" class="p-1 text-[var(--text-secondary)] hover:text-rose-500 cursor-pointer">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <div class="flex items-end gap-2">
        <!-- Attach Media Trigger (44px touch area) -->
        <button
          type="button"
          id="chat-attach-btn"
          class="w-11 h-11 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center transition-colors cursor-pointer shrink-0 shadow-xs touch-target"
          title="Attach Image"
          aria-label="Attach file"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
          </svg>
        </button>
        <input type="file" id="chat-file-input" accept="image/png, image/jpeg, video/mp4" class="hidden" />

        <!-- Auto-Resizing Textarea with 16px Mobile Font Size to prevent iOS auto-zoom -->
        <div class="relative flex-1 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] overflow-hidden focus-within:ring-2 focus-within:ring-[#FF808A] focus-within:border-transparent transition-all">
          <textarea
            id="chat-textarea"
            rows="1"
            placeholder="Type a message..."
            class="w-full resize-none bg-transparent py-2.5 px-3 text-base sm:text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none max-h-36 leading-relaxed"
          ></textarea>
        </div>

        <!-- Send Button (44px touch area) -->
        <button
          type="button"
          id="chat-send-btn"
          class="w-11 h-11 rounded-xl bg-gradient-to-r from-[#FF808A] via-[#D55882] to-[#7F376D] hover:opacity-95 text-white flex items-center justify-center transition-all shadow-md cursor-pointer shrink-0 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed touch-target"
          aria-label="Send message"
        >
          <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initActiveChat() {
    const container = document.getElementById('active-chat-container');
    const unselectedState = document.getElementById('chat-unselected-state');
    const selectedState = document.getElementById('chat-selected-state');
    const backBtn = document.getElementById('chat-back-btn');
    const initialEl = document.getElementById('active-chat-initial');
    const usernameEl = document.getElementById('active-chat-username');
    const ageGenderEl = document.getElementById('active-chat-age-gender');
    const flagContainer = document.getElementById('active-chat-flag-container');
    const coldGateBanner = document.getElementById('chat-cold-gate-banner');
    const simulateReplyBtn = document.getElementById('simulate-reply-btn');
    const messagesList = document.getElementById('chat-messages-list');
    const scrollBottomPill = document.getElementById('chat-scroll-bottom-pill');
    const unseenBadge = document.getElementById('chat-unseen-badge');
    const typingIndicator = document.getElementById('chat-typing-indicator');
    const textarea = document.getElementById('chat-textarea') as HTMLTextAreaElement | null;
    const sendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement | null;
    const attachBtn = document.getElementById('chat-attach-btn');
    const fileInput = document.getElementById('chat-file-input') as HTMLInputElement | null;
    const mediaPreview = document.getElementById('chat-media-preview');
    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const previewFileName = document.getElementById('preview-file-name');
    const removePreviewBtn = document.getElementById('remove-preview-btn');
    const safetyMenuBtn = document.getElementById('chat-safety-menu-btn');
    const safetyDropdown = document.getElementById('chat-safety-dropdown');
    const nextStrangerBtn = document.getElementById('chat-next-stranger-btn');
    const requestVoiceBtn = document.getElementById('chat-request-voice-btn');

    let currentPartner: any = null;
    let outgoingCount = 0;
    let unseenCount = 0;
    let isAtBottom = true;
    let attachedFileData: string | null = null;

    // Open person chat
    window.addEventListener('rc:person-selected', (e: any) => {
      currentPartner = e.detail;
      openChatWithPartner(currentPartner);
    });

    function openChatWithPartner(partner: any) {
      if (!partner) return;
      if (unselectedState) unselectedState.classList.add('hidden');
      if (selectedState) {
        selectedState.classList.remove('hidden');
        selectedState.classList.add('flex');
      }

      if (initialEl) initialEl.textContent = (partner.username || 'S').charAt(0).toUpperCase();
      if (usernameEl) usernameEl.textContent = partner.username || 'Stranger';
      if (ageGenderEl) ageGenderEl.textContent = `${partner.age || 24} yrs • ${partner.gender || 'Person'}`;

      if (flagContainer && partner.countryCode) {
        const code = partner.countryCode.toLowerCase();
        flagContainer.innerHTML = `<span class="inline-flex items-center shrink-0 w-4 h-3 rounded-[2px] overflow-hidden border border-white/10 shadow-2xs"><img src="/flags/${code}.svg" alt="${partner.countryName || code} flag" class="w-full h-full object-cover" width="16" height="12" /></span>`;
      }

      // Reset conversation messages & cold gate for new selection
      outgoingCount = 0;
      updateColdGateState();
      clearAndSeedWelcomeMessages();
      textarea?.focus();
    }

    backBtn?.addEventListener('click', () => {
      if (selectedState) {
        selectedState.classList.add('hidden');
        selectedState.classList.remove('flex');
      }
      if (unselectedState) unselectedState.classList.remove('hidden');
    });

    // Auto-resize textarea (chatcn useAutoResize pattern)
    function autoResizeTextarea() {
      if (!textarea) return;
      textarea.style.height = 'auto';
      const lineHeight = 20;
      const maxHeight = lineHeight * 6;
      textarea.style.height = `${Math.min(textarea.scrollHeight, maxHeight)}px`;
      textarea.style.overflowY = textarea.scrollHeight > maxHeight ? 'auto' : 'hidden';
    }

    textarea?.addEventListener('input', autoResizeTextarea);

    // Enter to send, Shift+Enter for newline
    textarea?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    sendBtn?.addEventListener('click', () => {
      sendMessage();
    });

    // 2-Message Cold Gate Rule
    function updateColdGateState() {
      const isLocked = outgoingCount >= 2;
      if (coldGateBanner) {
        if (isLocked) {
          coldGateBanner.classList.remove('hidden');
          coldGateBanner.classList.add('flex');
        } else {
          coldGateBanner.classList.add('hidden');
          coldGateBanner.classList.remove('flex');
        }
      }

      if (textarea) textarea.disabled = isLocked;
      if (sendBtn) sendBtn.disabled = isLocked;
      if (attachBtn) (attachBtn as HTMLButtonElement).disabled = isLocked;
    }

    function appendMessage(text: string, isMe: boolean, mediaUrl?: string) {
      if (!messagesList) return;

      const msgDiv = document.createElement('div');
      msgDiv.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} max-w-[85%] sm:max-w-[75%] ${isMe ? 'self-end' : 'self-start'} animate-in fade-in duration-150`;

      const bubble = document.createElement('div');
      bubble.className = `p-3 rounded-2xl text-xs sm:text-sm leading-relaxed break-words shadow-2xs ${
        isMe
          ? 'bg-gradient-to-r from-[#FF808A] to-[#D55882] text-white rounded-tr-xs'
          : 'bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border)] rounded-tl-xs'
      }`;

      if (mediaUrl) {
        const img = document.createElement('img');
        img.src = mediaUrl;
        img.alt = 'Shared media';
        img.className = 'max-w-xs max-h-60 rounded-xl object-cover mb-1.5 border border-white/10';
        bubble.appendChild(img);
      }

      if (text) {
        const span = document.createElement('span');
        span.textContent = text;
        bubble.appendChild(span);
      }

      const timeSpan = document.createElement('span');
      timeSpan.className = `text-[10px] mt-1 text-[var(--text-muted)] font-mono ${isMe ? 'text-right' : 'text-left'}`;
      const now = new Date();
      timeSpan.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      msgDiv.appendChild(bubble);
      msgDiv.appendChild(timeSpan);
      messagesList.appendChild(msgDiv);

      // Handle auto-scroll
      if (isAtBottom) {
        messagesList.scrollTo({ top: messagesList.scrollHeight, behavior: 'smooth' });
      } else {
        unseenCount++;
        if (scrollBottomPill && unseenBadge) {
          unseenBadge.textContent = String(unseenCount);
          scrollBottomPill.classList.remove('hidden');
          scrollBottomPill.classList.add('inline-flex');
        }
      }
    }

    function sendMessage() {
      if (!textarea) return;
      const text = textarea.value.trim();
      if (!text && !attachedFileData) return;
      if (outgoingCount >= 2) return;

      appendMessage(text, true, attachedFileData || undefined);
      outgoingCount++;
      updateColdGateState();

      // Clear input
      textarea.value = '';
      autoResizeTextarea();
      clearMediaAttachment();

      // Show typing indicator after a short interval to simulate peer reaction
      setTimeout(() => {
        if (typingIndicator) typingIndicator.classList.remove('hidden');
      }, 1000);
    }

    // Simulate stranger reply (resets cold-gate restriction)
    simulateReplyBtn?.addEventListener('click', () => {
      if (typingIndicator) typingIndicator.classList.add('hidden');
      const sampleReplies = [
        "Hey! Great to meet you here. How has your day been?",
        "Hello! I saw we both enjoy quiet evening chats.",
        "Hi there! What part of the world are you tuning in from?",
        "Hey! Thanks for saying hi. Let's chat!"
      ];
      const reply = sampleReplies[Math.floor(Math.random() * sampleReplies.length)];
      appendMessage(reply, false);

      // Reset cold gate!
      outgoingCount = 0;
      updateColdGateState();
    });

    // Auto-scroll threshold detection (chatcn useAutoScroll pattern)
    messagesList?.addEventListener('scroll', () => {
      const el = messagesList;
      const distanceFromBottom = el.scrollHeight - el.scrollTop - el.clientHeight;
      isAtBottom = distanceFromBottom <= 80;

      if (isAtBottom) {
        unseenCount = 0;
        scrollBottomPill?.classList.add('hidden');
        scrollBottomPill?.classList.remove('inline-flex');
      }
    });

    scrollBottomPill?.addEventListener('click', () => {
      if (messagesList) {
        messagesList.scrollTo({ top: messagesList.scrollHeight, behavior: 'smooth' });
        unseenCount = 0;
        scrollBottomPill.classList.add('hidden');
        scrollBottomPill.classList.remove('inline-flex');
      }
    });

    function clearAndSeedWelcomeMessages() {
      if (!messagesList) return;
      messagesList.innerHTML = `
        <div class="my-2 flex flex-col items-center justify-center text-center gap-1 p-3.5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] shadow-2xs max-w-sm mx-auto">
          <span class="text-xs font-bold text-[var(--text-primary)]">Beginning of your anonymous conversation</span>
          <p class="text-[11px] text-[var(--text-secondary)]">
            Send a polite message to break the ice. Zero logs are saved.
          </p>
        </div>
      `;
    }

    // Media attachment triggers
    attachBtn?.addEventListener('click', () => fileInput?.click());
    fileInput?.addEventListener('change', (e) => {
      const file = fileInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => {
        attachedFileData = reader.result as string;
        if (mediaPreview && previewFileName) {
          mediaPreview.classList.remove('hidden');
          mediaPreview.classList.add('flex');
          previewFileName.textContent = file.name;
          if (previewImg && file.type.startsWith('image/')) {
            previewImg.src = attachedFileData;
            previewImg.classList.remove('hidden');
          }
        }
      };
      reader.readAsDataURL(file);
    });

    function clearMediaAttachment() {
      attachedFileData = null;
      if (fileInput) fileInput.value = '';
      if (mediaPreview) {
        mediaPreview.classList.add('hidden');
        mediaPreview.classList.remove('flex');
      }
      if (previewImg) {
        previewImg.src = '';
        previewImg.classList.add('hidden');
      }
    }

    removePreviewBtn?.addEventListener('click', clearMediaAttachment);

    // Safety Menu Toggle
    safetyMenuBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      safetyDropdown?.classList.toggle('hidden');
      safetyDropdown?.classList.toggle('flex');
    });

    document.addEventListener('click', () => {
      safetyDropdown?.classList.add('hidden');
      safetyDropdown?.classList.remove('flex');
    });

    // Next Stranger / Find Another Stranger
    nextStrangerBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('rc:next-stranger-requested'));
    });

    // Request Voice escalation
    requestVoiceBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('rc:voice-request-triggered', { detail: currentPartner }));
    });

    // Handle mobile virtual keyboard resize
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', () => {
        if (selectedState && !selectedState.classList.contains('hidden') && messagesList) {
          messagesList.scrollTop = messagesList.scrollHeight;
        }
      });
    }
  }

  initActiveChat();
  document.addEventListener('astro:page-load', initActiveChat);
</script>
