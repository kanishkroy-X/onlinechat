          <div class="flex items-center gap-2 text-[var(--text-primary)]">
            <span class="w-5 h-5 rounded-full bg-[#6C4DFF] text-white flex items-center justify-center text-[10px] font-bold">3</span>
            <span>Voice note exchanged → <strong class="text-[#6C4DFF]">Voice Chat Unlocks</strong>.</span>
          </div>
          <div class="flex items-center gap-2 text-[var(--text-primary)]">
