---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<section class="relative w-full overflow-hidden py-16 sm:py-24 flex flex-col items-center justify-center text-center px-4">
  <!-- Subtle Vice City Ambient Background Aura (8–15s Loop) -->
  <div class="absolute inset-0 -z-10 opacity-35 dark:opacity-30 pointer-events-none flex items-center justify-center">
    <div class="w-[650px] h-[500px] rounded-full bg-gradient-to-tr from-[#FF5CA8] via-[#BC6CFF] to-[#00F0FF] blur-[130px] ambient-vice-glow"></div>
  </div>

  <div class="max-w-3xl mx-auto flex flex-col items-center gap-6">
    <!-- Value Badge with Online Pulse -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border-color)] bg-[var(--bg-surface)]/80 shadow-sm text-xs font-semibold text-[var(--text-muted)] backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-[var(--color-vice-cyan)] animate-online-pulse"></span>
      <span class="text-[var(--color-vice-cyan)] font-bold">4,568 Strangers Online</span>
      <span class="text-[var(--text-subtle)]">•</span>
      <span>{t.hero.badge}</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[var(--text-main)] leading-[1.15]">
      Meet someone new. <br/>
      <span class="text-gradient">Start a conversation.</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-base sm:text-lg text-[var(--text-muted)] max-w-2xl font-normal leading-relaxed">
      Free, anonymous 1-on-1 text chat and random voice calls with people across the globe. No registration required.
    </p>

    <!-- Primary CTA Button with 180ms hover and mobile tap scale(0.97) -->
    <div class="mt-4 flex flex-col sm:flex-row items-center gap-4">
      <button
        id="hero-start-btn"
        type="button"
        class="gradient-vice-cta text-white font-bold text-base sm:text-lg px-8 py-4 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-0.5 active:scale-[0.97] transition-all duration-180 flex items-center gap-3 cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-[#FF5CA8]/40"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Start RandomChat</span>
      </button>

      <a
        href="/chat-rooms"
        class="px-6 py-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] hover:border-[var(--color-vice-cyan)]/40 text-[var(--text-main)] text-sm sm:text-base font-semibold transition-all duration-180 active:scale-[0.97]"
      >
        Explore Rooms &rarr;
      </a>
    </div>

    <!-- Interactive Glassmorphic Chat Experience Preview -->
    <div class="mt-8 w-full max-w-xl relative group">
      <!-- Glow undercard -->
      <div class="absolute -inset-1 bg-gradient-to-r from-[#FF5CA8] via-[#BC6CFF] to-[#00F0FF] rounded-3xl blur-lg opacity-25 group-hover:opacity-45 transition duration-500"></div>

      <div class="relative rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)]/95 backdrop-blur-xl p-5 shadow-2xl text-left overflow-hidden">
        <!-- Window header -->
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3 mb-4">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-[var(--color-sunset-pink)]/80"></div>
            <div class="w-3 h-3 rounded-full bg-[var(--color-miami-peach)]/80"></div>
            <div class="w-3 h-3 rounded-full bg-[var(--color-vice-cyan)]/80"></div>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-[var(--text-muted)] font-medium">
            <span class="w-2 h-2 rounded-full bg-[var(--color-vice-cyan)] animate-pulse"></span>
            <span>Connected with Stranger</span>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-[var(--color-sunset-pink)]/15 text-[var(--color-sunset-pink)] border border-[var(--color-sunset-pink)]/30">100% Anonymous</span>
        </div>

        <!-- Sample Conversation Stream -->
        <div class="flex flex-col gap-3 py-1 text-sm">
          <!-- Stranger Bubble -->
          <div class="flex items-start gap-2 max-w-[85%] animate-bubble-in">
            <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-[#FF5CA8] to-[#BC6CFF] text-white flex items-center justify-center text-xs font-bold shrink-0 shadow">
              S
            </div>
            <div class="bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] px-3.5 py-2 rounded-2xl rounded-tl-sm text-[var(--text-main)] text-xs sm:text-sm shadow-sm">
              Hey there! What are you listening to tonight? 🎵
            </div>
          </div>

          <!-- Me Bubble -->
          <div class="flex items-start gap-2 max-w-[85%] ml-auto flex-row-reverse animate-bubble-in" style="animation-delay: 150ms;">
            <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-[#00F0FF] to-[#BC6CFF] text-white flex items-center justify-center text-xs font-bold shrink-0 shadow">
              Me
            </div>
            <div class="gradient-vice-cta text-white px-3.5 py-2 rounded-2xl rounded-tr-sm text-xs sm:text-sm shadow-md">
              Just discovering some new ambient synthwave tracks! How about you? ✨
            </div>
          </div>

          <!-- Typing indicator live -->
          <div class="flex items-center gap-2 pt-1">
            <div class="w-6 h-6 rounded-full bg-[var(--bg-surface-elevated)] flex items-center justify-center shrink-0 border border-[var(--border-color)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-vice-cyan)]"></span>
            </div>
            <div class="bg-[var(--bg-surface-elevated)] px-3 py-1.5 rounded-full flex items-center gap-1 border border-[var(--border-color)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-vice-cyan)] typing-dot"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sunset-pink)] typing-dot"></span>
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-neon-purple)] typing-dot"></span>
            </div>
            <span class="text-[11px] text-[var(--text-subtle)] italic">Stranger is typing...</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
