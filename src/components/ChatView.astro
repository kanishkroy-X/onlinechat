---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<div id="chat-view" class="hidden w-full flex-1 flex flex-col h-[calc(100dvh-4rem)] max-w-7xl mx-auto p-0 sm:p-2 lg:p-3">
  <!-- Top Responsive Sub-Header / Mobile Navigation Bar -->
  <div class="lg:hidden px-4 py-2 border-b border-[var(--border-color)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
    <button
      id="chat-toggle-left-pane-btn"
      type="button"
      class="text-xs font-semibold text-[var(--color-vice-cyan)] flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--color-vice-cyan)]/10 border border-[var(--color-vice-cyan)]/30 hover:bg-[var(--color-vice-cyan)]/20 transition-colors cursor-pointer"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span>People & Rooms</span>
    </button>

    <div class="flex items-center gap-2">
      <button
        id="chat-mobile-voice-btn"
        type="button"
        class="text-xs font-semibold text-[var(--color-sunset-pink)] flex items-center gap-1 px-2.5 py-1 rounded-lg bg-[var(--color-sunset-pink)]/10 border border-[var(--color-sunset-pink)]/30 hover:bg-[var(--color-sunset-pink)]/20 transition-colors cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Voice</span>
      </button>

      <button
        id="chat-toggle-right-pane-btn"
        type="button"
        class="text-xs font-semibold text-[var(--text-muted)] flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] hover:text-[var(--text-main)] transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <span>Profile</span>
      </button>
    </div>
  </div>

  <!-- 3-Column Responsive Grid Layout -->
  <div class="flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-3 min-h-0 overflow-hidden">
    
    <!-- LEFT SIDEBAR: Online People & Quick Rooms (Desktop: 3 cols) -->
    <aside id="chat-left-sidebar" class="hidden lg:flex lg:col-span-3 flex-col bg-[var(--bg-surface)] border border-[var(--border-color)] lg:rounded-2xl overflow-hidden shadow-xl">
      <!-- Sidebar Header -->
      <div class="p-3.5 border-b border-[var(--border-color)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-[var(--color-vice-cyan)] animate-pulse"></div>
          <span class="font-bold text-sm text-[var(--text-main)]">People Online</span>
        </div>
        <span class="text-xs font-bold text-[var(--color-vice-cyan)] bg-[var(--color-vice-cyan)]/10 px-2 py-0.5 rounded-full border border-[var(--color-vice-cyan)]/20">
          4,568 online
        </span>
      </div>

      <!-- Filter / Country & Search -->
      <div class="p-3 border-b border-[var(--border-color)] flex flex-col gap-2 bg-[var(--bg-surface-elevated)]/50 shrink-0">
        <div class="relative">
          <select id="chat-sidebar-country-filter" class="w-full bg-[var(--bg-surface)] text-xs text-[var(--text-main)] rounded-xl border border-[var(--border-color)] px-3 py-2 focus:outline-none focus:border-[var(--color-vice-cyan)] cursor-pointer">
            <option value="all">🌍 Global (All Countries)</option>
            <option value="in">🇮🇳 India</option>
            <option value="us">🇺🇸 United States</option>
            <option value="uk">🇬🇧 United Kingdom</option>
            <option value="ca">🇨🇦 Canada</option>
            <option value="de">🇩🇪 Germany</option>
            <option value="au">🇦🇺 Australia</option>
          </select>
        </div>

        <div class="relative">
          <input
            id="chat-sidebar-search"
            type="text"
            placeholder="Search strangers..."
            class="w-full bg-[var(--bg-surface)] text-xs text-[var(--text-main)] placeholder:text-[var(--text-subtle)] rounded-xl border border-[var(--border-color)] px-3 py-2 pl-8 focus:outline-none focus:border-[var(--color-sunset-pink)]"
          />
          <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[var(--text-subtle)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
      </div>

      <!-- Online Users List -->
      <div class="flex-1 overflow-y-auto p-2 flex flex-col gap-1.5" id="chat-online-users-list">
        <!-- Sample simulated active users -->
        <div class="p-2.5 rounded-xl border border-[var(--border-color)]/60 bg-[var(--bg-surface-elevated)]/60 hover:border-[var(--color-sunset-pink)]/50 flex items-center justify-between transition-all cursor-pointer group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#FF5CA8] to-[#BC6CFF] flex items-center justify-center text-white text-xs font-bold shrink-0 shadow">
              M
              <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-[var(--bg-surface)]"></span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--color-sunset-pink)] truncate transition-colors">MiamiGirl</span>
              <span class="text-[10px] text-[var(--text-subtle)]">23 yrs • Florida, USA</span>
            </div>
          </div>
          <button type="button" class="text-xs text-[var(--color-sunset-pink)] hover:scale-110 transition-transform p-1" title="Favorite user">
            ★
          </button>
        </div>

        <div class="p-2.5 rounded-xl border border-[var(--border-color)]/60 bg-[var(--bg-surface-elevated)]/60 hover:border-[var(--color-vice-cyan)]/50 flex items-center justify-between transition-all cursor-pointer group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#00F0FF] to-[#BC6CFF] flex items-center justify-center text-white text-xs font-bold shrink-0 shadow">
              N
              <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-[var(--bg-surface)]"></span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--color-vice-cyan)] truncate transition-colors">NeonVibes</span>
              <span class="text-[10px] text-[var(--text-subtle)]">21 yrs • London, UK</span>
            </div>
          </div>
          <button type="button" class="text-xs text-[var(--text-subtle)] hover:text-[var(--color-sunset-pink)] transition-colors p-1" title="Favorite user">
            ☆
          </button>
        </div>

        <div class="p-2.5 rounded-xl border border-[var(--border-color)]/60 bg-[var(--bg-surface-elevated)]/60 hover:border-[var(--color-sunset-pink)]/50 flex items-center justify-between transition-all cursor-pointer group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#FFB86B] to-[#FF5CA8] flex items-center justify-center text-white text-xs font-bold shrink-0 shadow">
              O
              <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-[var(--bg-surface)]"></span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--color-sunset-pink)] truncate transition-colors">OceanDrive</span>
              <span class="text-[10px] text-[var(--text-subtle)]">26 yrs • California, USA</span>
            </div>
          </div>
          <button type="button" class="text-xs text-[var(--text-subtle)] hover:text-[var(--color-sunset-pink)] transition-colors p-1" title="Favorite user">
            ☆
          </button>
        </div>

        <div class="p-2.5 rounded-xl border border-[var(--border-color)]/60 bg-[var(--bg-surface-elevated)]/60 hover:border-[var(--color-vice-cyan)]/50 flex items-center justify-between transition-all cursor-pointer group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="relative w-8 h-8 rounded-full bg-gradient-to-tr from-[#BC6CFF] to-[#00F0FF] flex items-center justify-center text-white text-xs font-bold shrink-0 shadow">
              A
              <span class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-emerald-500 ring-2 ring-[var(--bg-surface)]"></span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-semibold text-[var(--text-main)] group-hover:text-[var(--color-vice-cyan)] truncate transition-colors">Alex_07</span>
              <span class="text-[10px] text-[var(--text-subtle)]">24 yrs • Mumbai, India</span>
            </div>
          </div>
          <button type="button" class="text-xs text-[var(--text-subtle)] hover:text-[var(--color-sunset-pink)] transition-colors p-1" title="Favorite user">
            ☆
          </button>
        </div>
      </div>

      <!-- Quick Rooms Widget -->
      <div class="p-3 border-t border-[var(--border-color)] bg-[var(--bg-surface-elevated)]/80 flex flex-col gap-2 shrink-0">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">Quick Rooms</span>
          <a href="/chat-rooms" class="text-[10px] font-semibold text-[var(--color-vice-cyan)] hover:underline">View All &rarr;</a>
        </div>
        <div class="grid grid-cols-2 gap-1.5 text-xs">
          <a href="/chat-rooms/india" class="p-1.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--color-sunset-pink)]/40 flex items-center justify-between text-[11px] text-[var(--text-muted)] hover:text-[var(--text-main)]">
            <span class="truncate">🇮🇳 India</span>
            <span class="text-[10px] text-[var(--color-vice-cyan)] font-bold">49</span>
          </a>
          <a href="/chat-rooms/dating" class="p-1.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--color-sunset-pink)]/40 flex items-center justify-between text-[11px] text-[var(--text-muted)] hover:text-[var(--text-main)]">
            <span class="truncate">💖 Dating</span>
            <span class="text-[10px] text-[var(--color-sunset-pink)] font-bold">203</span>
          </a>
          <a href="/chat-rooms/singles" class="p-1.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--color-sunset-pink)]/40 flex items-center justify-between text-[11px] text-[var(--text-muted)] hover:text-[var(--text-main)]">
            <span class="truncate">✨ Singles</span>
            <span class="text-[10px] text-[var(--color-miami-peach)] font-bold">76</span>
          </a>
          <a href="/chat-rooms/music" class="p-1.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--color-sunset-pink)]/40 flex items-center justify-between text-[11px] text-[var(--text-muted)] hover:text-[var(--text-main)]">
            <span class="truncate">🎵 Music</span>
            <span class="text-[10px] text-[var(--color-neon-purple)] font-bold">55</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- CENTER PANE: Active 1:1 Stranger Chat (Desktop: 6 cols, Mobile: Full) -->
    <main class="col-span-1 lg:col-span-6 flex flex-col bg-[var(--bg-surface)] border border-[var(--border-color)] lg:rounded-2xl shadow-xl overflow-hidden min-h-0 h-full">
      <!-- Chat Top Bar -->
      <div class="px-4 py-3 border-b border-[var(--border-color)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <!-- Stranger Avatar with Glow -->
          <div class="relative w-11 h-11 rounded-2xl bg-gradient-to-tr from-[#FF5CA8] via-[#BC6CFF] to-[#00F0FF] flex items-center justify-center text-white font-bold text-base shadow-md">
            <span id="chat-stranger-avatar">S</span>
            <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-[var(--color-vice-cyan)] ring-2 ring-[var(--bg-surface)] animate-pulse"></span>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span id="chat-stranger-nick" class="font-bold text-base text-[var(--text-main)] truncate max-w-[140px] sm:max-w-[200px]">
                Stranger
              </span>
              <span id="chat-stranger-gender" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--color-vice-cyan)]/15 text-[var(--color-vice-cyan)] border border-[var(--color-vice-cyan)]/30 capitalize">
                Anyone
              </span>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <div class="flex items-center gap-1.5 text-[var(--color-vice-cyan)] font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-vice-cyan)]"></span>
                <span>{t.chat.connectedStatus}</span>
              </div>
              <span class="text-[var(--text-subtle)]">•</span>
              <span id="chat-stranger-country" class="text-[var(--text-subtle)]">California, USA</span>
              <span id="chat-stranger-language" class="hidden"></span>
            </div>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="flex items-center gap-2">
          <!-- Voice Call Trigger CTA Button -->
          <button
            id="chat-voice-call-btn"
            type="button"
            class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[var(--color-sunset-pink)]/15 border border-[var(--color-sunset-pink)]/30 hover:bg-[var(--color-sunset-pink)]/25 text-[var(--color-sunset-pink)] text-xs font-bold transition-all cursor-pointer"
            title="Start Audio Voice Call"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Voice Call</span>
          </button>

          <!-- Next Stranger Button -->
          <button
            id="chat-next-btn"
            type="button"
            class="gradient-vice-cta text-white text-xs sm:text-sm font-bold px-3 sm:px-4 py-2 rounded-xl shadow-md hover:shadow-lg flex items-center gap-1.5 transition-all cursor-pointer hover:scale-105"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="13 17 18 12 13 7"></polyline>
              <polyline points="6 17 11 12 6 7"></polyline>
            </svg>
            <span>{t.chat.nextStranger}</span>
          </button>

          <!-- 3-Dot Dropdown Trigger -->
          <div class="relative">
            <button
              id="chat-menu-btn"
              type="button"
              class="w-9 h-9 flex items-center justify-center rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors cursor-pointer"
              aria-label="More Chat Options"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="12" cy="5" r="1"></circle>
                <circle cx="12" cy="19" r="1"></circle>
              </svg>
            </button>

            <!-- Dropdown Menu -->
            <div id="chat-dropdown" class="hidden absolute right-0 top-11 z-30 w-52 bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl shadow-2xl py-1.5 flex flex-col text-xs font-semibold">
              <button id="menu-voice-btn" class="w-full px-4 py-2.5 text-left text-[var(--color-sunset-pink)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Invite to Voice Chat
              </button>
              <button id="menu-interests-btn" class="w-full px-4 py-2.5 text-left text-[var(--color-vice-cyan)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Share Interests
              </button>
              <button id="menu-clear-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-muted)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                Clear Chat
              </button>
              <div class="h-px bg-[var(--border-color)] my-1"></div>
              <button id="menu-report-btn" class="w-full px-4 py-2.5 text-left text-amber-400 hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
                {t.chat.report}
              </button>
              <button id="menu-block-btn" class="w-full px-4 py-2.5 text-left text-red-400 hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                {t.chat.block}
              </button>
              <button id="menu-leave-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                {t.chat.leave}
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Action Pills Strip -->
      <div class="px-4 py-2 border-b border-[var(--border-color)]/60 bg-[var(--bg-surface-elevated)]/40 flex items-center gap-2 overflow-x-auto text-xs shrink-0">
        <button
          id="quick-voice-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--color-sunset-pink)] hover:border-[var(--color-sunset-pink)]/50 hover:bg-[var(--color-sunset-pink)]/10 transition-colors whitespace-nowrap cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>Invite to Voice</span>
        </button>

        <button
          id="quick-share-interest-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--color-vice-cyan)] hover:border-[var(--color-vice-cyan)]/50 hover:bg-[var(--color-vice-cyan)]/10 transition-colors whitespace-nowrap cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span>Share Interests</span>
        </button>

        <button
          id="quick-clear-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)] transition-colors whitespace-nowrap cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          <span>Clear Chat</span>
        </button>
      </div>

      <!-- Messages Scroll Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 flex flex-col gap-3.5 sunset-chat-waves relative" role="log" aria-live="polite">
        <!-- Welcome Match Notice -->
        <div class="text-center py-2.5 px-4 rounded-2xl bg-[var(--bg-surface-elevated)]/90 border border-[var(--border-color)] text-xs text-[var(--text-muted)] max-w-md mx-auto shadow-md backdrop-blur-sm">
          <div class="flex items-center justify-center gap-2 mb-1">
            <span class="text-sm">🎉</span>
            <span class="font-bold text-[var(--color-sunset-pink)]">It's a Match!</span>
          </div>
          You're connected with a compatible stranger. Never share personal contact info or passwords.
        </div>
      </div>

      <!-- Typing Indicator -->
      <div id="chat-typing-indicator" class="hidden px-4 py-2 text-xs text-[var(--color-vice-cyan)] italic flex items-center gap-2 bg-[var(--bg-surface-elevated)] border-t border-[var(--border-color)]/50 shrink-0">
        <div class="flex items-center gap-1 bg-[var(--bg-surface)] px-2.5 py-1 rounded-full border border-[var(--border-color)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-vice-cyan)] typing-dot"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sunset-pink)] typing-dot"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-neon-purple)] typing-dot"></span>
        </div>
        <span>{t.chat.typing}</span>
      </div>

      <!-- 2-Message Cold Gate Warning Banner -->
      <div id="cold-gate-banner" class="hidden px-4 py-2.5 bg-amber-500/10 border-t border-amber-500/20 text-amber-300 text-xs font-semibold flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>{t.chat.coldGateLimit}</span>
        </div>
      </div>

      <!-- Attachment Preview Container -->
      <div id="chat-media-preview-container" class="hidden px-3 pt-2 pb-1 border-t border-[var(--border-color)] bg-[var(--bg-surface-elevated)] flex items-center gap-3 shrink-0">
        <div class="relative group">
          <img id="chat-image-preview" src="" alt="Attachment preview" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border-color)] shadow-sm" />
          <video id="chat-video-preview" src="" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border-color)] shadow-sm" muted></video>
          <button
            id="chat-remove-media-btn"
            type="button"
            class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-600 text-white rounded-full flex items-center justify-center text-xs shadow hover:bg-red-700 transition-colors cursor-pointer"
            aria-label="Remove attachment"
          >
            &times;
          </button>
        </div>
        <div class="flex flex-col text-xs text-[var(--text-muted)]">
          <span id="chat-media-name" class="font-medium truncate max-w-[200px]">image.png</span>
          <span class="text-[10px] text-[var(--text-subtle)]">Attached media</span>
        </div>
      </div>

      <!-- Emoji Picker Popover -->
      <div id="chat-emoji-popover" class="hidden p-3 border-t border-[var(--border-color)] bg-[var(--bg-surface-elevated)] grid grid-cols-8 gap-2 text-xl shrink-0">
        {['😊', '😂', '🔥', '✨', '👋', '❤️', '🌴', '😎', '🎉', '🚀', '💯', '🤔', '👀', '🤙', '🙌', '🍹'].map(emoji => (
          <button type="button" class="chat-emoji-btn hover:scale-125 transition-transform p-1 text-center cursor-pointer">
            {emoji}
          </button>
        ))}
      </div>

      <!-- Chat Composer Area -->
      <div class="p-3 border-t border-[var(--border-color)] bg-[var(--bg-surface)] shrink-0">
        <form id="chat-composer-form" class="flex items-center gap-2">
          <!-- Hidden File Input -->
          <input
            id="chat-file-input"
            type="file"
            accept="image/*,video/*"
            class="hidden"
          />

          <!-- Gallery Attachment Button -->
          <button
            id="chat-attach-btn"
            type="button"
            class="w-10 h-10 flex items-center justify-center rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--color-sunset-pink)] transition-colors shrink-0 cursor-pointer"
            aria-label="Attach Photo or Video"
            title="Attach Photo or Video"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
          </button>

          <!-- Emoji Picker Trigger Button -->
          <button
            id="chat-emoji-toggle-btn"
            type="button"
            class="w-10 h-10 flex items-center justify-center rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--color-miami-peach)] transition-colors shrink-0 cursor-pointer"
            aria-label="Insert Emoji"
            title="Emojis"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
          </button>

          <!-- Message Text Input -->
          <input
            id="chat-input"
            type="text"
            placeholder={t.chat.placeholder}
            maxlength="1000"
            autocomplete="off"
            class="flex-1 px-4 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] text-[var(--text-main)] placeholder:text-[var(--text-subtle)] focus:outline-none focus:border-[var(--color-sunset-pink)] focus:ring-1 focus:ring-[var(--color-sunset-pink)] transition-all text-sm"
            aria-label="Type your message"
          />

          <!-- Send Message Button -->
          <button
            id="chat-send-btn"
            type="submit"
            class="gradient-vice-cta text-white p-2.5 rounded-xl shadow-md hover:shadow-lg disabled:opacity-40 disabled:cursor-not-allowed transition-all shrink-0 cursor-pointer hover:scale-105"
            aria-label="Send message"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>

        <!-- Bottom Action Bar: Report, Block, Next -->
        <div class="mt-2 pt-2 border-t border-[var(--border-color)]/50 flex items-center justify-between text-xs text-[var(--text-subtle)]">
          <div class="flex items-center gap-3">
            <button id="bottom-report-btn" type="button" class="hover:text-amber-400 flex items-center gap-1 transition-colors cursor-pointer">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
              <span>Report</span>
            </button>
            <button id="bottom-block-btn" type="button" class="hover:text-red-400 flex items-center gap-1 transition-colors cursor-pointer">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
              <span>Block</span>
            </button>
          </div>
          <div class="flex items-center gap-1 text-[11px]">
            <span>Press</span>
            <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] font-mono text-[10px]">Enter</kbd>
            <span>to send</span>
          </div>
        </div>
      </div>
    </main>

    <!-- RIGHT SIDEBAR: Stranger Info & Safety Guidelines (Desktop: 3 cols) -->
    <aside id="chat-right-sidebar" class="hidden lg:flex lg:col-span-3 flex-col gap-3 overflow-y-auto">
      <!-- Stranger User Info Card -->
      <div class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] flex flex-col gap-3.5 shadow-xl">
        <div class="flex items-center gap-2 border-b border-[var(--border-color)] pb-2.5">
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-subtle)]">Stranger Profile</span>
        </div>

        <div class="flex flex-col items-center text-center gap-2">
          <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-[#FF5CA8] to-[#00F0FF] p-0.5 shadow-lg">
            <div class="w-full h-full rounded-full bg-[var(--bg-surface)] flex items-center justify-center text-xl font-bold text-white">
              <span id="side-stranger-avatar">S</span>
            </div>
          </div>
          <div class="flex flex-col">
            <span id="side-stranger-nick" class="font-bold text-sm text-[var(--text-main)]">Stranger</span>
            <div class="flex items-center justify-center gap-1.5 text-xs text-[var(--color-vice-cyan)] mt-0.5">
              <span class="w-2 h-2 rounded-full bg-[var(--color-vice-cyan)] animate-pulse"></span>
              <span>Online Now</span>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-2 pt-2 border-t border-[var(--border-color)]/60 text-xs">
          <div class="flex items-center justify-between text-[var(--text-muted)]">
            <span>Age & Location</span>
            <span id="side-stranger-loc" class="font-medium text-[var(--text-main)]">24 yrs, USA</span>
          </div>
          <div class="flex items-center justify-between text-[var(--text-muted)]">
            <span>Purpose</span>
            <span class="font-medium text-[var(--color-miami-peach)]">Chatting for fun</span>
          </div>
        </div>

        <!-- Interests Chips -->
        <div class="flex flex-col gap-1.5 pt-2 border-t border-[var(--border-color)]/60">
          <span class="text-[11px] font-semibold text-[var(--text-subtle)]">Interests</span>
          <div class="flex flex-wrap gap-1.5" id="side-stranger-interests">
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] text-[var(--text-muted)]">🎵 Music</span>
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] text-[var(--text-muted)]">🎮 Gaming</span>
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] text-[var(--text-muted)]">✈️ Travel</span>
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border-color)] text-[var(--text-muted)]">🎬 Movies</span>
          </div>
        </div>
      </div>

      <!-- Safety & Trust Card -->
      <div class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] flex flex-col gap-3 shadow-xl">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-[var(--color-sunset-pink)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-main)]">Safety Tips</span>
        </div>

        <ul class="flex flex-col gap-2 text-xs text-[var(--text-muted)]">
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-sunset-pink)]">•</span>
            <span>Never share personal contact info, addresses, or banking details.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-vice-cyan)]">•</span>
            <span>Be respectful and adhere to community guidelines.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--color-neon-purple)]">•</span>
            <span>Report or block any inappropriate behavior immediately.</span>
          </li>
        </ul>

        <div class="pt-2 border-t border-[var(--border-color)]/60 flex items-center justify-between">
          <span class="text-[11px] text-[var(--text-subtle)]">Need guidance?</span>
          <a href="/safety" class="text-xs font-bold text-[var(--color-sunset-pink)] hover:underline">
            Safety Guide &rarr;
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- VOICE CALL INTERACTIVE MODAL (Audio Radar Visualizer) -->
<div id="voice-call-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-[#070B18]/90 backdrop-blur-lg animate-in fade-in duration-200">
  <div class="w-full max-w-md rounded-3xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 sm:p-8 flex flex-col items-center text-center gap-6 shadow-2xl relative overflow-hidden">
    <!-- Neon Top Glow Background -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-64 h-64 bg-[var(--color-sunset-pink)]/20 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Modal Header -->
    <div class="flex flex-col items-center gap-1 z-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-vice-cyan)]/15 border border-[var(--color-vice-cyan)]/30 text-[var(--color-vice-cyan)] text-xs font-bold">
        <span class="w-2 h-2 rounded-full bg-[var(--color-vice-cyan)] animate-pulse"></span>
        <span>Random Voice Call</span>
      </div>
      <h3 id="voice-partner-name" class="text-xl font-black text-[var(--text-main)] mt-1">Stranger</h3>
      <span id="voice-call-status" class="text-xs text-[var(--text-muted)]">Connected • Audio Active</span>
    </div>

    <!-- Multi-Ring Soundwave Radar Visualizer -->
    <div class="relative w-48 h-48 sm:w-56 sm:h-56 flex items-center justify-center my-2 z-10">
      <!-- Animated Ripple Waves -->
      <div id="voice-ring-1" class="absolute inset-0 rounded-full border border-[var(--color-sunset-pink)]/30 animate-radar-wave transition-transform duration-75"></div>
      <div id="voice-ring-2" class="absolute inset-4 rounded-full border border-[var(--color-vice-cyan)]/40 animate-radar-wave transition-transform duration-75" style="animation-delay: 0.6s;"></div>
      <div id="voice-ring-3" class="absolute inset-8 rounded-full border border-[var(--color-neon-purple)]/50 animate-radar-wave transition-transform duration-75" style="animation-delay: 1.2s;"></div>

      <!-- Center Audio Orb -->
      <div id="voice-center-orb" class="w-24 h-24 rounded-full bg-gradient-to-tr from-[#FF5CA8] via-[#BC6CFF] to-[#00F0FF] p-1 shadow-2xl pulsing-orb transition-transform duration-75">
        <div class="w-full h-full rounded-full bg-[var(--bg-surface)] flex items-center justify-center text-white">
          <svg class="w-10 h-10 text-[var(--color-vice-cyan)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
            <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
            <line x1="12" y1="19" x2="12" y2="22"></line>
          </svg>
        </div>
      </div>
    </div>

    <!-- Call Duration Timer -->
    <div class="flex flex-col items-center gap-1 z-10">
      <span id="voice-call-timer" class="font-mono text-2xl font-black tracking-wider text-[var(--text-main)]">00:00</span>
      <div class="flex items-center gap-2">
        <span class="text-[11px] text-[var(--text-subtle)]">Encrypted Peer-to-Peer Audio</span>
        <span id="voice-muted-badge" class="hidden text-[10px] uppercase font-bold px-2 py-0.5 rounded-full bg-red-500/20 text-red-400 border border-red-500/30">Muted</span>
      </div>
    </div>

    <!-- Control Buttons Toolbar -->
    <div class="w-full flex items-center justify-center gap-4 z-10">
      <!-- Mute Mic -->
      <button
        id="voice-mute-btn"
        type="button"
        class="w-12 h-12 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] flex flex-col items-center justify-center text-[10px] font-semibold gap-1 transition-all cursor-pointer"
        title="Toggle Microphone"
      >
        <svg class="w-5 h-5 text-[var(--color-vice-cyan)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="1" y1="1" x2="23" y2="23"/><path d="M9 9v3a3 3 0 0 0 5.12 2.12M15 9.34V5a3 3 0 0 0-5.94-.6"/><path d="M17 16.95A7 7 0 0 1 5 12v-2m14 0v2a7 7 0 0 1-.11 1.23"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
      </button>

      <!-- End Call Red CTA -->
      <button
        id="voice-end-btn"
        type="button"
        class="h-12 px-6 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold text-sm shadow-lg shadow-red-600/30 flex items-center gap-2 transition-transform hover:scale-105 cursor-pointer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.42 19.42 0 0 1-3.33-2.67m-2.67-3.34a19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/><line x1="23" y1="1" x2="1" y2="23"/></svg>
        <span>End Call</span>
      </button>

      <!-- Speaker Toggle -->
      <button
        id="voice-speaker-btn"
        type="button"
        class="w-12 h-12 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] flex flex-col items-center justify-center text-[10px] font-semibold gap-1 transition-all cursor-pointer"
        title="Toggle Speakerphone"
      >
        <svg class="w-5 h-5 text-[var(--color-sunset-pink)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- Image Lightbox Modal -->
<div id="chat-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md">
  <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-[#FF5CA8] transition-colors p-2 cursor-pointer" aria-label="Close image preview">
    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <img id="lightbox-img" src="" alt="Enlarged view" class="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
</div>
