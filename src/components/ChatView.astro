---
import { getTranslations } from '../i18n/translations';
import Icon from './icons/Icon.astro';
import { siteConfig } from '../config/site';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<div id="chat-view" class="w-full flex-1 flex flex-col h-[100dvh] max-w-3xl mx-auto p-0 sm:p-2 lg:p-3 bg-[var(--bg-page)] relative select-none">
  
  <!-- Outer Card for PC, Fullscreen for Mobile -->
  <div class="w-full flex-1 flex flex-col h-full bg-[var(--bg-surface)] sm:border sm:border-[var(--border)] sm:rounded-3xl shadow-xl overflow-hidden relative">

    <!-- 1. TOP BRAND NAVIGATION STRIP -->
    <nav class="w-full bg-[var(--primary)] text-white px-3 py-2 flex items-center justify-between shadow-xs shrink-0 z-40">
      <!-- Left: Hamburger Menu / Home Link -->
      <div class="flex items-center gap-2">
        <button
          id="chat-drawer-toggle-btn"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/15 active:bg-white/25 transition-colors cursor-pointer text-white shrink-0"
          aria-label="Open Navigation Menu"
        >
          <Icon name="menu" class="w-5 h-5 text-white" />
        </button>

        <a href="/" class="hidden sm:flex items-center gap-1.5 font-black text-sm tracking-tight text-white hover:opacity-90 transition-opacity">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{siteConfig.name}</span>
        </a>
      </div>

      <!-- Center: Navigation Tabs (1 on 1, Rooms, Voice, Video) -->
      <div class="flex items-center gap-1 overflow-x-auto no-scrollbar py-0.5 px-1 text-xs font-bold">
        <a
          href="/chat"
          class="px-3 py-1 rounded-full bg-white text-[var(--primary)] shadow-xs flex items-center gap-1.5 transition-all whitespace-nowrap"
        >
          <Icon name="message-square" class="w-3.5 h-3.5" />
          <span>1 on 1 Chat</span>
        </a>

        <a
          href="/chat-rooms"
          class="px-2.5 py-1 rounded-full text-white/90 hover:text-white hover:bg-white/15 transition-colors whitespace-nowrap flex items-center gap-1"
        >
          <Icon name="users" class="w-3.5 h-3.5" />
          <span>Rooms</span>
        </a>

        <a
          href="/random-voice-chat"
          class="px-2.5 py-1 rounded-full text-white/90 hover:text-white hover:bg-white/15 transition-colors whitespace-nowrap flex items-center gap-1"
        >
          <Icon name="mic" class="w-3.5 h-3.5" />
          <span>Voice</span>
        </a>

        <a
          href="/random-chat"
          class="px-2.5 py-1 rounded-full text-white/90 hover:text-white hover:bg-white/15 transition-colors whitespace-nowrap flex items-center gap-1"
        >
          <Icon name="video" class="w-3.5 h-3.5" />
          <span>Video</span>
        </a>
      </div>

      <!-- Right: Audio Sound Mute / Unmute Button -->
      <button
        id="chat-sound-toggle-btn"
        type="button"
        class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/15 active:bg-white/25 transition-colors cursor-pointer text-white shrink-0"
        title="Toggle Sound Effects"
        aria-label="Toggle Sound"
      >
        <span id="sound-icon-on"><Icon name="volume-2" class="w-5 h-5 text-white" /></span>
        <span id="sound-icon-off" class="hidden"><Icon name="volume-x" class="w-5 h-5 text-white/70" /></span>
      </button>
    </nav>

    <!-- 2. SUBHEADER: PARTNER DETAILS & ACTIONS -->
    <header class="w-full px-3 sm:px-4 py-2.5 bg-[var(--bg-surface)] border-b border-[var(--border)] flex items-center justify-between shrink-0 z-30">
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Back Pill Button -->
        <a
          id="chat-back-link"
          href="/"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full border border-[var(--primary)]/30 text-[var(--primary)] hover:bg-[var(--primary)]/10 font-bold text-xs sm:text-sm transition-colors cursor-pointer shrink-0"
          aria-label="Back to home"
        >
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
          <span>Back</span>
        </a>

        <!-- Avatar with Status Dot -->
        <div class="relative w-10 h-10 rounded-full bg-pink-100 dark:bg-pink-950/60 border border-pink-200 dark:border-pink-800/50 flex items-center justify-center text-xl shadow-xs shrink-0 overflow-hidden">
          <span id="chat-stranger-avatar" class="select-none text-lg">💋</span>
          <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-white dark:ring-[#161922]"></span>
        </div>

        <!-- Partner Username & Demographic Subtitle -->
        <div class="flex flex-col min-w-0 leading-tight">
          <div class="flex items-center gap-1.5">
            <span id="chat-stranger-nick" class="font-black text-sm sm:text-base text-[var(--text-primary)] truncate">
              Arnob29
            </span>
          </div>
          <span id="chat-stranger-bio" class="text-[11px] sm:text-xs text-[var(--text-muted)] truncate">
            Male, 29 Yrs · Online Now
          </span>
        </div>
      </div>

      <!-- Header Action Icons -->
      <div class="flex items-center gap-1 shrink-0">
        <!-- Favorite Heart Button -->
        <button
          id="chat-favorite-btn"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--text-muted)] hover:text-[var(--primary)] hover:bg-[var(--primary)]/10 transition-colors cursor-pointer relative"
          title="Add to Favorites"
          aria-label="Add to Favorites"
        >
          <Icon name="heart" class="w-5 h-5" />
          <span class="absolute -top-0.5 -right-0.5 text-[9px] font-black text-[var(--primary)]">+</span>
        </button>

        <!-- Skip / Next Stranger Button -->
        <button
          id="chat-header-next-btn"
          type="button"
          class="hidden sm:inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] hover:bg-[var(--primary)] hover:text-white font-bold text-xs transition-all cursor-pointer"
          title="Skip to next stranger"
        >
          <Icon name="zap" class="w-3.5 h-3.5" />
          <span>Skip</span>
        </button>

        <!-- 3-Dots Dropdown Trigger -->
        <div class="relative">
          <button
            id="chat-menu-btn"
            type="button"
            class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-hover)] transition-colors cursor-pointer"
            aria-label="Chat Options"
          >
            <Icon name="more-vertical" class="w-5 h-5" />
          </button>

          <!-- Dropdown Menu -->
          <div id="chat-dropdown" class="hidden absolute right-0 top-9 z-50 w-48 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl shadow-xl py-1.5 flex flex-col text-xs font-semibold">
            <button id="menu-next-btn" class="w-full px-4 py-2.5 text-left text-[var(--primary)] hover:bg-[var(--primary)]/10 flex items-center gap-2.5 transition-colors cursor-pointer">
              <Icon name="zap" class="w-4 h-4" />
              Next Stranger (Skip)
            </button>
            <button id="menu-clear-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-2.5 transition-colors cursor-pointer">
              <Icon name="refresh-cw" class="w-4 h-4 text-gray-400" />
              Clear Chat
            </button>
            <div class="h-px bg-[var(--border)] my-1"></div>
            <button id="menu-report-btn" class="w-full px-4 py-2.5 text-left text-amber-600 hover:bg-amber-50 dark:hover:bg-amber-950/30 flex items-center gap-2.5 transition-colors cursor-pointer">
              <Icon name="flag" class="w-4 h-4 text-amber-500" />
              Report User
            </button>
            <button id="menu-block-btn" class="w-full px-4 py-2.5 text-left text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 flex items-center gap-2.5 transition-colors cursor-pointer">
              <Icon name="user-x" class="w-4 h-4 text-rose-500" />
              Block User
            </button>
            <button id="menu-leave-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-2.5 transition-colors cursor-pointer">
              <Icon name="arrow-right" class="w-4 h-4 text-gray-400" />
              Leave Chat
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- 3. TOP SAFETY ADVISORY BANNER -->
    <div class="w-full px-3 py-1.5 bg-[var(--bg-surface-elevated)] border-b border-[var(--border)] text-center shrink-0">
      <p class="text-[11px] sm:text-xs text-[var(--text-secondary)] font-medium">
        🔒 Remember: In Online Chat With Strangers Never Share Personal Information!
      </p>
    </div>

    <!-- 4. CHAT MESSAGES CANVAS -->
    <div id="chat-messages" class="flex-1 overflow-y-auto p-3 sm:p-4 flex flex-col gap-3 min-h-[250px] bg-[var(--bg-page)]" role="log" aria-live="polite">
      
      <!-- Welcome System Notice -->
      <div class="text-center py-2 px-3 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] text-[11px] sm:text-xs text-[var(--text-secondary)] max-w-sm mx-auto shadow-xs">
        👋 Anonymous 1-on-1 session connected. Say hello to start the conversation!
      </div>

      <!-- INLINE CHAT ENDED CARD (When Stranger Leaves / Skips) -->
      <div id="inline-chat-ended-card" class="hidden my-4 p-5 rounded-3xl bg-[var(--bg-surface)] border border-pink-200 dark:border-pink-900/50 shadow-md flex flex-col items-center text-center gap-2 max-w-md self-center animate-msg-in">
        <div class="inline-flex items-center px-3 py-0.5 rounded-full bg-[var(--primary)]/10 text-[10px] font-bold text-[var(--primary)] uppercase tracking-wider">
          CHAT ENDED
        </div>
        <h3 class="font-bold text-sm sm:text-base text-[var(--text-primary)]">
          <span id="ended-card-nick">Stranger</span> left the conversation
        </h3>
        <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
          Don't worry! Tap below to match instantly with someone new.
        </p>
        <div class="pt-2 flex items-center gap-3 w-full">
          <button
            id="ended-find-match-btn"
            type="button"
            class="flex-1 py-3 rounded-full bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white font-bold text-xs sm:text-sm shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-98"
          >
            <Icon name="zap" class="w-4 h-4 text-white" />
            <span>Find New Match</span>
          </button>
          <button id="ended-card-report-btn" type="button" class="text-xs text-amber-600 dark:text-amber-400 font-bold hover:underline cursor-pointer px-2">
            Report
          </button>
        </div>
      </div>
    </div>

    <!-- TYPING INDICATOR -->
    <div id="chat-typing-indicator" class="hidden px-4 py-1.5 text-xs text-[var(--primary)] italic flex items-center gap-2 bg-[var(--bg-surface-elevated)] border-t border-[var(--border)] shrink-0">
      <div class="flex items-center gap-1 bg-[var(--bg-surface)] px-2 py-0.5 rounded-full border border-[var(--border)]">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce" style="animation-delay: 150ms;"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce" style="animation-delay: 300ms;"></span>
      </div>
      <span>Stranger is typing...</span>
    </div>

    <!-- COLD GATE BANNER -->
    <div id="cold-gate-banner" class="hidden px-4 py-2 bg-amber-500/10 border-t border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-semibold flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <Icon name="lock" class="w-4 h-4 shrink-0" />
        <span>Waiting for stranger's reply before unlocking next message.</span>
      </div>
    </div>

    <!-- ATTACHMENT PREVIEW CONTAINER -->
    <div id="chat-media-preview-container" class="hidden px-3 pt-2 pb-1 border-t border-[var(--border)] bg-[var(--bg-surface)] flex items-center gap-3 shrink-0">
      <div class="relative group">
        <img id="chat-image-preview" src="" alt="Attachment preview" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border-strong)] shadow-xs" />
        <video id="chat-video-preview" src="" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border-strong)] shadow-xs" muted></video>
        <button
          id="chat-remove-media-btn"
          type="button"
          class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-rose-600 text-white rounded-full flex items-center justify-center text-xs shadow-xs hover:bg-rose-700 transition-colors cursor-pointer"
          aria-label="Remove attachment"
        >
          &times;
        </button>
      </div>
      <div class="flex flex-col text-xs text-[var(--text-secondary)]">
        <span id="chat-media-name" class="font-medium truncate max-w-[200px]">image.png</span>
        <span class="text-[10px] text-[var(--text-muted)]">Attached media ready to send</span>
      </div>
    </div>

    <!-- QUICK EMOJI TRAY DRAWER -->
    <div id="quick-emoji-tray" class="hidden px-3 py-2 border-t border-[var(--border)] bg-[var(--bg-surface)] flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0 text-xl">
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">😊</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">😂</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">❤️</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">🔥</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">😍</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">👍</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">🎉</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">👋</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">💯</button>
      <button type="button" class="emoji-btn hover:scale-125 transition-transform p-1 cursor-pointer">🤫</button>
    </div>

    <!-- QUICK GIF / REACTION TRAY -->
    <div id="quick-gif-tray" class="hidden px-3 py-2.5 border-t border-[var(--border)] bg-[var(--bg-surface)] flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0">
      <button type="button" class="gif-preset-btn px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-bold hover:bg-[var(--primary)] hover:text-white transition-colors whitespace-nowrap cursor-pointer">👋 Hello!</button>
      <button type="button" class="gif-preset-btn px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-bold hover:bg-[var(--primary)] hover:text-white transition-colors whitespace-nowrap cursor-pointer">✨ ASL?</button>
      <button type="button" class="gif-preset-btn px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-bold hover:bg-[var(--primary)] hover:text-white transition-colors whitespace-nowrap cursor-pointer">💖 Nice to meet you</button>
      <button type="button" class="gif-preset-btn px-3 py-1 rounded-full bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] text-xs font-bold hover:bg-[var(--primary)] hover:text-white transition-colors whitespace-nowrap cursor-pointer">😂 Hahaha</button>
    </div>

    <!-- 5. DOCKED CHAT INPUT COMPOSER (Responsive for Mobile & PC) -->
    <div id="chat-composer-section" class="px-3 py-2 sm:py-3 border-t border-[var(--border)] bg-[var(--bg-surface)] shrink-0 sticky bottom-0 z-30">
      <form id="chat-composer-form" class="flex items-center gap-1.5 sm:gap-2">
        <input id="chat-file-input" type="file" accept="image/*,video/*" class="hidden" />

        <!-- Rounded Input Capsule -->
        <div class="flex-1 relative">
          <input
            id="chat-input"
            type="text"
            placeholder="Type a message..."
            maxlength="1000"
            autocomplete="off"
            class="w-full px-4 py-2 sm:py-2.5 rounded-full border border-[var(--border)] bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent transition-all text-sm"
            aria-label="Type your message"
          />
        </div>

        <!-- Star Action Button -->
        <button
          id="chat-star-btn"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-full text-amber-400 hover:text-amber-500 hover:scale-110 active:scale-95 transition-all cursor-pointer shrink-0"
          title="Send Star"
          aria-label="Send Star"
        >
          <Icon name="star" class="w-5 h-5 text-amber-400" />
        </button>

        <!-- Emoji Picker Button -->
        <button
          id="chat-emoji-btn"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--text-secondary)] hover:text-[var(--primary)] hover:scale-110 active:scale-95 transition-all cursor-pointer shrink-0"
          title="Choose Emoji"
          aria-label="Emoji Picker"
        >
          <Icon name="smile" class="w-5 h-5" />
        </button>

        <!-- GIF Button -->
        <button
          id="chat-gif-btn"
          type="button"
          class="h-7 px-1.5 rounded-md border-2 border-[var(--text-muted)] text-[var(--text-primary)] font-black text-[11px] flex items-center justify-center hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors cursor-pointer shrink-0 tracking-tight"
          title="Quick Chat Greetings"
          aria-label="GIF Greetings"
        >
          GIF
        </button>

        <!-- Camera Attachment Button -->
        <button
          id="chat-attach-btn"
          type="button"
          class="w-8 h-8 flex items-center justify-center rounded-full text-[var(--text-secondary)] hover:text-[var(--primary)] hover:scale-110 active:scale-95 transition-all cursor-pointer shrink-0"
          title="Attach Photo"
          aria-label="Attach Photo"
        >
          <Icon name="camera" class="w-5 h-5" />
        </button>

        <!-- Send Button: Primary Pill Button -->
        <button
          id="chat-send-btn"
          type="submit"
          class="w-9 h-9 rounded-full bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white flex items-center justify-center shadow-md hover:scale-105 active:scale-95 transition-all cursor-pointer shrink-0"
          aria-label="Send message"
        >
          <Icon name="send" class="w-4 h-4 text-white" />
        </button>
      </form>
    </div>

    <!-- 6. FOOTER LINKS (Clean & Subtle) -->
    <footer class="w-full px-4 py-3 bg-[var(--bg-surface-elevated)] border-t border-[var(--border)] flex flex-wrap items-center justify-between gap-2 text-xs text-[var(--text-muted)] shrink-0">
      <div class="flex items-center gap-3 font-medium flex-wrap">
        <a href="/chat-rooms" class="hover:text-[var(--primary)] transition-colors">Rooms</a>
        <a href="/faq" class="hover:text-[var(--primary)] transition-colors">FAQ</a>
        <a href="/safety" class="hover:text-[var(--primary)] transition-colors">Safety</a>
        <a href="/terms" class="hover:text-[var(--primary)] transition-colors">Terms</a>
        <a href="/privacy" class="hover:text-[var(--primary)] transition-colors">Privacy</a>
      </div>

      <div class="text-[11px] text-[var(--text-muted)]">
        © 2026 {siteConfig.name} · Anonymous & Private
      </div>
    </footer>
  </div>
</div>

<!-- 7. SLIDE-OUT NAVIGATION DRAWER -->
<div id="mobile-nav-drawer" class="hidden fixed inset-0 z-50 flex">
  <!-- Backdrop -->
  <div id="drawer-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-xs transition-opacity"></div>

  <!-- Panel -->
  <div class="relative w-72 max-w-[80vw] bg-[var(--bg-surface)] h-full shadow-2xl z-10 flex flex-col justify-between p-5 overflow-y-auto">
    <div class="flex flex-col gap-5">
      <!-- Drawer Header -->
      <div class="flex items-center justify-between pb-4 border-b border-[var(--border)]">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center font-black text-sm">
            RC
          </div>
          <span class="font-black text-[var(--text-primary)] text-base tracking-tight">
            {siteConfig.name}
          </span>
        </div>
        <button id="drawer-close-btn" class="p-1.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] rounded-lg cursor-pointer">
          <Icon name="x" class="w-5 h-5" />
        </button>
      </div>

      <!-- Navigation Links -->
      <div class="flex flex-col gap-1.5 text-sm font-semibold">
        <a href="/chat" class="px-3 py-2.5 rounded-xl bg-[var(--primary)]/10 text-[var(--primary)] flex items-center gap-3">
          <Icon name="message-square" class="w-4 h-4" />
          <span>1 on 1 Chat</span>
        </a>
        <a href="/chat-rooms" class="px-3 py-2.5 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-3">
          <Icon name="users" class="w-4 h-4" />
          <span>Chat Rooms</span>
        </a>
        <a href="/random-voice-chat" class="px-3 py-2.5 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-3">
          <Icon name="mic" class="w-4 h-4" />
          <span>Voice Chat</span>
        </a>
        <a href="/random-chat" class="px-3 py-2.5 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-3">
          <Icon name="video" class="w-4 h-4" />
          <span>Video Chat</span>
        </a>
        <a href="/safety" class="px-3 py-2.5 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-hover)] flex items-center gap-3">
          <Icon name="shield-check" class="w-4 h-4" />
          <span>Safety & Rules</span>
        </a>
      </div>
    </div>

    <!-- Drawer Footer -->
    <div class="pt-4 border-t border-[var(--border)] flex flex-col gap-2 text-xs text-[var(--text-muted)]">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-[var(--text-primary)] font-medium">Over 4,800 Online</span>
      </div>
      <span>100% Anonymous & Free</span>
    </div>
  </div>
</div>

<!-- Image Lightbox Modal -->
<div id="chat-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md">
  <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-[var(--primary)] transition-colors p-2 cursor-pointer" aria-label="Close image preview">
    <Icon name="x" class="w-8 h-8" />
  </button>
  <img id="lightbox-img" src="" alt="Enlarged view" class="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
</div>
