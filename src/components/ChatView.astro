---
import { getTranslations } from '../i18n/translations';
import Icon from './icons/Icon.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<div id="chat-view" class="w-full flex-1 flex flex-col h-[calc(100dvh-4rem)] max-w-7xl mx-auto p-0 sm:p-2 lg:p-3">
  <!-- Top Responsive Sub-Header / Mobile Navigation Bar -->
  <div class="lg:hidden px-4 py-2 border-b border-[var(--border)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
    <button
      id="chat-toggle-left-pane-btn"
      type="button"
      class="text-xs font-semibold text-[var(--primary)] flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--primary)]/10 border border-[var(--primary)]/30 hover:bg-[var(--primary)]/20 transition-colors cursor-pointer"
    >
      <Icon name="users" class="w-4 h-4" />
      <span>Topic Rooms</span>
    </button>

    <div class="flex items-center gap-2">
      <button
        id="chat-toggle-right-pane-btn"
        type="button"
        class="text-xs font-semibold text-[var(--text-secondary)] flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-[var(--bg-surface-elevated)] border border-[var(--border)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      >
        <Icon name="shield-check" class="w-4 h-4" />
        <span>Safety & Info</span>
      </button>
    </div>
  </div>

  <!-- 3-Column Responsive Grid Layout -->
  <div class="flex-1 w-full grid grid-cols-1 lg:grid-cols-12 gap-3 min-h-0 overflow-hidden">
    
    <!-- LEFT SIDEBAR: Real Topic Rooms & Direct Channels (Desktop: 3 cols) -->
    <aside id="chat-left-sidebar" class="hidden lg:flex lg:col-span-3 flex-col bg-[var(--bg-surface)] border border-[var(--border)] lg:rounded-2xl overflow-hidden shadow-sm">
      <!-- Sidebar Header -->
      <div class="p-3.5 border-b border-[var(--border)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-[var(--success)] animate-pulse"></div>
          <span class="font-bold text-sm text-[var(--text-primary)]">Topic Rooms</span>
        </div>
        <a href="/chat-rooms" class="text-xs font-semibold text-[var(--primary)] hover:underline">
          View All &rarr;
        </a>
      </div>

      <!-- Live Topic Channels List -->
      <div class="flex-1 overflow-y-auto p-2.5 flex flex-col gap-1.5" id="chat-topic-channels-list">
        <a href="/chat-rooms/general" class="p-3 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:border-[var(--primary)]/60 hover:bg-[var(--bg-surface-hover)] flex items-center justify-between transition-all group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-[var(--primary)]/10 text-[var(--primary)] flex items-center justify-center font-bold text-xs shrink-0">
              <Icon name="message-square" class="w-4 h-4" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors">General Chat</span>
              <span class="text-[10px] text-[var(--text-muted)]">Casual & everyday talk</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--success)]/10 text-[var(--success)]">Open</span>
        </a>

        <a href="/chat-rooms/technology" class="p-3 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:border-[var(--primary)]/60 hover:bg-[var(--bg-surface-hover)] flex items-center justify-between transition-all group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-indigo-500/10 text-indigo-500 flex items-center justify-center font-bold text-xs shrink-0">
              <Icon name="zap" class="w-4 h-4" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors">Tech & Code</span>
              <span class="text-[10px] text-[var(--text-muted)]">AI, software, gadgets</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--success)]/10 text-[var(--success)]">Open</span>
        </a>

        <a href="/chat-rooms/gaming" class="p-3 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:border-[var(--primary)]/60 hover:bg-[var(--bg-surface-hover)] flex items-center justify-between transition-all group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold text-xs shrink-0">
              <Icon name="sparkles" class="w-4 h-4" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors">Gaming Lounge</span>
              <span class="text-[10px] text-[var(--text-muted)]">PC, console, esports</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--success)]/10 text-[var(--success)]">Open</span>
        </a>

        <a href="/chat-rooms/music" class="p-3 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:border-[var(--primary)]/60 hover:bg-[var(--bg-surface-hover)] flex items-center justify-between transition-all group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center font-bold text-xs shrink-0">
              <Icon name="heart" class="w-4 h-4" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors">Music & Beats</span>
              <span class="text-[10px] text-[var(--text-muted)]">Tracks, playlists, vinyl</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--success)]/10 text-[var(--success)]">Open</span>
        </a>

        <a href="/chat-rooms/movies" class="p-3 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:border-[var(--primary)]/60 hover:bg-[var(--bg-surface-hover)] flex items-center justify-between transition-all group">
          <div class="flex items-center gap-2.5 min-w-0">
            <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xs shrink-0">
              <Icon name="clock" class="w-4 h-4" />
            </div>
            <div class="flex flex-col min-w-0">
              <span class="text-xs font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors">Movies & Cinema</span>
              <span class="text-[10px] text-[var(--text-muted)]">Cinema, series, anime</span>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[var(--success)]/10 text-[var(--success)]">Open</span>
        </a>
      </div>

      <!-- Human Only Notice Footer -->
      <div class="p-3 border-t border-[var(--border)] bg-[var(--bg-surface-elevated)] flex items-center gap-2 text-[11px] text-[var(--text-muted)] shrink-0">
        <Icon name="shield-check" class="w-4 h-4 text-[var(--primary)] shrink-0" />
        <span>100% Real Humans &bull; 0 Fake Bots</span>
      </div>
    </aside>

    <!-- CENTER PANE: Active 1:1 Stranger Chat (Desktop: 6 cols, Mobile: Full) -->
    <main class="col-span-1 lg:col-span-6 flex flex-col bg-[var(--bg-surface)] border border-[var(--border)] lg:rounded-2xl shadow-sm overflow-hidden min-h-0 h-full">
      <!-- Chat Top Bar -->
      <div class="px-4 py-3 border-b border-[var(--border)] bg-[var(--bg-surface)] flex items-center justify-between shrink-0">
        <div class="flex items-center gap-3">
          <!-- Stranger Avatar -->
          <div class="relative w-10 h-10 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center font-bold text-sm shadow-xs">
            <span id="chat-stranger-avatar">S</span>
            <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-[var(--success)] ring-2 ring-[var(--bg-surface)]"></span>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span id="chat-stranger-nick" class="font-bold text-sm text-[var(--text-primary)] truncate max-w-[140px] sm:max-w-[200px]">
                Stranger
              </span>
              <span id="chat-stranger-gender" class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-[var(--primary)]/10 text-[var(--primary)] border border-[var(--primary)]/20 capitalize">
                Anyone
              </span>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <div class="flex items-center gap-1.5 text-[var(--success)] font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--success)] animate-pulse"></span>
                <span>Active 1-on-1</span>
              </div>
              <span class="text-[var(--text-muted)]">•</span>
              <span id="chat-stranger-country" class="text-[var(--text-secondary)]">Online</span>
            </div>
          </div>
        </div>

        <!-- Action Controls -->
        <div class="flex items-center gap-2">
          <!-- Voice Chat Button -->
          <button
            id="chat-voice-btn"
            type="button"
            class="btn-secondary text-xs py-2 px-3 shadow-xs flex items-center gap-1.5 hover:border-emerald-500/50"
            title="Start Ephemeral Voice Chat"
          >
            <Icon name="phone" class="w-3.5 h-3.5 text-emerald-500" />
            <span id="chat-voice-btn-label">Voice</span>
          </button>

          <!-- Next Stranger Button -->
          <button
            id="chat-next-btn"
            type="button"
            class="btn-primary text-xs py-2 px-3.5 shadow-xs"
          >
            <Icon name="refresh-cw" class="w-3.5 h-3.5" />
            <span>Next Stranger</span>
          </button>

          <!-- 3-Dot Dropdown Trigger -->
          <div class="relative">
            <button
              id="chat-menu-btn"
              type="button"
              class="w-9 h-9 flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
              aria-label="More Chat Options"
            >
              <Icon name="sliders" class="w-4 h-4" />
            </button>

            <!-- Dropdown Menu -->
            <div id="chat-dropdown" class="hidden absolute right-0 top-11 z-30 w-48 bg-[var(--bg-surface)] border border-[var(--border)] rounded-xl shadow-xl py-1.5 flex flex-col text-xs font-semibold">
              <button id="menu-clear-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-secondary)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <Icon name="refresh-cw" class="w-4 h-4" />
                Clear Chat
              </button>
              <div class="h-px bg-[var(--border)] my-1"></div>
              <button id="menu-report-btn" class="w-full px-4 py-2.5 text-left text-amber-500 hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <Icon name="flag" class="w-4 h-4" />
                Report User
              </button>
              <button id="menu-block-btn" class="w-full px-4 py-2.5 text-left text-rose-500 hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <Icon name="user-x" class="w-4 h-4" />
                Block User
              </button>
              <button id="menu-leave-btn" class="w-full px-4 py-2.5 text-left text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-2.5 transition-colors cursor-pointer">
                <Icon name="arrow-right" class="w-4 h-4" />
                Leave Chat
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Live WebRTC Voice Bar (VOICE-001) -->
      <div id="chat-voice-bar" class="hidden px-4 py-2.5 bg-emerald-500/10 border-b border-emerald-500/20 flex items-center justify-between gap-3 text-xs shrink-0 transition-all duration-300">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="flex items-center gap-1 h-5 px-1.5 py-0.5 rounded-md bg-emerald-500/15">
            <span class="w-1 bg-emerald-500 rounded-full voice-wave-bar"></span>
            <span class="w-1 bg-emerald-500 rounded-full voice-wave-bar"></span>
            <span class="w-1 bg-emerald-500 rounded-full voice-wave-bar"></span>
            <span class="w-1 bg-emerald-500 rounded-full voice-wave-bar"></span>
            <span class="w-1 bg-emerald-500 rounded-full voice-wave-bar"></span>
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center sm:gap-2 min-w-0">
            <span id="chat-voice-status" class="font-bold text-emerald-600 dark:text-emerald-400 truncate">Live Voice Connected</span>
            <span id="chat-voice-peer-state" class="text-[10px] text-[var(--text-muted)] truncate">(Microphone Active &bull; Ephemeral)</span>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="chat-voice-mute-btn"
            type="button"
            class="px-2.5 py-1 rounded-lg bg-[var(--bg-surface)] border border-[var(--border)] font-semibold text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] flex items-center gap-1 transition-colors cursor-pointer"
          >
            <Icon name="volume-2" class="w-3.5 h-3.5" />
            <span id="chat-voice-mute-label">Mute</span>
          </button>
          <button
            id="chat-voice-end-btn"
            type="button"
            class="px-2.5 py-1 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-semibold hover:bg-rose-500/20 flex items-center gap-1 transition-colors cursor-pointer"
          >
            <Icon name="phone-off" class="w-3.5 h-3.5" />
            <span>End</span>
          </button>
        </div>
      </div>

      <!-- Hidden Remote Audio Receiver -->
      <audio id="chat-remote-audio" autoplay playsinline class="hidden"></audio>

      <!-- Messages Scroll Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 flex flex-col gap-3.5 relative" role="log" aria-live="polite">
        <!-- Welcome Match Notice -->
        <div class="text-center py-3 px-4 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-xs text-[var(--text-secondary)] max-w-md mx-auto shadow-xs">
          <div class="flex items-center justify-center gap-2 mb-1">
            <Icon name="shield-check" class="w-4 h-4 text-[var(--primary)]" />
            <span class="font-bold text-[var(--text-primary)]">Connected in Private Room</span>
          </div>
          You are in an ephemeral 1-on-1 session. All messages are wiped when you disconnect.
        </div>
      </div>

      <!-- Typing Indicator -->
      <div id="chat-typing-indicator" class="hidden px-4 py-2 text-xs text-[var(--primary)] italic flex items-center gap-2 bg-[var(--bg-surface-elevated)] border-t border-[var(--border)] shrink-0">
        <div class="flex items-center gap-1 bg-[var(--bg-surface)] px-2.5 py-1 rounded-full border border-[var(--border)]">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce" style="animation-delay: 150ms;"></span>
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-bounce" style="animation-delay: 300ms;"></span>
        </div>
        <span>Stranger is typing...</span>
      </div>

      <!-- 2-Message Cold Gate Warning Banner -->
      <div id="cold-gate-banner" class="hidden px-4 py-2.5 bg-amber-500/10 border-t border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs font-semibold flex items-center justify-between shrink-0">
        <div class="flex items-center gap-2">
          <Icon name="lock" class="w-4 h-4 shrink-0" />
          <span>Cold-message limit reached. Waiting for stranger's reply before unlocking next message.</span>
        </div>
      </div>

      <!-- Attachment Preview Container -->
      <div id="chat-media-preview-container" class="hidden px-3 pt-2 pb-1 border-t border-[var(--border)] bg-[var(--bg-surface-elevated)] flex items-center gap-3 shrink-0">
        <div class="relative group">
          <img id="chat-image-preview" src="" alt="Attachment preview" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border)] shadow-xs" />
          <video id="chat-video-preview" src="" class="hidden w-16 h-16 object-cover rounded-xl border border-[var(--border)] shadow-xs" muted></video>
          <button
            id="chat-remove-media-btn"
            type="button"
            class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-rose-600 text-white rounded-full flex items-center justify-center text-xs shadow-xs hover:bg-rose-700 transition-colors cursor-pointer"
            aria-label="Remove attachment"
          >
            &times;
          </button>
        </div>
        <div class="flex flex-col text-xs text-[var(--text-secondary)]">
          <span id="chat-media-name" class="font-medium truncate max-w-[200px]">image.png</span>
          <span class="text-[10px] text-[var(--text-muted)]">Attached media</span>
        </div>
      </div>

      <!-- Chat Composer Area -->
      <div class="p-3 border-t border-[var(--border)] bg-[var(--bg-surface)] shrink-0">
        <form id="chat-composer-form" class="flex items-center gap-2">
          <!-- Hidden File Input -->
          <input
            id="chat-file-input"
            type="file"
            accept="image/*,video/*"
            class="hidden"
          />

          <!-- Gallery Attachment Button -->
          <button
            id="chat-attach-btn"
            type="button"
            class="w-10 h-10 flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors shrink-0 cursor-pointer"
            aria-label="Attach Photo or Video"
            title="Attach Photo or Video"
          >
            <Icon name="image" class="w-5 h-5" />
          </button>

          <!-- Message Text Input -->
          <input
            id="chat-input"
            type="text"
            placeholder="Type a message..."
            maxlength="1000"
            autocomplete="off"
            class="flex-1 px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] focus:border-transparent transition-all text-sm"
            aria-label="Type your message"
          />

          <!-- Send Message Button -->
          <button
            id="chat-send-btn"
            type="submit"
            class="btn-primary p-2.5 rounded-xl shadow-xs disabled:opacity-40 disabled:cursor-not-allowed shrink-0"
            aria-label="Send message"
          >
            <Icon name="send" class="w-4 h-4" />
          </button>
        </form>

        <!-- Bottom Action Bar: Report, Block, Next -->
        <div class="mt-2 pt-2 border-t border-[var(--border)] flex items-center justify-between text-xs text-[var(--text-muted)]">
          <div class="flex items-center gap-3">
            <button id="bottom-report-btn" type="button" class="hover:text-amber-500 flex items-center gap-1 transition-colors cursor-pointer">
              <Icon name="flag" class="w-3.5 h-3.5" />
              <span>Report</span>
            </button>
            <button id="bottom-block-btn" type="button" class="hover:text-rose-500 flex items-center gap-1 transition-colors cursor-pointer">
              <Icon name="user-x" class="w-3.5 h-3.5" />
              <span>Block</span>
            </button>
          </div>
          <div class="flex items-center gap-1 text-[11px]">
            <span>Press</span>
            <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-surface-elevated)] border border-[var(--border)] font-mono text-[10px]">Enter</kbd>
            <span>to send</span>
          </div>
        </div>
      </div>
    </main>

    <!-- RIGHT SIDEBAR: Stranger Info & Safety Guidelines (Desktop: 3 cols) -->
    <aside id="chat-right-sidebar" class="hidden lg:flex lg:col-span-3 flex-col gap-3 overflow-y-auto">
      <!-- Session Info Card -->
      <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-surface)] flex flex-col gap-3.5 shadow-sm text-left">
        <div class="flex items-center gap-2 border-b border-[var(--border)] pb-2.5">
          <Icon name="shield-check" class="w-4 h-4 text-[var(--primary)]" />
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">Session Security</span>
        </div>

        <div class="flex flex-col gap-2 text-xs text-[var(--text-secondary)]">
          <div class="flex items-center justify-between">
            <span>Storage Policy:</span>
            <span class="font-bold text-[var(--success)]">0 Logs Saved</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Encryption:</span>
            <span class="font-bold text-[var(--text-primary)]">WSS Encrypted</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Moderation:</span>
            <span class="font-bold text-[var(--text-primary)]">Real-Time</span>
          </div>
        </div>
      </div>

      <!-- Safety & Trust Card -->
      <div class="p-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-surface)] flex flex-col gap-3 shadow-sm text-left">
        <div class="flex items-center gap-2">
          <Icon name="lock" class="w-4 h-4 text-amber-500" />
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-primary)]">Safety Guidelines</span>
        </div>

        <ul class="flex flex-col gap-2 text-xs text-[var(--text-secondary)]">
          <li class="flex items-start gap-2">
            <span class="text-[var(--primary)] font-bold">&bull;</span>
            <span>Never share personal passwords, phone numbers, or credit card details.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--primary)] font-bold">&bull;</span>
            <span>Treat everyone with respect. Harassment leads to an instant ban.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--primary)] font-bold">&bull;</span>
            <span>Use the Block or Report button if someone acts inappropriately.</span>
          </li>
        </ul>

        <div class="pt-2 border-t border-[var(--border)] flex items-center justify-between">
          <span class="text-[11px] text-[var(--text-muted)]">Read full policy:</span>
          <a href="/safety" class="text-xs font-bold text-[var(--primary)] hover:underline">
            Safety Guide &rarr;
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Image Lightbox Modal -->
<div id="chat-lightbox" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/90 backdrop-blur-md">
  <button id="lightbox-close" class="absolute top-4 right-4 text-white hover:text-rose-400 transition-colors p-2 cursor-pointer" aria-label="Close image preview">
    <Icon name="x" class="w-8 h-8" />
  </button>
  <img id="lightbox-img" src="" alt="Enlarged view" class="max-w-full max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
</div>
