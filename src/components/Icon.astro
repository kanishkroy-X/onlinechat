---
export type IconName =
  | 'chat'
  | 'send'
  | 'next'
  | 'leave'
  | 'report'
  | 'block'
  | 'menu'
  | 'close'
  | 'shield'
  | 'lock'
  | 'eye-off'
  | 'clock'
  | 'user'
  | 'check'
  | 'sun'
  | 'moon'
  | 'image'
  | 'warning'
  | 'mail'
  | 'arrow'
  | 'search'
  | 'file';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

const icons: Record<IconName, string> = {
