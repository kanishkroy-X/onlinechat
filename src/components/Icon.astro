  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4.2L15 16"/>',
  user: '<circle cx="12" cy="8" r="3"/><path d="M6.5 19a5.5 5.5 0 0 1 11 0"/>',
  check: '<path d="m5 12 5 5 9-10"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 3v1.6M12 19.4V21M4.9 4.9l1.1 1.1M18 18l1.1 1.1M3 12h1.6M19.4 12H21M4.9 19.1 6 18M18 6l1.1-1.1"/>',
  moon: '<path d="M16.5 13.5A6.5 6.5 0 1 1 10.5 5 5 5 0 0 0 16.5 13.5Z"/>',
  image: '<rect x="4" y="5" width="16" height="14" rx="1.5"/><circle cx="9" cy="10" r="1.3"/><path d="m5.5 17 4.2-4.2 2.6 2.6L16 12l3.5 5"/>',
  warning: '<path d="M12 4.5 20.5 19h-17L12 4.5Z"/><path d="M12 10v4"/><path d="M12 16.5h.01"/>',
  mail: '<rect x="4" y="6" width="16" height="12" rx="1.5"/><path d="m5 8 7 5 7-5"/>',
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
