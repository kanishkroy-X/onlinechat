  report: '<path d="M5 20V6.5S6.5 5 9 5s4 2 7 2 3-1 3-1V15s-1 1.5-3 1.5-4-2-7-2-4 1.5-4 1.5"/><path d="M5 20v-2"/>',
  block: '<circle cx="12" cy="12" r="8"/><path d="m7.2 7.2 9.6 9.6"/>',
  menu: '<circle cx="12" cy="6" r="1.1"/><circle cx="12" cy="12" r="1.1"/><circle cx="12" cy="18" r="1.1"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
