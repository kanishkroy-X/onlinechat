---
interface Props {
  activeTab?: string;
}

const { activeTab = 'online' } = Astro.props;
---

<header class="w-full h-16 border-b border-[var(--border)] bg-[var(--bg-surface)]/95 backdrop-blur-md sticky top-0 z-50 px-4 flex items-center justify-between transition-colors shadow-xs">
  <!-- Left: Brand Logo & Wordmark -->
  <div class="flex items-center gap-4">
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-[#6C4DFF] rounded-lg p-1" aria-label="RandomChat Home">
      <!-- Chat Bubble Icon -->
      <div class="w-8 h-8 rounded-lg bg-[#6C4DFF] flex items-center justify-center shadow-sm text-white group-hover:bg-[#7B61FF] transition-colors">
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
        </svg>
      </div>
      
      <!-- Wordmark: "Random" in primary text, "Chat" in brand purple -->
      <div class="flex items-baseline font-bold text-xl tracking-tight">
        <span class="text-[var(--text-primary)]">Random</span>
        <span class="text-[#6C4DFF]">Chat</span>
      </div>
    </a>
  </div>

  <!-- Center: Desktop Navigation Bar -->
  <nav class="hidden md:flex items-center gap-1.5 bg-[var(--bg-surface-elevated)] p-1 rounded-xl border border-[var(--border)]" aria-label="Primary Navigation">
    <button
      type="button"
      id="nav-btn-online"
      class="nav-tab-btn flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[var(--text-primary)] bg-[var(--bg-surface)] border border-[var(--border)] shadow-xs"
      data-tab="online"
    >
      <span class="w-2 h-2 rounded-full bg-[#18D889] animate-online-dot"></span>
      <span>Online</span>
    </button>

    <button
      type="button"
      id="nav-btn-rooms"
      class="nav-tab-btn flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)]/60"
      data-tab="rooms"
    >
      <svg class="w-4 h-4 text-[var(--text-secondary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <span>Rooms</span>
    </button>

    <button
      type="button"
      id="nav-btn-inbox"
      class="nav-tab-btn relative flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface)]/60"
      data-tab="inbox"
    >
      <svg class="w-4 h-4 text-[var(--text-secondary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
      <span>Inbox</span>
      <span id="nav-inbox-badge" class="px-1.5 py-0.2 bg-[#6C4DFF] text-white text-[11px] font-bold rounded-full">2</span>
    </button>

    <button
      type="button"
      id="nav-btn-random-voice"
      class="nav-tab-btn flex items-center gap-2 px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all cursor-pointer text-[var(--text-secondary)] hover:text-[#6C4DFF] hover:bg-[#6C4DFF]/10"
      data-tab="random-voice"
    >
      <svg class="w-4 h-4 text-[#6C4DFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
        <line x1="12" y1="19" x2="12" y2="23"></line>
        <line x1="8" y1="23" x2="16" y2="23"></line>
      </svg>
      <span class="text-[#6C4DFF] font-semibold">Random Voice</span>
    </button>
  </nav>

  <!-- Right: Theme Switcher, Profile Pill & Settings Action -->
  <div class="flex items-center gap-2 sm:gap-2.5">
    <!-- Light/Dark Mode Switcher Toggle Button -->
    <button
      type="button"
      id="theme-toggle-btn"
      class="w-9 h-9 flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      title="Toggle Light / Dark Mode"
      aria-label="Toggle Theme"
    >
      <!-- Sun Icon (Shown in Dark Mode) -->
      <svg id="theme-sun-icon" class="w-4.5 h-4.5 hidden dark:block text-[#F5B83D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <!-- Moon Icon (Shown in Light Mode) -->
      <svg id="theme-moon-icon" class="w-4.5 h-4.5 block dark:hidden text-[#6C4DFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <!-- User Profile Pill -->
    <button
      type="button"
      id="header-profile-btn"
      class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] transition-colors cursor-pointer text-left shadow-xs"
      title="View/Edit Profile"
    >
      <div class="relative w-6 h-6 rounded-full overflow-hidden bg-[var(--border)]">
        <img
          id="header-user-avatar"
          src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80"
          alt="My Avatar"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="hidden sm:flex flex-col">
        <span id="header-user-nickname" class="text-xs font-semibold text-[var(--text-primary)] leading-tight">Guest User</span>
        <span id="header-user-loc" class="text-[10px] text-[var(--text-muted)] leading-none">Online</span>
      </div>
    </button>

    <!-- Settings Button -->
    <button
      type="button"
      id="header-settings-btn"
      class="w-9 h-9 flex items-center justify-center rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors cursor-pointer shadow-xs"
      title="Settings"
      aria-label="Settings"
    >
      <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
    </button>
  </div>
</header>
