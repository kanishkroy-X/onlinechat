---
import { ALL_COUNTRIES } from '../data/countries';
import CountryFlag from './CountryFlag.astro';

interface Props {
  id?: string;
  name?: string;
  value?: string;
  allowAll?: boolean;
  label?: string;
  class?: string;
}

const {
  id = 'country-selector',
  name = 'country',
  value = 'all',
  allowAll = false,
  label = 'Country',
  class: className = ''
} = Astro.props;

const selectedCode = value.toUpperCase();
const initialSelectedCountry = ALL_COUNTRIES.find(c => c.code === selectedCode);
const initialLabel = allowAll && (selectedCode === 'ALL' || selectedCode === 'ANYWHERE' || !selectedCode)
  ? 'All Countries'
  : (initialSelectedCountry ? initialSelectedCountry.name : 'Select Country');
const initialFlagCode = (initialSelectedCountry && selectedCode !== 'ALL' && selectedCode !== 'ANYWHERE')
  ? initialSelectedCountry.code
  : '';
---

<div class={`country-selector-widget relative ${className}`} id={`${id}-wrapper`} data-allow-all={allowAll ? 'true' : 'false'}>
  {label && (
    <label for={`${id}-trigger`} class="block text-xs sm:text-sm font-semibold text-[var(--text-primary)] mb-1.5">
      {label}
    </label>
  )}

  <!-- Trigger Button -->
  <button
    type="button"
    id={`${id}-trigger`}
    class="country-selector-trigger w-full px-3.5 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-primary)] flex items-center justify-between gap-2 text-sm transition-all focus:outline-none focus:ring-2 focus:ring-[var(--primary)] shadow-xs cursor-pointer"
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span class="inline-flex items-center gap-2.5 min-w-0">
      <span class="country-trigger-flag">
        <CountryFlag code={initialFlagCode} size="md" />
      </span>
      <span class="country-trigger-text truncate font-medium">{initialLabel}</span>
    </span>
    <svg class="w-4 h-4 text-[var(--text-secondary)] shrink-0 transition-transform country-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <!-- Hidden form input -->
  <input
    type="hidden"
    id={`${id}-input`}
    name={name}
    value={selectedCode.toLowerCase()}
  />

  <!-- Dropdown Panel / Dialog -->
  <div
    id={`${id}-dropdown`}
    class="country-dropdown-panel hidden absolute left-0 right-0 top-full mt-1.5 z-50 rounded-2xl border border-[var(--border)] bg-[var(--bg-surface)] shadow-2xl overflow-hidden flex-col max-h-72 transition-all"
    role="listbox"
  >
    <!-- Search Field -->
    <div class="p-2.5 border-b border-[var(--border)] bg-[var(--bg-surface-elevated)] sticky top-0 z-10">
      <div class="relative w-full">
        <input
          type="text"
          class="country-search-input w-full px-3 py-1.5 pl-8 rounded-lg bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-xs focus:outline-none focus:ring-1 focus:ring-[var(--primary)]"
          placeholder="Search country..."
          autocomplete="off"
        />
        <svg class="w-3.5 h-3.5 text-[var(--text-muted)] absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </div>

    <!-- Country Options List -->
    <div class="country-options-list overflow-y-auto flex-1 p-1 divide-y divide-[var(--border)]/20">
      {allowAll && (
        <button
          type="button"
          class="country-option w-full px-3 py-2 text-left text-xs font-semibold text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] rounded-lg flex items-center gap-2.5 transition-colors cursor-pointer"
          data-code="all"
          data-name="All Countries"
        >
          <span class="w-5 h-3.5 rounded-[2px] bg-black/10 flex items-center justify-center text-[11px]">🌐</span>
          <span>All Countries</span>
        </button>
      )}

      {ALL_COUNTRIES.map((country) => (
        <button
          type="button"
          class="country-option w-full px-3 py-2 text-left text-xs text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)] rounded-lg flex items-center gap-2.5 transition-colors cursor-pointer"
          data-code={country.code.toLowerCase()}
          data-name={country.name}
        >
          <CountryFlag code={country.code} size="sm" />
          <span class="truncate">{country.name}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<script>
  function initCountrySelectors() {
    document.querySelectorAll<HTMLElement>('.country-selector-widget').forEach((widget) => {
      if ((widget as any)._initialized) return;
      (widget as any)._initialized = true;

      const trigger = widget.querySelector('.country-selector-trigger') as HTMLButtonElement;
      const chevron = widget.querySelector('.country-chevron') as HTMLElement;
      const dropdown = widget.querySelector('.country-dropdown-panel') as HTMLElement;
      const searchInput = widget.querySelector('.country-search-input') as HTMLInputElement;
      const hiddenInput = widget.querySelector('input[type="hidden"]') as HTMLInputElement;
      const triggerText = widget.querySelector('.country-trigger-text') as HTMLElement;
      const triggerFlag = widget.querySelector('.country-trigger-flag') as HTMLElement;
      const options = widget.querySelectorAll('.country-option') as NodeListOf<HTMLButtonElement>;

      function toggle(open?: boolean) {
        const isCurrentlyOpen = !dropdown.classList.contains('hidden');
        const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

        if (shouldOpen) {
          dropdown.classList.remove('hidden');
          dropdown.classList.add('flex');
          trigger.setAttribute('aria-expanded', 'true');
          chevron?.classList.add('rotate-180');
          searchInput.value = '';
          filterOptions('');
          setTimeout(() => searchInput.focus(), 50);
        } else {
          dropdown.classList.add('hidden');
          dropdown.classList.remove('flex');
          trigger.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('rotate-180');
        }
      }

      function filterOptions(query: string) {
        const q = query.toLowerCase().trim();
        options.forEach((opt) => {
          const name = (opt.dataset.name || '').toLowerCase();
          const code = (opt.dataset.code || '').toLowerCase();
          if (!q || name.includes(q) || code.includes(q)) {
            opt.style.display = 'flex';
          } else {
            opt.style.display = 'none';
          }
        });
      }

      trigger?.addEventListener('click', (e) => {
        e.stopPropagation();
        toggle();
      });

      searchInput?.addEventListener('input', () => {
        filterOptions(searchInput.value);
      });

      options.forEach((opt) => {
        opt.addEventListener('click', (e) => {
          e.stopPropagation();
          const code = opt.dataset.code || 'all';
          const name = opt.dataset.name || 'All Countries';

          hiddenInput.value = code;
          if (triggerText) triggerText.textContent = name;

          if (triggerFlag) {
            if (code === 'all' || code === 'anywhere') {
              triggerFlag.innerHTML = `<span class="inline-flex items-center shrink-0 w-5 h-3.5 rounded-[2px] bg-black/10 justify-center text-[10px]">🌐</span>`;
            } else {
              triggerFlag.innerHTML = `<span class="inline-flex items-center shrink-0 overflow-hidden shadow-xs border border-white/10 w-5 h-3.5 rounded-[2px] bg-black/10"><img src="/flags/${code.toLowerCase()}.svg" alt="${name} flag" class="w-full h-full object-cover" width="24" height="16" /></span>`;
            }
          }

          // Trigger change event on hidden input so parent listeners can react
          hiddenInput.dispatchEvent(new Event('change', { bubbles: true }));
          toggle(false);
          trigger.focus();
        });
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!widget.contains(e.target as Node)) {
          toggle(false);
        }
      });

      // Close on Escape key
      widget.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          toggle(false);
          trigger.focus();
        }
      });
    });
  }

  // Initialize on page load and view transitions
  initCountrySelectors();
  document.addEventListener('astro:page-load', initCountrySelectors);
</script>
