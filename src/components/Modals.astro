---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<!-- Next Stranger Confirmation Modal -->
<div id="modal-next" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-6 shadow-2xl flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-[#FF808A]/10 text-[#D55882] flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><polyline points="13 17 18 12 13 7"/><polyline points="6 17 11 12 6 7"/></svg>
      </div>
      <h3 class="text-lg font-bold text-[var(--text-main)]">
        {t.modals.nextTitle}
      </h3>
    </div>
    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
      {t.modals.nextDesc}
    </p>
    <div class="flex items-center justify-end gap-3 mt-2">
      <button id="modal-next-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer">
        {t.modals.stay}
      </button>
      <button id="modal-next-confirm" type="button" class="gradient-accent gradient-accent-hover text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-sm transition-all cursor-pointer">
        {t.modals.confirmNext}
      </button>
    </div>
  </div>
</div>

<!-- Leave Chat Confirmation Modal -->
<div id="modal-leave" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-6 shadow-2xl flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      </div>
      <h3 class="text-lg font-bold text-[var(--text-main)]">
        {t.modals.leaveTitle}
      </h3>
    </div>
    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
      {t.modals.leaveDesc}
    </p>
    <div class="flex items-center justify-end gap-3 mt-2">
      <button id="modal-leave-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer">
        {t.modals.stay}
      </button>
      <button id="modal-leave-confirm" type="button" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-sm transition-all cursor-pointer">
        {t.modals.confirmLeave}
      </button>
    </div>
  </div>
</div>

<!-- Report Modal -->
<div id="modal-report" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
  <div class="w-full max-w-md bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-6 sm:p-8 shadow-2xl flex flex-col gap-5">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/></svg>
        </div>
        <h3 class="text-lg font-bold text-[var(--text-main)]">
          {t.modals.reportTitle}
        </h3>
      </div>
      <button id="modal-report-close" type="button" class="w-8 h-8 rounded-full flex items-center justify-center text-[var(--text-subtle)] hover:text-[var(--text-main)] cursor-pointer">
        &times;
      </button>
    </div>

    <form id="report-form" class="flex flex-col gap-4">
      <div class="flex flex-col gap-1.5">
        <label for="report-reason-select" class="text-xs font-semibold text-[var(--text-main)]">
          {t.modals.reportReasonLabel}
        </label>
        <select id="report-reason-select" class="w-full px-3.5 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-page)] text-xs text-[var(--text-main)] focus:outline-none focus:ring-2 focus:ring-[#D55882] cursor-pointer">
          <option value="harassment">{t.modals.reasons.harassment}</option>
          <option value="spam">{t.modals.reasons.spam}</option>
          <option value="sexual_inappropriate">{t.modals.reasons.sexual_inappropriate}</option>
          <option value="threats">{t.modals.reasons.threats}</option>
          <option value="hate_abuse">{t.modals.reasons.hate_abuse}</option>
          <option value="scam_fraud">{t.modals.reasons.scam_fraud}</option>
          <option value="other">{t.modals.reasons.other}</option>
        </select>
      </div>

      <div class="flex flex-col gap-1.5">
        <label for="report-details-input" class="text-xs font-semibold text-[var(--text-main)]">
          {t.modals.reportDetailsLabel}
        </label>
        <textarea id="report-details-input" rows="3" placeholder={t.modals.reportDetailsPlaceholder} class="w-full px-3.5 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-page)] text-xs text-[var(--text-main)] placeholder:text-[var(--text-subtle)] focus:outline-none focus:ring-2 focus:ring-[#D55882] resize-none"></textarea>
      </div>

      <div class="flex items-center justify-end gap-3 mt-2">
        <button id="modal-report-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer">
          {t.modals.cancel}
        </button>
        <button type="submit" class="gradient-accent gradient-accent-hover text-white text-xs font-semibold px-5 py-2.5 rounded-xl shadow-sm cursor-pointer">
          {t.modals.submitReport}
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Block Modal -->
<div id="modal-block" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-6 shadow-2xl flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
      </div>
      <h3 class="text-lg font-bold text-[var(--text-main)]">
        {t.modals.blockTitle}
      </h3>
    </div>
    <p class="text-xs text-[var(--text-muted)] leading-relaxed">
      {t.modals.blockDesc}
    </p>
    <div class="flex items-center justify-end gap-3 mt-2">
      <button id="modal-block-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)] transition-colors cursor-pointer">
        {t.modals.cancel}
      </button>
      <button id="modal-block-confirm" type="button" class="bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-4 py-2 rounded-xl shadow-sm transition-all cursor-pointer">
        {t.modals.confirmBlock}
      </button>
    </div>
  </div>
</div>
