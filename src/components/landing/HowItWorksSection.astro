---
import Icon from '../icons/Icon.astro';
---

<section id="how-it-works" class="w-full py-16 sm:py-24 px-4 bg-white/70 dark:bg-black/20 border-t border-pink-100/60 dark:border-pink-950/30">
  <div class="max-w-5xl mx-auto flex flex-col items-center gap-12">
    <!-- Section Header (Screenshots 1 & 2: How Yapping Works) -->
    <div class="text-center max-w-2xl flex flex-col items-center gap-3">
      <h2 class="text-3xl sm:text-5xl font-black text-[var(--text-primary)] tracking-tight">
        How Yapping Works
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed">
        Start talking to strangers online in three quick steps. No registration, no waiting.
      </p>
    </div>

    <!-- 3 Step Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
      <!-- Step 01 -->
      <div class="card-tactile p-6 sm:p-7 flex flex-col gap-5 text-left relative overflow-hidden group bg-white dark:bg-[#161922] border-pink-100 dark:border-pink-900/30 hover:border-pink-300 dark:hover:border-pink-700/50 transition-all shadow-sm">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-pink-500/10 text-pink-600 flex items-center justify-center font-bold shadow-xs">
            <Icon name="message-square" class="w-6 h-6" />
          </div>
          <span class="text-3xl font-black text-pink-200 dark:text-pink-900/40">01</span>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">
            Choose Your Mode
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Pick between instant text, high-definition video, or crystal-clear voice chat. No account needed.
          </p>
        </div>
        <div class="mt-auto pt-4 border-t border-pink-100/80 dark:border-pink-900/30 text-xs text-[var(--text-muted)] flex items-center gap-1.5 font-medium">
          <Icon name="check" class="w-4 h-4 text-emerald-500 shrink-0" />
          <span>Zero email required</span>
        </div>
      </div>

      <!-- Step 02 -->
      <div class="card-tactile p-6 sm:p-7 flex flex-col gap-5 text-left relative overflow-hidden group bg-white dark:bg-[#161922] border-pink-100 dark:border-pink-900/30 hover:border-pink-300 dark:hover:border-pink-700/50 transition-all shadow-sm">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-pink-500/10 text-pink-600 flex items-center justify-center font-bold shadow-xs">
            <Icon name="zap" class="w-6 h-6" />
          </div>
          <span class="text-3xl font-black text-pink-200 dark:text-pink-900/40">02</span>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">
            Instant 1-on-1 Matching
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Connect with a real person anywhere in the world in under 2 seconds. Completely randomized and private.
          </p>
        </div>
        <div class="mt-auto pt-4 border-t border-pink-100/80 dark:border-pink-900/30 text-xs text-[var(--text-muted)] flex items-center gap-1.5 font-medium">
          <Icon name="check" class="w-4 h-4 text-emerald-500 shrink-0" />
          <span>Sub-second pairing</span>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="card-tactile p-6 sm:p-7 flex flex-col gap-5 text-left relative overflow-hidden group bg-white dark:bg-[#161922] border-pink-100 dark:border-pink-900/30 hover:border-pink-300 dark:hover:border-pink-700/50 transition-all shadow-sm">
        <div class="flex items-center justify-between">
          <div class="w-12 h-12 rounded-2xl bg-pink-500/10 text-pink-600 flex items-center justify-center font-bold shadow-xs">
            <Icon name="shield-check" class="w-6 h-6" />
          </div>
          <span class="text-3xl font-black text-pink-200 dark:text-pink-900/40">03</span>
        </div>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-[var(--text-primary)]">
            Chat & Move On Anytime
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Vibe together or tap next to find someone new. When you leave, the chat is wiped instantly from RAM.
          </p>
        </div>
        <div class="mt-auto pt-4 border-t border-pink-100/80 dark:border-pink-900/30 text-xs text-[var(--text-muted)] flex items-center gap-1.5 font-medium">
          <Icon name="check" class="w-4 h-4 text-emerald-500 shrink-0" />
          <span>100% ephemeral & secure</span>
        </div>
      </div>
    </div>
  </div>
</section>
