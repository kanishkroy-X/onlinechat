---
import Icon from '../icons/Icon.astro';
import Logo from '../Logo.astro';
import LanguagePicker from '../LanguagePicker.astro';
import { siteConfig } from '../../config/site';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const t = useTranslations(currentLang);
---

<header class="w-full sticky top-0 z-50 transition-colors">
  <div class="w-full h-16 border-b border-[var(--border)] bg-[var(--bg-surface)]/95 backdrop-blur-md px-4">
    <div class="max-w-6xl mx-auto h-full flex items-center justify-between gap-3">
      <!-- Left: Mobile Menu Trigger + Brand Logo -->
      <div class="flex items-center gap-2.5">
        <!-- Mobile Hamburger Toggle (44px touch area) -->
        <button
          id="landing-mobile-menu-toggle"
          type="button"
          class="md:hidden btn btn-secondary btn-icon text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="landing-mobile-drawer"
        >
          <span id="menu-icon-open">
            <Icon name="menu" class="w-5 h-5" />
          </span>
          <span id="menu-icon-close" class="hidden">
            <Icon name="x" class="w-5 h-5" />
          </span>
        </button>

        <!-- Brand Logo -->
        <a href={translatePath('/')} class="flex items-center gap-2.5 group focus:outline-none focus:ring-2 focus:ring-[#E11D48] rounded-lg p-1" aria-label="RandomChat Home">
          <Logo class="w-8 h-8" withText={true} />
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[var(--text-secondary)]" aria-label="Desktop Navigation">
        <a href={translatePath('/chat-rooms')} class="hover:text-[var(--text-primary)] transition-colors">Topic Rooms</a>
        <a href={translatePath('/random-voice-chat')} class="hover:text-[var(--text-primary)] transition-colors">Voice Chat</a>
        <a href={translatePath('/safety')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.safety}</a>
        <a href="#faq" class="hover:text-[var(--text-primary)] transition-colors">{t.nav.faq}</a>
      </nav>

      <!-- Right Controls: Language Picker, Theme Toggle & Primary CTA -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <!-- Language Selector -->
        <LanguagePicker variant="header" />

        <!-- Theme Switcher -->
        <button
          type="button"
          id="landing-theme-toggle"
          class="btn btn-secondary btn-icon text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
          title="Toggle Theme"
          aria-label="Toggle Theme"
        >
          <span class="hidden dark:block text-amber-400">
            <Icon name="sun" class="w-4.5 h-4.5" />
          </span>
          <span class="block dark:hidden text-[var(--primary)]">
            <Icon name="moon" class="w-4.5 h-4.5" />
          </span>
        </button>

        <!-- Primary CTA -->
        <a
          id="nav-start-chat-btn"
          href={translatePath('/start')}
          class="btn btn-primary text-xs sm:text-sm py-2 px-3.5 sm:px-4 min-h-[40px] flex items-center gap-1.5"
        >
          <span class="hidden sm:inline">{t.nav.startChat}</span>
          <span class="sm:hidden">Chat</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Slide-out Drawer Menu with High Z-Index -->
  <div
    id="landing-mobile-drawer"
    class="hidden md:hidden fixed inset-x-0 top-16 bg-[var(--bg-surface)] border-b border-[var(--border)] p-5 pb-[max(1.25rem,env(safe-area-inset-bottom,0px))] shadow-2xl z-[9999] flex flex-col gap-4 animate-drawer-in"
    aria-label="Mobile Navigation"
  >
    <nav class="flex flex-col gap-1 text-sm font-semibold text-[var(--text-primary)]">
      <a id="mobile-nav-start-link" href={translatePath('/start')} class="mobile-nav-link flex items-center justify-between p-3 rounded-xl hover:bg-[var(--bg-surface-elevated)] text-[var(--primary)] font-bold transition-colors">
        <span>1-on-1 Text Chat</span>
        <Icon name="chevron-right" class="w-4 h-4 text-[var(--primary)]" />
      </a>
      <a href={translatePath('/chat-rooms')} class="mobile-nav-link flex items-center justify-between p-3 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors">
        <span>Topic Rooms</span>
        <Icon name="chevron-right" class="w-4 h-4 text-[var(--text-muted)]" />
      </a>
      <a href={translatePath('/random-voice-chat')} class="mobile-nav-link flex items-center justify-between p-3 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors">
        <span>Voice Chat</span>
        <Icon name="chevron-right" class="w-4 h-4 text-[var(--text-muted)]" />
      </a>
      <a href={translatePath('/safety')} class="mobile-nav-link flex items-center justify-between p-3 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors">
        <span>{t.nav.safety}</span>
        <Icon name="chevron-right" class="w-4 h-4 text-[var(--text-muted)]" />
      </a>
      <a href="#faq" class="mobile-nav-link flex items-center justify-between p-3 rounded-xl hover:bg-[var(--bg-surface-elevated)] transition-colors">
        <span>{t.nav.faq}</span>
        <Icon name="chevron-right" class="w-4 h-4 text-[var(--text-muted)]" />
      </a>
    </nav>

    <div class="pt-3 border-t border-[var(--border)] flex flex-col gap-2.5">
      <a id="mobile-nav-start-chat-btn" href={translatePath('/start')} class="btn btn-primary text-sm py-3 text-center w-full cursor-pointer flex items-center justify-center gap-2">
        <span>{t.hero.cta}</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
      <div class="text-[11px] text-[var(--text-muted)] text-center">
        18+ Adults Only &bull; 0 Logs Saved
      </div>
    </div>
  </div>
</header>

<script>
  import { getStoredTheme, applyTheme } from '../../scripts/theme';

  const themeBtn = document.getElementById('landing-theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const current = getStoredTheme();
    const next = current === 'dark' ? 'light' : current === 'light' ? 'system' : 'dark';
    applyTheme(next);
  });

  const mobileToggle = document.getElementById('landing-mobile-menu-toggle');
  const mobileDrawer = document.getElementById('landing-mobile-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  mobileToggle?.addEventListener('click', () => {
    const isHidden = mobileDrawer?.classList.toggle('hidden');
    mobileToggle.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
    iconOpen?.classList.toggle('hidden', !isHidden);
    iconClose?.classList.toggle('hidden', !!isHidden);
  });

  const closeMobileMenu = () => {
    mobileDrawer?.classList.add('hidden');
    mobileToggle?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  };

  navLinks.forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
      closeMobileMenu();
      (mobileToggle as HTMLElement | null)?.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (mobileDrawer && !mobileDrawer.classList.contains('hidden')) {
      if (!mobileDrawer.contains(e.target as Node) && !mobileToggle?.contains(e.target as Node)) {
        closeMobileMenu();
      }
    }
  });
</script>
