---
import Icon from '../icons/Icon.astro';
---

<section class="w-full py-16 sm:py-24 px-4 bg-[var(--bg-surface)] border-y border-[var(--border)]">
  <div class="max-w-5xl mx-auto flex flex-col items-center gap-16">
    <!-- Section Header -->
    <div class="text-center max-w-2xl flex flex-col items-center gap-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>Apple-Inspired Communication Experience</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        Engineered for pure human connection
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
        We stripped away feeds, followers, algorithms, and ad tracking to build a calm, respectful platform for real conversation.
      </p>
    </div>

    <!-- 2-Column Showcase of Voice Waveform & Profile Transitions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
      <!-- Showcase 1: Ephemeral WebRTC Voice Waveform (Reference 4: voice_chat_connection.webp) -->
      <div class="p-2 rounded-[2.5rem] bg-black/5 dark:bg-white/5 border border-[var(--border)] shadow-md flex flex-col">
        <div class="h-full p-6 sm:p-8 rounded-[calc(2.5rem-0.5rem)] bg-[var(--bg-surface-elevated)] flex flex-col gap-6">
          <div class="relative w-full rounded-2xl overflow-hidden aspect-[16/10] bg-[var(--bg-surface)] border border-[var(--border)]">
            <img
              src="/assets/voice_chat_connection.webp"
              alt="Voice Waveform Connection"
              class="w-full h-full object-cover opacity-90 transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
            <div class="absolute bottom-3 left-3 px-3 py-1 rounded-full bg-[var(--bg-surface)]/90 border border-[var(--border)] text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 backdrop-blur-md flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Live HD WebRTC Audio
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-xl font-bold text-[var(--text-primary)]">Real-Time Voice Waves</h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
              Crystal-clear peer-to-peer audio calling with real-time waveform dynamics. Zero central recording or voice transcripts saved.
            </p>
          </div>
        </div>
      </div>

      <!-- Showcase 2: Next Stranger Fluid Transition (Reference 5: profile_cards_skip_transition.webp) -->
      <div class="p-2 rounded-[2.5rem] bg-black/5 dark:bg-white/5 border border-[var(--border)] shadow-md flex flex-col">
        <div class="h-full p-6 sm:p-8 rounded-[calc(2.5rem-0.5rem)] bg-[var(--bg-surface-elevated)] flex flex-col gap-6">
          <div class="relative w-full rounded-2xl overflow-hidden aspect-[16/10] bg-[var(--bg-surface)] border border-[var(--border)]">
            <img
              src="/assets/profile_cards_skip_transition.webp"
              alt="Next Stranger Transition"
              class="w-full h-full object-cover opacity-90 transition-transform duration-700 hover:scale-105"
              loading="lazy"
            />
            <div class="absolute bottom-3 left-3 px-3 py-1 rounded-full bg-[var(--bg-surface)]/90 border border-[var(--border)] text-[11px] font-semibold text-indigo-600 dark:text-indigo-400 backdrop-blur-md flex items-center gap-1.5">
              <Icon name="skip-forward" class="w-3.5 h-3.5" />
              <span>Fluid Rematching Physics</span>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <h3 class="text-xl font-bold text-[var(--text-primary)]">Instant "Next Stranger" Flow</h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
              Not feeling the conversation? Hit Next to smoothly glide into a new chat in under 300ms without disruptive page reloads.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
