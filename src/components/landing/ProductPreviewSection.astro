---
import Icon from '../icons/Icon.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
---

<section id="demo" class="w-full py-12 sm:py-16 px-4 bg-[var(--bg-surface-elevated)]/40 border-y border-[var(--border)]">
  <div class="max-w-4xl mx-auto flex flex-col items-center gap-10">
    <!-- Section Header -->
    <div class="text-center max-w-xl flex flex-col items-center gap-2.5">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold border border-emerald-500/20">
        <Icon name="shield-check" class="w-3.5 h-3.5" />
        <span>Interface & Privacy Architecture</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] tracking-tight">
        Built for Speed, Privacy & Instant Severability
      </h2>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Test the chat interface below. Messages are processed in RAM memory and instantly wiped upon leaving.
      </p>
    </div>

    <!-- Minimalist Chat Showcase Card -->
    <div class="w-full max-w-lg p-2 rounded-3xl bg-[var(--bg-surface)] border border-[var(--border)] shadow-xl flex flex-col overflow-hidden">
      
      <!-- Top App Header -->
      <div class="px-4 py-3 border-b border-[var(--border)] bg-[var(--bg-surface-elevated)] flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-bold flex items-center justify-center text-xs">
            P
          </div>
          <div class="flex flex-col text-left">
            <span class="font-bold text-xs text-[var(--text-primary)]">Connected Peer</span>
            <span class="text-[10px] text-emerald-500 font-medium flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Encrypted RAM Tunnel
            </span>
          </div>
        </div>

        <!-- Quick Action Demo Controls -->
        <div class="flex items-center gap-1.5">
          <button id="preview-wipe-btn" class="px-2.5 py-1 rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--border)] text-[11px] font-semibold text-[var(--text-secondary)] transition-colors border border-[var(--border)] flex items-center gap-1 cursor-pointer" title="Simulate Session Wipe">
            <svg class="w-3 h-3 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3 6 5 6 21 6"></polyline>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <line x1="10" y1="11" x2="10" y2="17"></line>
              <line x1="14" y1="11" x2="14" y2="17"></line>
            </svg>
            <!-- Quick ephemeral wipe trigger -->
            <span>Wipe Logs</span>
          </button>
          <button id="preview-report-btn" class="p-1.5 rounded-xl hover:bg-[var(--border)] text-[var(--text-secondary)] hover:text-rose-500 transition-colors cursor-pointer" title="Report & Block Trigger">
            <Icon name="flag" class="w-3.5 h-3.5" />
          </button>
        </div>
      </div>

      <!-- Ephemeral Notice Bar -->
      <div class="py-1.5 bg-emerald-500/5 text-center border-b border-emerald-500/10 text-[11px] text-emerald-600 dark:text-emerald-400 flex items-center justify-center gap-1 font-medium">
        <Icon name="lock" class="w-3 h-3" />
        <span>No Chat History Stored • Disconnect Erases Everything</span>
      </div>

      <!-- Live Interactive Messages Demo Feed -->
      <div id="preview-messages" class="p-4 flex flex-col gap-3 min-h-[220px] max-h-[260px] overflow-y-auto text-xs sm:text-sm">
        <div class="p-3 rounded-2xl rounded-bl-xs bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] border border-[var(--border)] leading-relaxed max-w-[85%] self-start shadow-xs">
          Hi! This is an interactive sandbox showing our zero-retention messaging interface. Try typing below:
        </div>
      </div>

      <!-- Preview Composer Bar -->
      <div class="p-3 border-t border-[var(--border)] bg-[var(--bg-surface)] flex items-center gap-2">
        <input
          id="preview-input"
          type="text"
          placeholder="Type a test message..."
          maxlength="150"
          class="flex-1 px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] transition-all"
        />
        <button
          id="preview-send-btn"
          class="w-8 h-8 rounded-xl bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white flex items-center justify-center transition-all cursor-pointer shrink-0"
          title="Send"
        >
          <Icon name="send" class="w-3.5 h-3.5" />
        </button>
      </div>
    </div>

    <!-- Direct CTA -->
    <div class="flex items-center gap-4">
      <a href={translatePath('/start')} class="py-3 px-8 rounded-2xl bg-[var(--primary)] hover:bg-[var(--primary-hover)] text-white text-xs font-bold transition-all shadow-md flex items-center gap-2">
        <span>Enter Live Queue</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>

<script>
  const previewInput = document.getElementById('preview-input') as HTMLInputElement;
  const previewSendBtn = document.getElementById('preview-send-btn');
  const previewMessages = document.getElementById('preview-messages');
  const previewWipeBtn = document.getElementById('preview-wipe-btn');
  const previewReportBtn = document.getElementById('preview-report-btn');

  function sendPreviewMsg() {
    if (!previewInput || !previewMessages) return;
    const text = previewInput.value.trim();
    if (!text) return;

    const userMsg = document.createElement('div');
    userMsg.className = 'p-3 rounded-2xl rounded-br-xs bg-[var(--primary)] text-white leading-relaxed max-w-[85%] self-end shadow-xs animate-msg-in';
    userMsg.textContent = text;
    previewMessages.appendChild(userMsg);
    previewInput.value = '';
    previewMessages.scrollTop = previewMessages.scrollHeight;
  }

  previewSendBtn?.addEventListener('click', sendPreviewMsg);
  previewInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      sendPreviewMsg();
    }
  });

  previewWipeBtn?.addEventListener('click', () => {
    if (!previewMessages) return;
    previewMessages.innerHTML = `
      <div class="p-2.5 text-center text-xs text-rose-500 font-medium bg-rose-500/10 rounded-xl border border-rose-500/20">
        Session RAM cleared. 0 messages retained in database.
      </div>
    `;
  });

  previewReportBtn?.addEventListener('click', () => {
    alert('In live chat, this triggers an immediate disconnect, reciprocal block, and safety hash submission.');
  });
</script>
