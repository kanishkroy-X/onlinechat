---
import Icon from '../icons/Icon.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const FEATURES = [
  {
    icon: 'zap',
    title: t.howItWorks.step2Title,
    desc: t.howItWorks.step2Desc
  },
  {
    icon: 'shield-check',
    title: t.safetyBanner.title,
    desc: t.safetyBanner.tip3
  },
  {
    icon: 'shuffle',
    title: t.howItWorks.step3Title,
    desc: t.howItWorks.step3Desc
  }
];
---

<section class="w-full py-8 sm:py-12 px-4 border-t border-[var(--border)] bg-[var(--bg-surface)]">
  <div class="max-w-4xl mx-auto flex flex-col gap-6 text-center">
    <div class="flex flex-col items-center gap-1">
      <h2 class="text-lg sm:text-xl font-black text-[var(--text-primary)] tracking-tight">
        Why Chat on RandomChat?
      </h2>
      <p class="text-xs text-[var(--text-secondary)]">
        Simple, private, and built for direct conversation.
      </p>
    </div>

    <!-- 3 Simple Solid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
      {FEATURES.map((item, idx) => (
        <div class="p-5 rounded-2xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] flex flex-col gap-2.5 shadow-xs">
          <div class="w-9 h-9 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center shadow-xs">
            <Icon name={item.icon} class="w-4.5 h-4.5" />
          </div>
          <h3 class="font-bold text-sm text-[var(--text-primary)]">
            {item.title}
          </h3>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
