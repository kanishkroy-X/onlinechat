---
import Icon from '../icons/Icon.astro';
import Logo from '../Logo.astro';
import LanguagePicker from '../LanguagePicker.astro';
import { siteConfig } from '../../config/site';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const t = useTranslations(currentLang);
---

<footer class="w-full border-t border-[var(--border)] bg-[var(--bg-surface)] pt-12 pb-[calc(5rem+env(safe-area-inset-bottom,0px))] md:pb-12 px-4 mt-auto">
  <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-8 text-xs text-[var(--text-secondary)]">
    <!-- Brand Info & 18+ Notice -->
    <div class="flex flex-col gap-3">
      <a href={translatePath('/')} class="flex items-center gap-2 group">
        <Logo class="w-7 h-7" withText={true} />
      </a>
      <p class="text-xs text-[var(--text-muted)] leading-relaxed">
        {t.brand.description}
      </p>
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold w-fit text-[11px]">
        <Icon name="shield-check" class="w-3.5 h-3.5" />
        <span>18+ Adults Only</span>
      </div>
      <div class="pt-2">
        <LanguagePicker variant="footer" />
      </div>
    </div>

    <!-- Product Links -->
    <div class="flex flex-col gap-2.5">
      <span class="font-bold text-sm text-[var(--text-primary)] uppercase tracking-wider text-[11px]">Product</span>
      <a href={translatePath('/start')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.startChat}</a>
      <a href={translatePath('/random-chat')} class="hover:text-[var(--text-primary)] transition-colors">Random Chat</a>
      <a href={translatePath('/random-text-chat')} class="hover:text-[var(--text-primary)] transition-colors">Random Text Chat</a>
      <a href={translatePath('/random-voice-chat')} class="hover:text-[var(--text-primary)] transition-colors">Random Voice Chat</a>
      <a href={translatePath('/chat-rooms')} class="hover:text-[var(--text-primary)] transition-colors">Topic Rooms</a>
      <a href={translatePath('/how-it-works')} class="hover:text-[var(--text-primary)] transition-colors">{t.howItWorks.title}</a>
      <a href={translatePath('/faq')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.faq}</a>
    </div>

    <!-- Safety & Trust -->
    <div class="flex flex-col gap-2.5">
      <span class="font-bold text-sm text-[var(--text-primary)] uppercase tracking-wider text-[11px]">Safety & Privacy</span>
      <a href={translatePath('/safety')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.safety}</a>
      <a href={translatePath('/privacy')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.privacy}</a>
      <a href={translatePath('/cookie-policy')} class="hover:text-[var(--text-primary)] transition-colors">Cookie Policy</a>
      <a href={translatePath('/safety#report')} class="hover:text-[var(--text-primary)] transition-colors">Report Abuse</a>
    </div>

    <!-- Legal & Contact -->
    <div class="flex flex-col gap-2.5">
      <span class="font-bold text-sm text-[var(--text-primary)] uppercase tracking-wider text-[11px]">Company & Support</span>
      <a href={translatePath('/about')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.about}</a>
      <a href={translatePath('/contact')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.contact}</a>
      <a href={translatePath('/terms')} class="hover:text-[var(--text-primary)] transition-colors">{t.nav.terms}</a>
      <div class="pt-1 text-[11px] text-[var(--text-muted)]">
        Support: <a href={`mailto:${siteConfig.supportEmail}`} class="text-[var(--primary)] underline">{siteConfig.supportEmail}</a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="max-w-6xl mx-auto pt-6 border-t border-[var(--border)] flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-[var(--text-muted)] text-center sm:text-left">
    <span>&copy; {new Date().getFullYear()} {siteConfig.name} &bull; {t.footer.allRightsReserved}</span>
    <span>{t.footer.disclaimer}</span>
  </div>
</footer>
