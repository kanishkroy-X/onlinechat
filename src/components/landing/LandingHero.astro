---
import Icon from '../icons/Icon.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);
const t = useTranslations(currentLang);
---

<section class="w-full pt-12 sm:pt-20 pb-16 sm:pb-24 px-4 flex flex-col items-center justify-center text-center relative overflow-hidden">
  <!-- Subtle Background Sunset Glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[650px] h-[380px] bg-gradient-to-b from-[#FF808A]/15 via-[#D55882]/10 to-transparent blur-3xl pointer-events-none rounded-full -z-10"></div>

  <div class="w-full max-w-3xl mx-auto flex flex-col items-center gap-6">

    <!-- 1. Live Activity Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-surface)] border border-[var(--border)] shadow-xs text-xs font-semibold text-[var(--text-secondary)]">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="text-[var(--text-primary)] font-bold">4,568 strangers</span>
      <span>online right now</span>
    </div>

    <!-- 2. Headline & Subheading -->
    <div class="flex flex-col gap-4 max-w-2xl">
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-[var(--text-primary)] leading-[1.1]">
        Meet someone new. <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-[#FF808A] via-[#D55882] to-[#7F376D] bg-clip-text text-transparent">
          Start a conversation.
        </span>
      </h1>
      <p class="text-base sm:text-lg text-[var(--text-secondary)] font-normal leading-relaxed max-w-xl mx-auto">
        Free, anonymous-by-default instant text & voice chat with people worldwide. No accounts, no personal tracking, zero friction.
      </p>
    </div>

    <!-- 3. Primary Dual Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center gap-3.5 w-full sm:w-auto mt-2">
      <!-- Start Chat CTA -->
      <a
        id="hero-start-random-btn"
        href={translatePath('/people')}
        class="w-full sm:w-auto py-3.5 px-7 rounded-2xl bg-gradient-to-r from-[#FF808A] via-[#D55882] to-[#7F376D] hover:opacity-95 text-white font-bold text-sm sm:text-base shadow-lg hover:shadow-xl transition-all flex items-center justify-center gap-2.5 cursor-pointer active:scale-[0.98]"
      >
        <Icon name="sparkles" class="w-4.5 h-4.5" />
        <span>Start Chatting Now</span>
        <Icon name="arrow-right" class="w-4.5 h-4.5" />
      </a>

      <!-- Browse People Lobby CTA -->
      <a
        id="hero-browse-people-btn"
        href={translatePath('/people')}
        class="w-full sm:w-auto py-3.5 px-6 rounded-2xl bg-[var(--bg-surface)] hover:bg-[var(--border)] border border-[var(--border)] text-[var(--text-primary)] font-bold text-sm sm:text-base shadow-xs hover:shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
      >
        <Icon name="users" class="w-4.5 h-4.5 text-[var(--text-secondary)]" />
        <span>Browse People Lobby</span>
      </a>
    </div>

    <!-- 4. Trust Badges & Guarantee -->
    <div class="mt-4 pt-6 border-t border-[var(--border)]/80 flex flex-wrap items-center justify-center gap-y-2 gap-x-6 text-xs text-[var(--text-muted)]">
      <span class="flex items-center gap-1.5 font-medium text-[var(--text-secondary)]">
        <Icon name="shield-check" class="w-3.5 h-3.5 text-emerald-500" />
        100% Anonymous (No Login)
      </span>
      <span class="flex items-center gap-1.5 font-medium text-[var(--text-secondary)]">
        <Icon name="lock" class="w-3.5 h-3.5 text-emerald-500" />
        Direct RAM Routing (Zero Logs)
      </span>
      <span class="flex items-center gap-1.5 font-medium text-[var(--text-secondary)]">
        <Icon name="zap" class="w-3.5 h-3.5 text-amber-500" />
        Instant 1-on-1 Matching
      </span>
      <span class="flex items-center gap-1.5 font-bold text-rose-500">
        18+ Adults Only
      </span>
    </div>

  </div>
</section>
