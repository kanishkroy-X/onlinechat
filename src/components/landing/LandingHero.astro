---
import Icon from '../icons/Icon.astro';
---

<section class="relative w-full overflow-hidden pt-6 pb-12 sm:pt-16 sm:pb-24 px-4 sm:px-6 flex flex-col items-center justify-center text-center">
  <!-- Soft Ambient Warm/Rose Glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[600px] h-[300px] sm:h-[400px] bg-gradient-to-tr from-pink-400/10 via-rose-300/15 to-amber-200/10 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="w-full max-w-3xl mx-auto flex flex-col items-center gap-4 sm:gap-6">
    
    <!-- Main Headline - Responsive & User-Friendly on Mobile -->
    <div class="flex flex-col gap-2.5 sm:gap-3 px-1">
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-[var(--text-primary)] leading-[1.12] sm:leading-[1.08]">
        Talk to Strangers Online
      </h1>
      <p class="text-sm sm:text-lg md:text-xl text-[var(--text-secondary)] max-w-2xl mx-auto font-normal leading-relaxed px-2 sm:px-0">
        Free <strong class="font-bold text-[var(--text-primary)]">anonymous chat</strong> with random people worldwide — text or video, your call. No signup, instant matching, moderated.
      </p>
    </div>

    <!-- Interactive Mode Segmented Pill Capsule (Video / Text / Voice) -->
    <div class="w-full max-w-xs sm:max-w-none sm:w-auto inline-flex items-center justify-between sm:justify-center bg-white dark:bg-[#1E2230] p-1 sm:p-1.5 rounded-full border border-pink-100 dark:border-pink-900/30 shadow-xs">
      <button
        id="hero-mode-video"
        type="button"
        class="hero-mode-btn flex-1 sm:flex-initial px-3.5 sm:px-5 py-2 sm:py-2 rounded-full text-xs sm:text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer"
        data-mode="video"
      >
        <Icon name="video" class="w-4 h-4 text-pink-500 shrink-0" />
        <span>Video</span>
      </button>

      <button
        id="hero-mode-text"
        type="button"
        class="hero-mode-btn flex-1 sm:flex-initial px-3.5 sm:px-5 py-2 sm:py-2 rounded-full text-xs sm:text-sm font-bold text-pink-600 bg-pink-50 dark:bg-pink-950/40 border border-pink-200 dark:border-pink-800/40 transition-all flex items-center justify-center gap-1.5 sm:gap-2 shadow-xs cursor-pointer active"
        data-mode="text"
      >
        <Icon name="message-square" class="w-4 h-4 text-pink-600 shrink-0" />
        <span>Text</span>
      </button>

      <button
        id="hero-mode-voice"
        type="button"
        class="hero-mode-btn flex-1 sm:flex-initial px-3.5 sm:px-5 py-2 sm:py-2 rounded-full text-xs sm:text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center justify-center gap-1.5 sm:gap-2 cursor-pointer"
        data-mode="voice"
      >
        <Icon name="mic" class="w-4 h-4 text-pink-500 shrink-0" />
        <span>Voice</span>
      </button>
    </div>

    <!-- Primary Action CTA Button (Large Pink Pill - Thumb-Friendly) -->
    <div class="w-full sm:w-auto flex flex-col items-center gap-2 pt-1 px-2 sm:px-0">
      <a
        id="hero-cta-btn"
        href="/chat"
        class="w-full max-w-sm sm:w-auto sm:min-w-[320px] py-3.5 sm:py-4 px-6 sm:px-8 rounded-full bg-[#E12B7B] hover:bg-[#D41C6C] text-white font-bold text-base sm:text-lg shadow-lg hover:shadow-pink-500/25 transition-all duration-200 flex items-center justify-center gap-2.5 sm:gap-3 active:scale-[0.98] cursor-pointer"
      >
        <span id="hero-cta-icon">
          <Icon name="message-square" class="w-5 h-5 text-white" />
        </span>
        <span id="hero-cta-text">Start Text Chat</span>
        <Icon name="arrow-right" class="w-5 h-5 text-white transition-transform group-hover:translate-x-1" />
      </a>

      <!-- Context Micro-Copy under Button -->
      <div id="hero-subtext-container" class="flex flex-col items-center gap-0.5 text-xs text-[var(--text-muted)] pt-0.5">
        <div id="hero-subtext-main" class="flex items-center gap-1.5 text-pink-600 dark:text-pink-400 font-medium text-xs sm:text-sm">
          <span>✨</span>
          <span id="hero-subtext-label">Just type — no camera or mic needed</span>
        </div>
        <div id="hero-subtext-extra" class="hidden text-[11px] sm:text-xs text-[var(--text-subtle)]">
          No camera? Switch to Text or Voice
        </div>
      </div>
    </div>

    <!-- Trust Signals Micro-Row (Free · No sign-up · Moderated · Anonymous · 18+) -->
    <div class="pt-2 sm:pt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-xs sm:text-sm text-[var(--text-secondary)] font-medium">
      <span>Free</span>
      <span class="text-pink-300">•</span>
      <span>No sign-up</span>
      <span class="text-pink-300">•</span>
      <span>Moderated</span>
      <span class="text-pink-300">•</span>
      <span>Anonymous</span>
      <span class="text-pink-300">•</span>
      <span>18+</span>
    </div>

    <!-- Secondary Account Sign-in Link -->
    <div class="text-xs sm:text-sm text-[var(--text-muted)] flex items-center justify-center gap-1.5">
      <span>Already have an account?</span>
      <a href="/chat" class="font-bold text-pink-600 dark:text-pink-400 hover:text-pink-700 flex items-center gap-1 hover:underline">
        <span>➔]</span>
        <span>Sign in</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Mode switcher interactivity
  const modeButtons = document.querySelectorAll('.hero-mode-btn');
  const heroCtaBtn = document.getElementById('hero-cta-btn') as HTMLAnchorElement;
  const heroCtaText = document.getElementById('hero-cta-text');
  const heroCtaIcon = document.getElementById('hero-cta-icon');
  const heroSubtextLabel = document.getElementById('hero-subtext-label');
  const heroSubtextExtra = document.getElementById('hero-subtext-extra');

  const modes: Record<string, {
    url: string;
    label: string;
    iconSvg: string;
    subtext: string;
    extra?: string;
  }> = {
    text: {
      url: '/chat',
      label: 'Start Text Chat',
      iconSvg: '<svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
      subtext: 'Just type — no camera or mic needed'
    },
    video: {
      url: '/random-chat',
      label: 'Start Video Chat',
      iconSvg: '<svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>',
      subtext: 'Face-to-face with someone new',
      extra: 'No camera? Switch to Text or Voice'
    },
    voice: {
      url: '/random-voice-chat',
      label: 'Start Voice Chat',
      iconSvg: '<svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>',
      subtext: 'Crystal-clear live audio — instant match'
    }
  };

  modeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const modeKey = btn.getAttribute('data-mode') || 'text';
      const config = modes[modeKey];
      if (!config) return;

      // Update button styling
      modeButtons.forEach(b => {
        b.classList.remove('active', 'font-bold', 'text-pink-600', 'bg-pink-50', 'dark:bg-pink-950/40', 'border', 'border-pink-200', 'dark:border-pink-800/40', 'shadow-xs');
        b.classList.add('font-semibold', 'text-[var(--text-secondary)]');
      });

      btn.classList.add('active', 'font-bold', 'text-pink-600', 'bg-pink-50', 'dark:bg-pink-950/40', 'border', 'border-pink-200', 'dark:border-pink-800/40', 'shadow-xs');
      btn.classList.remove('text-[var(--text-secondary)]');

      // Update CTA Link & Texts
      if (heroCtaBtn) heroCtaBtn.href = config.url;
      if (heroCtaText) heroCtaText.textContent = config.label;
      if (heroCtaIcon) heroCtaIcon.innerHTML = config.iconSvg;
      if (heroSubtextLabel) heroSubtextLabel.textContent = config.subtext;

      if (heroSubtextExtra) {
        if (config.extra) {
          heroSubtextExtra.textContent = config.extra;
          heroSubtextExtra.classList.remove('hidden');
        } else {
          heroSubtextExtra.classList.add('hidden');
        }
      }
    });
  });
</script>
