---
import Icon from '../icons/Icon.astro';
import { getLangFromUrl, useTranslatedPath } from '../../i18n/utils';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const currentLang = lang || getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);

const FEATURED_ROOMS = [
  {
    slug: 'dating',
    title: 'Dating & Romance',
    icon: '💖',
    desc: 'Meet singles, find chemistry, and talk to people looking for connection.',
    online: 2410
  },
  {
    slug: 'gaming',
    title: 'Gaming & Esports',
    icon: '🎮',
    desc: 'Steam, Valorant, GTA, RPGs, and favorite gameplay chatter.',
    online: 1840
  },
  {
    slug: 'music',
    title: 'Music & Vibes',
    icon: '🎵',
    desc: 'Track recommendations, genres, playlist sharing, and chill moods.',
    online: 1290
  },
  {
    slug: 'movies',
    title: 'Cinema & Anime',
    icon: '🍿',
    desc: 'Discussions on blockbusters, anime seasons, series, and reviews.',
    online: 980
  }
];
---

<section class="w-full py-8 sm:py-12 px-4 border-t border-[var(--border)] bg-[var(--bg-surface-elevated)]/40">
  <div class="max-w-4xl mx-auto flex flex-col gap-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div class="flex flex-col gap-0.5">
        <h2 class="text-lg sm:text-xl font-black text-[var(--text-primary)] tracking-tight flex items-center gap-2">
          <span>Popular Chat Rooms</span>
        </h2>
        <p class="text-xs text-[var(--text-secondary)]">
          Jump into active community channels matching your interests.
        </p>
      </div>
      <a
        href={translatePath('/chat-rooms')}
        class="text-xs font-bold text-[var(--primary)] hover:underline flex items-center gap-1 shrink-0"
      >
        <span>View All</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- 4 Room Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
      {FEATURED_ROOMS.map(room => (
        <a
          href={translatePath(`/chat-rooms/${room.slug}`)}
          class="p-4 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] hover:border-[var(--primary)]/40 hover:shadow-md transition-all flex items-center justify-between gap-3 group text-left cursor-pointer"
        >
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="w-11 h-11 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform">
              {room.icon}
            </div>
            <div class="flex flex-col min-w-0">
              <span class="font-bold text-sm text-[var(--text-primary)] truncate group-hover:text-[var(--primary)] transition-colors">
                {room.title}
              </span>
              <span class="text-xs text-[var(--text-muted)] line-clamp-1">
                {room.desc}
              </span>
            </div>
          </div>

          <div class="flex flex-col items-end shrink-0">
            <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              {room.online.toLocaleString()}
            </span>
            <span class="text-[10px] text-[var(--text-subtle)]">online</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
