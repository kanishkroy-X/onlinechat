---
import { getTranslations } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<footer class="w-full border-t border-[var(--border-color)] bg-[var(--bg-surface)] py-8 px-4 mt-auto">
  <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
    <!-- Brand / Copyright -->
    <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
      <span class="font-bold text-[var(--text-main)]">randomcaht.online</span>
      <span>&copy; {new Date().getFullYear()} {t.footer.allRightsReserved}</span>
      <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-semibold">18+ Only</span>
    </div>

    <!-- Navigation Links -->
    <nav class="flex flex-wrap items-center justify-center gap-4 text-[var(--text-muted)]">
      <a href="/safety" class="hover:text-[var(--text-main)] transition-colors">{t.nav.safety}</a>
      <a href="/faq" class="hover:text-[var(--text-main)] transition-colors">{t.nav.faq}</a>
      <a href="/privacy" class="hover:text-[var(--text-main)] transition-colors">{t.nav.privacy}</a>
      <a href="/terms" class="hover:text-[var(--text-main)] transition-colors">{t.nav.terms}</a>
      <a href="/about" class="hover:text-[var(--text-main)] transition-colors">{t.nav.about}</a>
      <a href="/contact" class="hover:text-[var(--text-main)] transition-colors">{t.nav.contact}</a>
    </nav>
  </div>
  <div class="max-w-6xl mx-auto mt-4 text-center text-[10px] text-[var(--text-subtle)]">
    {t.footer.disclaimer}
  </div>
</footer>
