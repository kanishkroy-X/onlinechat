---
import { getTranslations } from '../i18n/translations';

const t = getTranslations('en');
---

<footer class="w-full border-t border-[var(--border-color)] bg-[var(--bg-surface)] mt-auto py-8 text-sm text-[var(--text-muted)]">
  <div class="max-w-6xl mx-auto px-4 flex flex-col gap-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 font-bold text-[var(--text-main)]">
        <span>randomcaht<span class="text-[#FF808A]">.online</span></span>
      </div>

      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a href="/safety" class="hover:text-[var(--text-main)] transition-colors">{t.nav.safety}</a>
        <a href="/faq" class="hover:text-[var(--text-main)] transition-colors">{t.nav.faq}</a>
        <a href="/privacy" class="hover:text-[var(--text-main)] transition-colors">{t.nav.privacy}</a>
        <a href="/terms" class="hover:text-[var(--text-main)] transition-colors">{t.nav.terms}</a>
        <a href="/about" class="hover:text-[var(--text-main)] transition-colors">{t.nav.about}</a>
        <a href="/contact" class="hover:text-[var(--text-main)] transition-colors">{t.nav.contact}</a>
      </nav>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-2 pt-4 border-t border-[var(--border-color)] text-xs text-[var(--text-subtle)] text-center sm:text-left">
      <p>{t.footer.agePolicy}</p>
      <p>&copy; {new Date().getFullYear()} randomcaht.online. {t.footer.allRightsReserved}</p>
    </div>
  </div>
</footer>
