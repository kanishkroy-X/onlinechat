---
import CountrySelector from './CountrySelector.astro';

interface Props {
  class?: string;
  isMobileDrawer?: boolean;
}

const {
  class: className = '',
  isMobileDrawer = false
} = Astro.props;
---

<aside id={isMobileDrawer ? 'mobile-filter-drawer' : 'filter-panel'} class={`w-full bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl p-4 sm:p-5 flex flex-col gap-4 shadow-xs transition-colors ${className}`}>
  <!-- Header -->
  <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-[#FF808A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
      </svg>
      <h3 class="text-sm font-bold text-[var(--text-primary)]">People Filters</h3>
    </div>
    <button
      type="button"
      id="filter-clear-all-btn"
      class="text-xs font-semibold text-[var(--text-secondary)] hover:text-[#FF808A] transition-colors cursor-pointer"
    >
      Reset all
    </button>
  </div>

  <!-- 1. Gender Filter -->
  <div class="flex flex-col gap-2">
    <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">Gender</span>
    <div class="grid grid-cols-3 gap-1.5 p-1 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)]">
      <button
        type="button"
        class="filter-gender-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-center transition-all bg-[var(--bg-surface)] text-[#FF808A] border border-[#FF808A]/30 shadow-xs cursor-pointer"
        data-gender="all"
      >
        Everyone
      </button>
      <button
        type="button"
        class="filter-gender-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-center transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
        data-gender="male"
      >
        Male
      </button>
      <button
        type="button"
        class="filter-gender-btn py-1.5 px-2 rounded-lg text-xs font-semibold text-center transition-all text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer"
        data-gender="female"
      >
        Female
      </button>
    </div>
  </div>

  <!-- 2. Age Range Filter (Default 18-35) -->
  <div class="flex flex-col gap-2">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">Age Range</span>
      <span id="filter-age-label" class="text-xs font-bold text-[#FF808A]">18–35 yrs</span>
    </div>
    <div class="flex flex-col gap-1.5 px-1">
      <input
        id="filter-age-range"
        type="range"
        min="18"
        max="65"
        value="35"
        class="w-full accent-[#FF808A] bg-[var(--border)] h-1.5 rounded-lg appearance-none cursor-pointer"
      />
      <div class="flex justify-between text-[10px] text-[var(--text-muted)] font-mono">
        <span>18 y/o</span>
        <span>35 y/o</span>
        <span>65+ y/o</span>
      </div>
    </div>
  </div>

  <!-- 3. Country Filter (Searchable with flags + All Countries) -->
  <div class="flex flex-col gap-1.5">
    <CountrySelector
      id="people-filter-country"
      name="filter-country"
      value="all"
      label="Country"
      allowAll={true}
    />
  </div>

  <!-- Apply Trigger (Especially prominent on mobile drawer) -->
  <div class="pt-2 border-t border-[var(--border)] mt-1">
    <button
      type="button"
      id="filter-apply-btn"
      class="w-full py-2.5 rounded-xl bg-gradient-to-r from-[#FF808A] via-[#D55882] to-[#7F376D] hover:opacity-95 text-white text-xs font-bold transition-all shadow-xs cursor-pointer flex items-center justify-center gap-1.5 active:scale-[0.98]"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span>Apply Filters</span>
    </button>
  </div>
</aside>
