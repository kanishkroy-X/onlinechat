---
// CallModals.astro - Voice Chat Request & Atmospheric WebRTC Overlay
// Adheres strictly to RandomChat UI/UX Specification v3.1 and Sunset/Plum visual system
---

<!-- 1. EXPLICIT VOICE REQUEST PROMPT MODAL (Opt-In Acceptance) -->
<div
  id="voice-request-dialog"
  class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 animate-in fade-in duration-150"
  role="dialog"
  aria-modal="true"
  aria-labelledby="voice-request-title"
>
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border)] rounded-3xl p-6 sm:p-7 flex flex-col items-center gap-5 shadow-2xl text-center">
    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#FF808A]/20 to-[#D55882]/20 text-[#FF808A] flex items-center justify-center border border-[#FF808A]/30">
      <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
        <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
        <line x1="12" y1="19" x2="12" y2="23"></line>
        <line x1="8" y1="23" x2="16" y2="23"></line>
      </svg>
    </div>

    <div class="flex flex-col gap-1">
      <h3 id="voice-request-title" class="text-lg font-bold text-[var(--text-primary)]">Voice Chat Request</h3>
      <p id="voice-request-msg" class="text-xs text-[var(--text-secondary)] leading-relaxed">
        <strong id="voice-request-caller">Stranger</strong> wants to start a live voice chat.
      </p>
    </div>

    <p class="text-[11px] text-[var(--text-muted)]">
      Microphone is never shared without your explicit consent.
    </p>

    <!-- Accept / Decline Actions -->
    <div class="grid grid-cols-2 gap-3 w-full pt-1">
      <button
        type="button"
        id="voice-decline-btn"
        class="py-2.5 px-4 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer"
      >
        Decline
      </button>
      <button
        type="button"
        id="voice-accept-btn"
        class="py-2.5 px-4 rounded-xl bg-gradient-to-r from-[#FF808A] to-[#D55882] hover:opacity-95 text-xs font-bold text-white shadow-md transition-all cursor-pointer flex items-center justify-center gap-1.5 active:scale-95"
      >
        <span>Accept</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </button>
    </div>
  </div>
</div>

<!-- 2. ATMOSPHERIC WEBRTC VOICE CHAT OVERLAY -->
<div
  id="voice-call-overlay"
  class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
>
  <div class="w-full max-w-sm bg-[var(--bg-surface)] border border-[var(--border)] rounded-3xl p-6 sm:p-8 flex flex-col items-center gap-6 shadow-2xl text-center relative overflow-hidden">
    <!-- Header status -->
    <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#10B981]/15 text-[#10B981] text-xs font-bold border border-[#10B981]/30">
      <span class="w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
      <span>Live WebRTC Audio</span>
    </div>

    <!-- Audio-Reactive Pulsing Rings (Section 16 Specification) -->
    <div class="relative w-28 h-28 flex items-center justify-center my-2">
      <!-- Reactive Ring 1 -->
      <span class="absolute inset-0 rounded-full border-2 border-[#FF808A]/30 animate-ping opacity-50"></span>
      <!-- Reactive Ring 2 -->
      <span class="absolute w-22 h-22 rounded-full border border-[#D55882]/40 animate-pulse"></span>
      <!-- Central Mic/Avatar Orb -->
      <div class="w-18 h-18 rounded-full bg-gradient-to-br from-[#FF808A] via-[#D55882] to-[#7F376D] text-white flex items-center justify-center shadow-lg shadow-[#FF808A]/25 z-10">
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="23"></line>
          <line x1="8" y1="23" x2="16" y2="23"></line>
        </svg>
      </div>
    </div>

    <div>
      <h3 id="active-voice-user" class="text-xl font-black text-[var(--text-primary)]">Sarah</h3>
      <p id="voice-timer" class="text-xs font-mono font-bold text-[#FF808A] mt-1">00:00</p>
    </div>

    <!-- Simulated live audio wave -->
    <div class="flex items-center justify-center gap-1.5 h-8 w-full px-8">
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.1s; height: 10px;"></span>
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.3s; height: 24px;"></span>
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.2s; height: 32px;"></span>
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.4s; height: 16px;"></span>
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.15s; height: 28px;"></span>
      <span class="w-1 bg-[#FF808A] rounded-full wave-bar" style="animation-delay: 0.35s; height: 12px;"></span>
    </div>

    <!-- Controls (Mute / Unmute & End Call) -->
    <div class="flex items-center justify-center gap-4 w-full mt-1">
      <button
        type="button"
        id="voice-mute-toggle"
        class="px-4 py-2.5 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-xs font-semibold text-[var(--text-primary)] flex items-center gap-2 transition-colors cursor-pointer shadow-xs"
        title="Mute / Unmute Mic"
      >
        <span id="voice-mute-icon">🎙</span>
        <span id="voice-mute-label">Mute</span>
      </button>

      <button
        type="button"
        id="voice-end-call-btn"
        class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition-all shadow-md cursor-pointer flex items-center gap-2"
        title="End Voice Call"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
        <span>End Call</span>
      </button>
    </div>
  </div>
</div>

<script>
  function initCallModals() {
    const requestDialog = document.getElementById('voice-request-dialog');
    const requestCaller = document.getElementById('voice-request-caller');
    const declineBtn = document.getElementById('voice-decline-btn');
    const acceptBtn = document.getElementById('voice-accept-btn');

    const overlay = document.getElementById('voice-call-overlay');
    const voiceUser = document.getElementById('active-voice-user');
    const voiceTimer = document.getElementById('voice-timer');
    const muteToggle = document.getElementById('voice-mute-toggle');
    const muteIcon = document.getElementById('voice-mute-icon');
    const muteLabel = document.getElementById('voice-mute-label');
    const endCallBtn = document.getElementById('voice-end-call-btn');

    let isMuted = false;
    let timerInterval: any = null;
    let secondsElapsed = 0;

    // Listen for voice request trigger
    window.addEventListener('rc:voice-request-triggered', (e: any) => {
      const partner = e.detail;
      if (requestCaller) requestCaller.textContent = partner?.username || 'Stranger';
      requestDialog?.classList.remove('hidden');
    });

    declineBtn?.addEventListener('click', () => {
      requestDialog?.classList.add('hidden');
    });

    acceptBtn?.addEventListener('click', () => {
      requestDialog?.classList.add('hidden');
      startVoiceSession(requestCaller?.textContent || 'Stranger');
    });

    function startVoiceSession(username: string) {
      if (voiceUser) voiceUser.textContent = username;
      overlay?.classList.remove('hidden');

      secondsElapsed = 0;
      updateTimer();
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        secondsElapsed++;
        updateTimer();
      }, 1000);
    }

    function updateTimer() {
      if (!voiceTimer) return;
      const mins = Math.floor(secondsElapsed / 60);
      const secs = secondsElapsed % 60;
      voiceTimer.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    muteToggle?.addEventListener('click', () => {
      isMuted = !isMuted;
      if (muteLabel) muteLabel.textContent = isMuted ? 'Unmute' : 'Mute';
      if (muteIcon) muteIcon.textContent = isMuted ? '🔇' : '🎙';
    });

    endCallBtn?.addEventListener('click', () => {
      if (timerInterval) clearInterval(timerInterval);
      overlay?.classList.add('hidden');
    });
  }

  initCallModals();
  document.addEventListener('astro:page-load', initCallModals);
</script>
