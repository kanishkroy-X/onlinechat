---
import { MOCK_USERS, COUNTRY_FLAG_MAP } from '../data/mockData';
---

<section id="people-section" class="w-full flex flex-col gap-4">
  <!-- Header: Online Counter Banner & Filter Trigger for Mobile -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl p-4 sm:p-5 shadow-xs transition-colors">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] flex items-center justify-center relative shadow-xs">
        <span class="w-2.5 h-2.5 rounded-full bg-[#18D889] animate-online-dot"></span>
        <span class="absolute inset-0 rounded-xl bg-[#18D889]/10 animate-ping opacity-75"></span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 id="people-online-count" class="text-base sm:text-lg font-bold text-[var(--text-primary)]">2,482 people online</h2>
          <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-[#18D889]/15 text-[#18D889] border border-[#18D889]/30">Live</span>
        </div>
        <p class="text-xs text-[var(--text-secondary)]">Ready to chat now • Select anyone to start messaging</p>
      </div>
    </div>

    <!-- Mobile Filter Toggle Button -->
    <button
      type="button"
      id="mobile-filter-drawer-toggle"
      class="lg:hidden flex items-center justify-center gap-2 px-3.5 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-xs font-semibold text-[var(--text-primary)] transition-colors cursor-pointer shadow-xs"
    >
      <svg class="w-3.5 h-3.5 text-[#6C4DFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
      </svg>
      <span>Filter People</span>
    </button>
  </div>

  <!-- Search Input Bar -->
  <div class="relative w-full">
    <input
      id="people-search-input"
      type="text"
      placeholder="Search people by username..."
      autocomplete="off"
      class="w-full px-4 py-3 pl-11 rounded-xl bg-[var(--bg-surface)] border border-[var(--border)] text-[var(--text-primary)] placeholder-[var(--text-muted)] text-sm focus:outline-none focus:border-[#6C4DFF] transition-colors shadow-xs"
    />
    <div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-muted)]">
      <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <button
      type="button"
      id="people-search-clear"
      class="hidden absolute right-3 top-1/2 -translate-y-1/2 p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
      aria-label="Clear Search"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- User Cards Grid / List -->
  <div id="people-cards-container" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-2 gap-3">
    {MOCK_USERS.map((user) => {
      const flag = COUNTRY_FLAG_MAP[user.countryCode]?.flag || '🌍';
      return (
        <div
          class="person-card group bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] border border-[var(--border)] hover:border-[var(--border-strong)] rounded-2xl p-4 transition-all duration-150 cursor-pointer flex items-center justify-between gap-3 shadow-xs relative overflow-hidden"
          data-id={user.id}
          data-username={user.username}
          data-age={user.age}
          data-gender={user.gender}
          data-country={user.countryCode}
          data-city={user.city}
          role="button"
          tabindex="0"
          aria-label={`Chat with ${user.username}, ${user.age} years old from ${user.city}, ${user.countryName}`}
        >
          <!-- Left: Avatar & Info -->
          <div class="flex items-center gap-3.5 min-w-0">
            <div class="relative w-12 h-12 rounded-full overflow-hidden bg-[var(--bg-surface-elevated)] shrink-0 border border-[var(--border)] shadow-xs">
              <img
                src={user.avatarUrl}
                alt={user.username}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                loading="lazy"
              />
              <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-[#18D889] border-2 border-[var(--bg-surface)] animate-online-dot"></span>
            </div>

            <div class="flex flex-col min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="font-bold text-sm text-[var(--text-primary)] truncate group-hover:text-[#6C4DFF] transition-colors">
                  {user.username}
                </span>
                <span class="text-xs" title={user.countryName}>{flag}</span>
              </div>
              
              <div class="flex items-center gap-1.5 text-xs text-[var(--text-secondary)] mt-0.5 truncate">
                <span>{user.age} y/o</span>
                <span>•</span>
                <span class="truncate">{user.city}, {user.countryName}</span>
              </div>

              {user.statusMessage && (
                <p class="text-[11px] text-[var(--text-muted)] truncate mt-1">
                  {user.statusMessage}
                </p>
              )}
            </div>
          </div>

          <!-- Right: Chat Action Icon -->
          <div class="shrink-0">
            <div class="w-8 h-8 rounded-xl bg-[var(--bg-surface-elevated)] group-hover:bg-[#6C4DFF] border border-[var(--border)] group-hover:border-[#6C4DFF] text-[var(--text-secondary)] group-hover:text-white flex items-center justify-center transition-all shadow-xs">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty Search / Filter State -->
  <div id="people-empty-state" class="hidden flex-col items-center justify-center p-12 bg-[var(--bg-surface)] border border-[var(--border)] rounded-2xl text-center gap-3 shadow-xs">
    <div class="w-12 h-12 rounded-full bg-[var(--bg-surface-elevated)] border border-[var(--border)] flex items-center justify-center text-[var(--text-muted)]">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <div class="flex flex-col gap-1">
      <h3 class="text-sm font-bold text-[var(--text-primary)]">No people match your search</h3>
      <p class="text-xs text-[var(--text-secondary)]">Try clearing filters or searching with a different term.</p>
    </div>
    <button
      type="button"
      id="empty-clear-filters-btn"
      class="mt-2 px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] border border-[var(--border)] text-xs font-semibold text-[#6C4DFF] transition-colors cursor-pointer shadow-xs"
    >
      Reset all filters
    </button>
  </div>
</section>
