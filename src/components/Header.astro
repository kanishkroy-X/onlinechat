---
import { SITE } from '../config/site';
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

interface Props {
  current?: 'home' | 'safety' | 'faq' | 'privacy' | 'terms' | 'about' | 'contact';
}

const { current = 'home' } = Astro.props;
const isHome = current === 'home';
---

<header id="site-header" class="site-header">
  <div class="wrap site-header-inner">
    <a href="/" class="brand">
      <BrandMark />
      <span>
        <span class="brand-word">{SITE.name}</span>
        <span class="brand-note">Text chat · 18+</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href={isHome ? '#product' : '/#product'}>Product</a>
      <a href={isHome ? '#how' : '/#how'}>How it works</a>
      <a href="/safety" aria-current={current === 'safety' ? 'page' : undefined}>Safety</a>
      <a href="/faq" aria-current={current === 'faq' ? 'page' : undefined}>FAQ</a>
    </nav>

    <div class="header-actions">
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Toggle color theme"
      >
        <span class="theme-icon-light">
          <Icon name="moon" size={18} />
        </span>
        <span class="theme-icon-dark" hidden>
          <Icon name="sun" size={18} />
        </span>
      </button>
      <button
        id="header-cta"
        class="btn btn-primary btn-sm"
        type="button"
        data-open-setup
      >
        Try {SITE.name}
      </button>
    </div>
  </div>
</header>

<script>
  import { getStoredTheme, applyTheme } from '../scripts/theme';

  const btn = document.getElementById('theme-toggle');
  const light = btn?.querySelector('.theme-icon-light') as HTMLElement | null;
  const dark = btn?.querySelector('.theme-icon-dark') as HTMLElement | null;

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (light) light.hidden = isDark;
    if (dark) dark.hidden = !isDark;
    btn?.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
  }

  syncThemeIcons();

  btn?.addEventListener('click', () => {
    const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
    applyTheme(next);
    syncThemeIcons();
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getStoredTheme() === 'system') syncThemeIcons();
  });
</script>
