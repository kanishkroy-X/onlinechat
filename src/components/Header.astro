---
import { getTranslations, SUPPORTED_LANGUAGES } from '../i18n/translations';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const t = getTranslations(lang);
---

<header class="w-full border-b border-[var(--border-color)] bg-[var(--bg-surface)]/80 backdrop-blur-md sticky top-0 z-40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a href="/" class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF808A] rounded-lg p-1">
      <div class="w-9 h-9 rounded-xl gradient-accent flex items-center justify-center shadow-sm group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg tracking-tight leading-none text-[var(--text-main)]">
          randomcaht<span class="text-[#FF808A]">.online</span>
        </span>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-[10px] uppercase font-bold tracking-wider text-emerald-600 dark:text-emerald-400 leading-tight">
            Online
          </span>
        </div>
      </div>
    </a>

    <!-- Actions & Controls -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <nav class="hidden md:flex items-center gap-4 text-sm font-medium text-[var(--text-muted)] mr-1">
        <a href="/safety" class="hover:text-[var(--text-main)] transition-colors py-1 px-2 rounded-md focus-visible:ring-2 focus-visible:ring-[#FF808A]">
          {t.nav.safety}
        </a>
        <a href="/faq" class="hover:text-[var(--text-main)] transition-colors py-1 px-2 rounded-md focus-visible:ring-2 focus-visible:ring-[#FF808A]">
          {t.nav.faq}
        </a>
      </nav>

      <!-- International Language Switcher -->
      <div class="relative" id="lang-switcher-container">
        <button
          id="lang-toggle-btn"
          type="button"
          class="h-9 px-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-muted)] hover:text-[var(--text-main)] text-xs font-semibold flex items-center gap-1.5 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF808A] cursor-pointer"
          aria-label="Change Website Language"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <!-- Globe icon -->
          <svg class="w-4 h-4 text-[#FF808A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="2" y1="12" x2="22" y2="12" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
          </svg>
          <span id="current-lang-code" class="uppercase tracking-wider">{lang}</span>
          <svg class="w-3 h-3 text-[var(--text-subtle)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <!-- Dropdown Menu for all 10 International Languages -->
        <div
          id="lang-dropdown-menu"
          class="hidden absolute right-0 top-11 z-50 w-52 bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl shadow-2xl py-2 flex flex-col max-h-80 overflow-y-auto"
          role="menu"
        >
          <div class="px-3 py-1.5 text-[10px] uppercase font-bold tracking-wider text-[var(--text-subtle)] border-b border-[var(--border-color)] mb-1">
            Select Language / اختر اللغة
          </div>
          {SUPPORTED_LANGUAGES.map(item => (
            <button
              type="button"
              class={`lang-option-btn w-full px-3.5 py-2 text-left text-xs ${item.code === lang ? 'bg-[#FF808A]/10 text-[#D55882] font-bold' : 'text-[var(--text-main)] hover:bg-[var(--bg-surface-elevated)]'} flex items-center justify-between transition-colors cursor-pointer`}
              data-lang={item.code}
              role="menuitem"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-base leading-none">{item.flag}</span>
                <span class="font-medium">{item.nativeName}</span>
              </div>
              <span class="text-[10px] text-[var(--text-subtle)] uppercase font-mono">{item.code}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Theme Switcher Button -->
      <button
        id="theme-toggle"
        type="button"
        class="w-9 h-9 flex items-center justify-center rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FF808A] cursor-pointer"
        aria-label="Toggle Theme (Light / Dark / System)"
      >
        <!-- Sun icon (for dark mode) -->
        <svg class="w-4.5 h-4.5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" />
          <path d="M12 20v2" />
          <path d="m4.93 4.93 1.41 1.41" />
          <path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" />
          <path d="M20 12h2" />
          <path d="m6.34 17.66-1.41 1.41" />
          <path d="m19.07 4.93-1.41 1.41" />
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg class="w-4.5 h-4.5 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  import { getStoredTheme, applyTheme } from '../scripts/theme';

  const themeBtn = document.getElementById('theme-toggle');
  themeBtn?.addEventListener('click', () => {
    const current = getStoredTheme();
    const next = current === 'dark' ? 'light' : current === 'light' ? 'system' : 'dark';
    applyTheme(next);
  });

  // Language Switcher Logic
  const langToggleBtn = document.getElementById('lang-toggle-btn');
  const langDropdown = document.getElementById('lang-dropdown-menu');

  langToggleBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    langDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', (e) => {
    if (langDropdown && !langDropdown.contains(e.target as Node) && e.target !== langToggleBtn) {
      langDropdown.classList.add('hidden');
    }
  });

  document.querySelectorAll('.lang-option-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const lang = target.dataset.lang || 'en';
      
      // 1. Store in localStorage
      localStorage.setItem('rc_language', lang);
      
      // 2. Set Cookie so Astro SSR reads it on every page request
      document.cookie = `rc_language=${lang};path=/;max-age=31536000;SameSite=Lax`;

      // 3. Navigate with the new language parameter for immediate reload
      const url = new URL(window.location.href);
      url.searchParams.set('lang', lang);
      window.location.href = url.toString();
    });
  });
</script>
