---
import { languages, languageFlags, type SupportedLang } from '../i18n/ui';
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from '../i18n/utils';
import Icon from './icons/Icon.astro';

interface Props {
  variant?: 'compact' | 'footer' | 'header';
  class?: string;
}

const { variant = 'header', class: className = '' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const currentRoute = getRouteFromUrl(Astro.url);
const translatePath = useTranslatedPath(currentLang);

const languageList = Object.entries(languages) as [SupportedLang, string][];
---

<div class={`relative inline-block text-left language-picker-container ${className}`} data-current-lang={currentLang}>
  <!-- Picker Trigger Button -->
  <button
    type="button"
    class="lang-picker-toggle flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] hover:bg-[var(--bg-surface-hover)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all cursor-pointer shadow-xs focus:outline-none focus:ring-2 focus:ring-[var(--primary)]"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Change Language"
    title="Change Language"
  >
    <span class="text-sm leading-none">{languageFlags[currentLang]}</span>
    <span class="hidden sm:inline-block font-medium">{languages[currentLang]}</span>
    <Icon name="chevron-right" class="w-3 h-3 text-[var(--text-muted)] rotate-90 transition-transform lang-chevron" />
  </button>

  <!-- Dropdown Menu -->
  <div
    class="lang-picker-dropdown hidden absolute right-0 mt-2 w-44 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border)] shadow-xl p-1.5 z-[100] backdrop-blur-md animate-in fade-in zoom-in-95 duration-100"
    role="menu"
    aria-orientation="vertical"
  >
    <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border)] mb-1">
      Select Language
    </div>
    <div class="flex flex-col gap-0.5 max-h-60 overflow-y-auto">
      {languageList.map(([code, name]) => {
        const targetUrl = translatePath(currentRoute, code);
        const isActive = code === currentLang;
        return (
          <a
            href={targetUrl}
            class={`flex items-center justify-between px-2.5 py-2 rounded-xl text-xs font-medium transition-colors ${
              isActive
                ? 'bg-[var(--primary)]/10 text-[var(--primary)] font-bold'
                : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-elevated)]'
            }`}
            data-lang-code={code}
            role="menuitem"
          >
            <div class="flex items-center gap-2">
              <span class="text-sm">{languageFlags[code]}</span>
              <span>{name}</span>
            </div>
            {isActive && (
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)]"></span>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>

<script>
  function initLanguagePickers() {
    const containers = document.querySelectorAll('.language-picker-container');

    containers.forEach(container => {
      const toggle = container.querySelector('.lang-picker-toggle');
      const dropdown = container.querySelector('.lang-picker-dropdown');
      const chevron = container.querySelector('.lang-chevron');
      const links = container.querySelectorAll('a[data-lang-code]');

      if (!toggle || !dropdown) return;

      const closeDropdown = () => {
        dropdown.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
        chevron?.classList.remove('-rotate-90');
        chevron?.classList.add('rotate-90');
      };

      const openDropdown = () => {
        dropdown.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        chevron?.classList.remove('rotate-90');
        chevron?.classList.add('-rotate-90');
      };

      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !dropdown.classList.contains('hidden');
        if (isOpen) {
          closeDropdown();
        } else {
          // Close other open pickers
          document.querySelectorAll('.lang-picker-dropdown').forEach(d => d.classList.add('hidden'));
          openDropdown();
        }
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          const code = link.getAttribute('data-lang-code');
          if (code) {
            try {
              document.cookie = `rc_language=${code}; path=/; max-age=31536000; SameSite=Lax`;
              localStorage.setItem('rc_language', code);
            } catch (err) {
              console.error('Failed to set language cookie:', err);
            }
          }
          closeDropdown();
        });
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      containers.forEach(container => {
        if (!container.contains(e.target as Node)) {
          const dropdown = container.querySelector('.lang-picker-dropdown');
          const toggle = container.querySelector('.lang-picker-toggle');
          const chevron = container.querySelector('.lang-chevron');
          dropdown?.classList.add('hidden');
          toggle?.setAttribute('aria-expanded', 'false');
          chevron?.classList.remove('-rotate-90');
          chevron?.classList.add('rotate-90');
        }
      });
    });
  }

  // Initialize on load & Astro transitions
  initLanguagePickers();
  document.addEventListener('astro:page-load', initLanguagePickers);
</script>
