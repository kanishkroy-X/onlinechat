---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const currentLang = Astro.cookies?.get('rc_language')?.value || Astro.url?.searchParams?.get('lang') || 'en';
---

<BaseLayout
  title={`Safety Guidelines & Best Practices — ${siteConfig.name}`}
  description={`Comprehensive safety guidelines, minimum age policy (18+), and privacy protection practices for ${siteConfig.name}.`}
  canonical={`${siteConfig.url}/safety`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 max-w-4xl mx-auto px-4 py-12 flex flex-col gap-10">
    <!-- Header with Shield Visual -->
    <div class="card-tactile p-8 sm:p-12 flex flex-col sm:flex-row items-center gap-8 text-center sm:text-left">
      <div class="w-20 h-20 rounded-2xl bg-[var(--primary-soft)] border border-[var(--primary)]/30 flex items-center justify-center relative shrink-0 text-[var(--primary)]">
        <Icon name="shield-check" class="w-10 h-10" />
      </div>

      <div class="flex flex-col gap-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit mx-auto sm:mx-0">
          <Icon name="shield-check" class="w-3.5 h-3.5" />
          <span>Safety First &bull; 18+ Adults</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
          Stay Safe While Chatting
        </h1>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed max-w-xl">
          {siteConfig.name} is designed for open, spontaneous, and respectful adult conversations. Follow these essential principles to protect yourself online.
        </p>

        <!-- Quick CTAs -->
        <div class="pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3">
          <a href="/start" class="btn-primary text-xs py-2.5 px-5">
            <span>Start Chatting</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
          <a href="#report" class="btn-secondary text-xs py-2.5 px-5">
            <span>Report a User</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Core Safety Guidelines Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- 1. Protect Personal Information -->
      <div class="card-tactile p-6 flex flex-col gap-2.5 text-left">
        <div class="flex items-center gap-2 text-[var(--primary)] font-bold text-sm">
          <span>01</span>
          <h2 class="text-base text-[var(--text-primary)]">Protect Personal Information</h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          Never share your full legal name, physical address, workplace, phone number, financial details, or external social media profiles.
        </p>
      </div>

      <!-- 2. Beware of Scams and External Links -->
      <div class="card-tactile p-6 flex flex-col gap-2.5 text-left">
        <div class="flex items-center gap-2 text-[var(--primary)] font-bold text-sm">
          <span>02</span>
          <h2 class="text-base text-[var(--text-primary)]">Avoid Suspicious Links</h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          Do not click on unsolicited URLs, third-party payment requests, cryptocurrency promotions, or suspicious external download links.
        </p>
      </div>

      <!-- 3. Zero Tolerance for Exploitation -->
      <div class="card-tactile p-6 flex flex-col gap-2.5 text-left">
        <div class="flex items-center gap-2 text-[var(--danger)] font-bold text-sm">
          <span>03</span>
          <h2 class="text-base text-[var(--text-primary)]">Zero Tolerance Policy</h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          Any illegal activity, threats of violence, non-consensual sexual content, hate speech, or harassment results in immediate bans.
        </p>
      </div>

      <!-- 4. Strictly 18+ Adults Only -->
      <div class="card-tactile p-6 flex flex-col gap-2.5 text-left">
        <div class="flex items-center gap-2 text-[var(--warning)] font-bold text-sm">
          <span>04</span>
          <h2 class="text-base text-[var(--text-primary)]">Strictly 18+ Platform</h2>
        </div>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          {siteConfig.name} is strictly intended for adults 18 and older. Minors are strictly prohibited from using the website.
        </p>
      </div>
    </div>

    <!-- How to Report Section -->
    <div id="report" class="card-tactile p-8 flex flex-col gap-4 text-left">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center">
          <Icon name="flag" class="w-5 h-5" />
        </div>
        <h2 class="text-xl font-bold text-[var(--text-primary)]">
          How to Report a User
        </h2>
      </div>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        If you encounter a user who violates these rules or engages in abusive behavior, click the Safety / Flag icon in the chat interface. You can also email our safety moderation team directly at <a href={`mailto:${siteConfig.supportEmail}`} class="text-[var(--primary)] font-medium underline">{siteConfig.supportEmail}</a> with relevant session context.
      </p>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
