---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

import { getLangFromUrl } from '../i18n/utils';

const currentLang = Astro.currentLocale || getLangFromUrl(Astro.url) || 'en';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Terms of Service",
      "item": `${siteConfig.url}/terms`
    }
  ]
};
---

<BaseLayout
  title={`Terms of Service — ${siteConfig.name}`}
  description={`Terms and conditions of use for ${siteConfig.name}.`}
  canonical={`${siteConfig.url}/terms`}
  lang={currentLang}
>
  <!-- Breadcrumb Schema for Search Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <LandingNavbar lang={currentLang} />

  <main id="main-content" tabindex="-1" class="flex-1 max-w-3xl mx-auto px-4 py-12 outline-none">
    <div class="flex flex-col gap-6 text-[var(--text-secondary)] text-sm leading-relaxed text-left">
      <div>
        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] mb-2 tracking-tight">
          Terms of Service
        </h1>
        <p class="text-xs text-[var(--text-muted)]">
          Effective Date: February 2026 &bull; {siteConfig.name}
        </p>
      </div>

      <section class="card-tactile p-6 flex flex-col gap-2">
        <h2 class="text-base font-bold text-[var(--text-primary)]">1. Acceptance of Terms</h2>
        <p>
          By accessing or using {siteConfig.name} ("the Service"), you agree to be bound by these Terms of Service. If you do not agree to these terms, you must not use the Service.
        </p>
      </section>

      <section class="card-tactile p-6 flex flex-col gap-2">
        <h2 class="text-base font-bold text-[var(--text-primary)]">2. Minimum Age Requirement (18+)</h2>
        <p>
          You must be at least 18 years of age (or the legal age of majority in your jurisdiction) to use the Service. Use of the Service by minors is strictly prohibited.
        </p>
      </section>

      <section class="card-tactile p-6 flex flex-col gap-2">
        <h2 class="text-base font-bold text-[var(--text-primary)]">3. Prohibited Conduct</h2>
        <p>You agree not to engage in any of the following prohibited activities:</p>
        <ul class="list-disc pl-5 flex flex-col gap-1 text-xs sm:text-sm">
          <li>Transmitting unlawful, harassing, threatening, hateful, defamatory, or abusive content.</li>
          <li>Sending automated spam, commercial solicitations, or deceptive phishing links.</li>
          <li>Transmitting sexually explicit or exploitative content involving minors (reported to law enforcement immediately).</li>
          <li>Attempting to bypass server-side rate limits, message controls, or security filters.</li>
          <li>Impersonating administrators or automated system accounts.</li>
        </ul>
      </section>

      <section class="card-tactile p-6 flex flex-col gap-2">
        <h2 class="text-base font-bold text-[var(--text-primary)]">4. Disclaimers & Limitation of Liability</h2>
        <p>
          The Service is provided on an "AS IS" and "AS AVAILABLE" basis without warranties of any kind. You communicate with strangers at your own discretion and risk. {siteConfig.name} is not liable for user-generated content or interactions.
        </p>
      </section>

      <section class="card-tactile p-6 flex flex-col gap-2">
        <h2 class="text-base font-bold text-[var(--text-primary)]">5. Termination and Blocking</h2>
        <p>
          We reserve the right to restrict, rate limit, or block access to the Service for any user who violates these Terms or poses a security risk to the community.
        </p>
      </section>

      <div class="pt-4 border-t border-[var(--border)]">
        <a href="/" class="font-semibold text-[var(--primary)] hover:underline">&larr; Back to Home</a>
      </div>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
