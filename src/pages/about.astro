---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

import { getLangFromUrl } from '../i18n/utils';

const currentLang = Astro.currentLocale || getLangFromUrl(Astro.url) || 'en';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "About Us",
      "item": `${siteConfig.url}/about`
    }
  ]
};
---

<BaseLayout
  title={`About ${siteConfig.name} — Real Conversations Without Complexity`}
  description={`Learn about ${siteConfig.name}'s mission to provide simple, free, anonymous text chat without accounts, algorithms, or feeds.`}
  canonical={`${siteConfig.url}/about`}
  lang={currentLang}
>
  <!-- Breadcrumb Schema for Search Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <LandingNavbar lang={currentLang} />

  <main id="main-content" tabindex="-1" class="flex-1 max-w-3xl mx-auto px-4 py-12 flex flex-col gap-8 outline-none">
    <!-- Header -->
    <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>Our Vision</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        About {siteConfig.name}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)]">
        Sometimes you just want to talk to someone new without algorithmic noise.
      </p>
    </div>

    <!-- Core Philosophy -->
    <div class="max-w-none text-sm text-[var(--text-secondary)] space-y-6 leading-relaxed">
      <div class="card-tactile p-6 flex flex-col gap-3">
        <h2 class="text-lg font-bold text-[var(--text-primary)]">The Simple Idea Behind {siteConfig.name}</h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          {siteConfig.name} is built around a single, foundational principle: <strong class="text-[var(--text-primary)]">real human dialogue should not require a lifetime identity.</strong>
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            No bloated profiles
          </div>
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            No infinite feeds
          </div>
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            No follower clout
          </div>
        </div>
      </div>

      <section class="space-y-2">
        <h2 class="text-xl font-bold text-[var(--text-primary)]">How We Differ</h2>
        <p>
          Most contemporary social platforms are designed to capture your attention and store your history forever. {siteConfig.name} does the exact opposite: we pair you with a compatible stranger for a spontaneous, ephemeral conversation. When the session closes, all session RAM is permanently destroyed.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-xl font-bold text-[var(--text-primary)]">Conversation, Not Algorithms</h2>
        <p>
          While you can set matching preferences, {siteConfig.name} is fundamentally a conversation platform. We don't ask for personal metrics, photos, or email addresses. We focus on ideas, stories, and genuine human connection.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-xl font-bold text-[var(--text-primary)]">A Commitment to Adult Safety</h2>
        <p>
          {siteConfig.name} is strictly an 18+ service. We protect our community through proactive rate limits, cold-message limits that stop spam floods, and immediate one-click blocking and reporting tools.
        </p>
      </section>
    </div>

    <!-- CTA -->
    <div class="pt-6 border-t border-[var(--border)] flex items-center justify-between">
      <a href="/" class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] underline">&larr; Back to Home</a>
      <a href="/start" class="btn-primary text-xs py-2.5 px-5">
        <span>Start Chatting</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
