---
export const prerender = false;
return Astro.redirect('/?openSetup=true&target=/people');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to RandomChat Setup...</title>
    <meta http-equiv="refresh" content="0;url=/?openSetup=true&target=/people" />
    <script>
      window.location.replace('/?openSetup=true&target=/people');
    </script>
  </head>
  <body class="bg-[#0D0B12] text-white flex items-center justify-center min-h-screen font-sans">
    <p class="text-sm text-neutral-400">Redirecting to guest setup...</p>
  </body>
</html>
