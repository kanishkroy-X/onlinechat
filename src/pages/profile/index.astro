---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/translations';
import { siteConfig } from '../../config/site';

const lang = 'en';
const t = getTranslations(lang);
---

<BaseLayout
  title={`Profile (Preview) — ${siteConfig.name}`}
  description={`Conversation-oriented profile preview on ${siteConfig.name}.`}
  canonical={`${siteConfig.url}/profile`}
  lang={lang}
  noindex={true}
>
  <Header lang={lang} />

  <main class="flex-1 w-full max-w-2xl mx-auto px-4 py-12 flex flex-col gap-6">
    <!-- Notice Banner -->
    <div class="p-4 rounded-2xl bg-[#FF808A]/10 border border-[#FF808A]/20 text-xs text-[var(--text-main)] flex items-center justify-between">
      <span>✨ <strong>Feature Preview:</strong> Persistent profiles are coming in a future update. RandomChat currently operates 100% anonymous & guest-only.</span>
      <a href="/" class="text-[#FF808A] font-bold underline ml-2 shrink-0">Back to Chat</a>
    </div>

    <!-- Profile Card -->
    <div class="rounded-3xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 sm:p-10 shadow-sm flex flex-col gap-8">
      <!-- Profile Header -->
      <div class="flex flex-col sm:flex-row items-center sm:items-start justify-between gap-4 border-b border-[var(--border-subtle)] pb-6 text-center sm:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div class="w-20 h-20 rounded-3xl gradient-accent flex items-center justify-center text-white text-3xl font-black shadow-md">
            R
          </div>
          <div class="flex flex-col gap-1">
            <h1 class="text-2xl font-black text-[var(--text-main)]">
              RandomUser123
            </h1>
            <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              <span>Available to Chat</span>
            </div>
          </div>
        </div>

        <a
          href="/profile/edit"
          class="px-4 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-page)] hover:bg-[var(--bg-surface-elevated)] text-xs font-bold text-[var(--text-main)] transition-colors"
        >
          Edit Profile
        </a>
      </div>

      <!-- About Me Section -->
      <div class="flex flex-col gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">About Me</span>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed bg-[var(--bg-page)] p-4 rounded-2xl border border-[var(--border-subtle)]">
          Passionate about open-source technology, indie sci-fi movies, and ambient electronic music. Always happy to chat about creative projects and good book recommendations.
        </p>
      </div>

      <!-- Basic Info Grid -->
      <div class="flex flex-col gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">Basic Info</span>
        <div class="grid grid-cols-3 gap-3">
          <div class="p-3.5 rounded-2xl bg-[var(--bg-page)] border border-[var(--border-subtle)] text-center">
            <span class="text-[10px] text-[var(--text-subtle)] block">Gender</span>
            <span class="text-xs font-bold text-[var(--text-main)] mt-0.5 block">Male</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-[var(--bg-page)] border border-[var(--border-subtle)] text-center">
            <span class="text-[10px] text-[var(--text-subtle)] block">Age</span>
            <span class="text-xs font-bold text-[var(--text-main)] mt-0.5 block">24</span>
          </div>
          <div class="p-3.5 rounded-2xl bg-[var(--bg-page)] border border-[var(--border-subtle)] text-center">
            <span class="text-[10px] text-[var(--text-subtle)] block">Country</span>
            <span class="text-xs font-bold text-[var(--text-main)] mt-0.5 block">United States</span>
          </div>
        </div>
      </div>

      <!-- Skills & Talents Section -->
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)] flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#6C4DFF]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
            </svg>
            Skills & Talents
          </span>
          <span class="text-[10px] font-semibold text-[#6C4DFF] bg-[#6C4DFF]/10 px-2 py-0.5 rounded-full">Top Competencies</span>
        </div>
        <div id="profile-skills-list" class="flex flex-wrap gap-2">
          {['TypeScript', 'UI/UX Design', 'Astro', 'Tailwind CSS', 'Sound Design'].map(skill => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#6C4DFF]/10 border border-[#6C4DFF]/25 text-xs font-bold text-[#6C4DFF] dark:text-[#A78BFA] shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-[#6C4DFF]"></span>
              {skill}
            </span>
          ))}
        </div>
      </div>

      <!-- Interests Tags -->
      <div class="flex flex-col gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">Interests</span>
        <div class="flex flex-wrap gap-2">
          {['Technology', 'Music', 'Travel', 'Fitness', 'Cinema'].map(tag => (
            <span class="px-3 py-1 rounded-full bg-[var(--bg-page)] border border-[var(--border-color)] text-xs font-semibold text-[var(--text-muted)]">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Languages -->
      <div class="flex flex-col gap-2">
        <span class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-subtle)]">Languages</span>
        <div class="flex gap-2">
          <span class="px-3 py-1 rounded-full bg-[var(--bg-page)] border border-[var(--border-color)] text-xs font-semibold text-[var(--text-muted)]">
            English
          </span>
          <span class="px-3 py-1 rounded-full bg-[var(--bg-page)] border border-[var(--border-color)] text-xs font-semibold text-[var(--text-muted)]">
            Spanish
          </span>
        </div>
      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  // Hydrate profile data from localStorage if available
  try {
    const savedSkills = localStorage.getItem('randomchat_profile_skills');
    if (savedSkills) {
      const skills = JSON.parse(savedSkills);
      const container = document.getElementById('profile-skills-list');
      if (container && Array.isArray(skills) && skills.length > 0) {
        container.innerHTML = skills.map((s: string) => `
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-[#6C4DFF]/10 border border-[#6C4DFF]/25 text-xs font-bold text-[#6C4DFF] dark:text-[#A78BFA] shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-[#6C4DFF]"></span>
            ${s}
          </span>
        `).join('');
      }
    }

    const savedUsername = localStorage.getItem('randomchat_profile_username');
    if (savedUsername) {
      const h1 = document.querySelector('h1');
      if (h1) h1.textContent = savedUsername;
    }

    const savedBio = localStorage.getItem('randomchat_profile_bio');
    if (savedBio) {
      const bioEl = document.querySelector('main p');
      if (bioEl) bioEl.textContent = savedBio;
    }
  } catch (err) {
    console.error('Failed to load profile from localStorage:', err);
  }
</script>
