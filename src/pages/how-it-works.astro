---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const lang = 'en';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "How It Works",
      "item": `${siteConfig.url}/how-it-works`
    }
  ]
};
---

<BaseLayout
  title={`How It Works — ${siteConfig.name}`}
  description={`Learn how ${siteConfig.name} pairs you with compatible strangers for instant, ephemeral 1-on-1 text conversations.`}
  canonical={`${siteConfig.url}/how-it-works`}
  lang={lang}
>
  <!-- Breadcrumb Schema for Search Rich Results -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <LandingNavbar lang={lang} />

  <main id="main-content" tabindex="-1" class="flex-1 w-full max-w-4xl mx-auto px-4 py-12 flex flex-col gap-12 outline-none">
    <!-- Hero Intro -->
    <div class="text-center max-w-2xl mx-auto flex flex-col items-center gap-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold">
        <Icon name="sliders" class="w-3.5 h-3.5" />
        <span>Simple &bull; Instant &bull; Anonymous</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-[var(--text-primary)] tracking-tight">
        How {siteConfig.name} Works
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
        Connect with someone new in four effortless steps. No downloads, no passwords, and no personal profiles.
      </p>
    </div>

    <!-- 4 Step Progression Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Step 01 -->
      <div class="card-tactile p-6 flex flex-col gap-4 text-left">
        <div class="flex items-center justify-between">
          <div class="w-11 h-11 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center shadow-xs">
            <Icon name="users" class="w-5 h-5" />
          </div>
          <span class="text-3xl font-black text-[var(--border-strong)]">01</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Choose Persona & Preferences</h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Pick a temporary nickname and specify your preferred conversation scope or topic room. No email or password needed.
          </p>
        </div>
      </div>

      <!-- Step 02 -->
      <div class="card-tactile p-6 flex flex-col gap-4 text-left">
        <div class="flex items-center justify-between">
          <div class="w-11 h-11 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center shadow-xs">
            <Icon name="zap" class="w-5 h-5" />
          </div>
          <span class="text-3xl font-black text-[var(--border-strong)]">02</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Instant Mutual Match</h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Our pairing engine connects you with an active user whose preferences mutually align with yours in under 2 seconds.
          </p>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="card-tactile p-6 flex flex-col gap-4 text-left">
        <div class="flex items-center justify-between">
          <div class="w-11 h-11 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center shadow-xs">
            <Icon name="message-square" class="w-5 h-5" />
          </div>
          <span class="text-3xl font-black text-[var(--border-strong)]">03</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Engage in Private Chat</h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Enjoy low-latency, encrypted real-time chat. Anti-spam cold gates ensure conversations remain mutually active and respectful.
          </p>
        </div>
      </div>

      <!-- Step 04 -->
      <div class="card-tactile p-6 flex flex-col gap-4 text-left">
        <div class="flex items-center justify-between">
          <div class="w-11 h-11 rounded-xl bg-[var(--primary)] text-white flex items-center justify-center shadow-xs">
            <Icon name="arrow-right" class="w-5 h-5" />
          </div>
          <span class="text-3xl font-black text-[var(--border-strong)]">04</span>
        </div>
        <div class="flex flex-col gap-1.5">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">Next Stranger Anytime</h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Whenever you are ready, tap "Next Stranger" to immediately leave the room, purge session RAM, and find a fresh conversation partner.
          </p>
        </div>
      </div>
    </div>

    <!-- Core Pillars Feature Box -->
    <div class="card-tactile p-8 flex flex-col gap-6 text-left">
      <h2 class="text-2xl font-bold text-[var(--text-primary)]">
        The Principles Behind {siteConfig.name}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs sm:text-sm text-[var(--text-secondary)]">
        <div class="flex flex-col gap-1.5">
          <span class="font-bold text-[var(--text-primary)] text-base">Zero Friction</span>
          <p class="leading-relaxed">No email confirmations, phone numbers, or passwords. Start chatting in seconds.</p>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="font-bold text-[var(--text-primary)] text-base">Ephemeral Privacy</span>
          <p class="leading-relaxed">Messages exist only in RAM while active and vanish as soon as either participant leaves.</p>
        </div>
        <div class="flex flex-col gap-1.5">
          <span class="font-bold text-[var(--text-primary)] text-base">Community Safety</span>
          <p class="leading-relaxed">18+ adult policy, active rate limiting, anti-spam gates, and 1-click report & block tools.</p>
        </div>
      </div>
    </div>

    <!-- Call to Action Banner -->
    <div class="card-tactile p-8 sm:p-12 text-center flex flex-col items-center gap-4 shadow-xl">
      <h2 class="text-2xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        Ready to Meet Someone New?
      </h2>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] max-w-md leading-relaxed">
        Join hundreds of active conversationalists right now without signing up.
      </p>
      <a
        href="/start"
        class="btn-primary text-base py-3.5 px-8 shadow-md"
      >
        <span>Start Chatting Now</span>
        <Icon name="arrow-right" class="w-5 h-5" />
      </a>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
