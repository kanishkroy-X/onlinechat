<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DNS Configuration UI</title>
    <style is:global>
      :root {
        --bg: #f5f5f4;
        --panel: #ffffff;
        --line: #dfe2e5;
        --line-soft: #eaebed;
        --text: #1f2937;
        --text-soft: #6b7280;
        --text-faint: #8a939e;
        --primary: #2f80ed;
        --toggle: #e5e7eb;
        --success: #1d9b5c;
        --success-soft: #dff2e7;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, "Segoe UI", sans-serif;
      }

      body {
        display: flex;
        justify-content: center;
        padding: 24px 0 60px;
      }

      .app-shell {
        width: min(1360px, calc(100vw - 80px));
      }

      .top-row {
        display: flex;
        align-items: center;
        gap: 26px;
        padding-left: 8px;
        min-height: 44px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        color: var(--text);
      }

      .status-pill .dot {
        width: 14px;
        height: 14px;
        display: inline-block;
        border-radius: 50%;
        position: relative;
        background: var(--success-soft);
      }

      .status-pill .dot::before {
        content: "";
        position: absolute;
        inset: 3px;
        border-radius: 50%;
        background: var(--success);
      }

      .status-pill.locked .dot {
        background: #eff1f4;
      }

      .status-pill.locked .dot::before {
        background: #6b7280;
      }

      .status-pill.locked .dot::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 4px;
        width: 6px;
        height: 6px;
        transform: translateX(-50%);
        border-radius: 2px 2px 3px 3px;
        background: #6b7280;
      }

      .tabs {
        position: relative;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding-top: 4px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .tab-button {
        appearance: none;
        border: 1px solid transparent;
        background: transparent;
        border-radius: 6px 6px 0 0;
        padding: 12px 16px 10px;
        color: var(--text);
        font-size: 15px;
        cursor: pointer;
      }

      .tab-button.active {
        background: rgba(148, 163, 184, 0.08);
        border-color: var(--line);
        border-bottom-color: transparent;
        box-shadow: inset 0 -1px 0 var(--panel);
      }

      .panel {
        display: none;
        padding: 32px 0 0;
      }

      .panel.active {
        display: block;
      }

      .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
      }

      .section-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
      }

      .section-header p {
        margin: 12px 0 0;
        color: var(--text-soft);
        font-size: 18px;
      }

      .primary-button {
        appearance: none;
        border: 0;
        background: linear-gradient(180deg, #4b9af7 0%, #2d7ef0 100%);
        color: #fff;
        border-radius: 8px;
        padding: 11px 20px;
        font-size: 15px;
        font-weight: 600;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,0.12);
        cursor: pointer;
      }

      .toolbar {
        display: grid;
        grid-template-columns: minmax(320px, 1.65fr) minmax(200px, 1fr) minmax(200px, 1fr) 56px;
        gap: 0;
        margin-top: 12px;
        border: 1px solid var(--line);
        border-radius: 10px 10px 0 0;
        overflow: hidden;
      }

      .searchbox,
      .selectbox,
      .mini-button {
        background: var(--panel);
        border: 1px solid var(--line);
        min-height: 48px;
        display: flex;
        align-items: center;
        padding: 0 14px;
      }

      .searchbox {
        border-right: 0;
        border-radius: 10px 0 0 0;
      }

      .searchbox .icon {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        color: var(--text-faint);
      }

      .searchbox input {
        border: 0;
        outline: none;
        background: transparent;
        width: 100%;
        font-size: 15px;
        color: var(--text);
      }

      .selectbox {
        justify-content: space-between;
        font-size: 15px;
        color: var(--text);
        border-left: 0;
      }

      .selectbox .chev {
        color: var(--text-soft);
        font-size: 18px;
      }

      .mini-button {
        width: 48px;
        justify-content: center;
        border-left: 0;
        border-radius: 0 10px 0 0;
        color: var(--text-soft);
      }

      .table-wrap {
        border: 1px solid var(--line);
        border-top: none;
        border-radius: 0 0 10px 10px;
        background: var(--panel);
        overflow: hidden;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      th, td {
        text-align: left;
        padding: 14px 18px;
        border-bottom: 1px solid var(--line-soft);
      }

      th {
        font-size: 15px;
        color: var(--text-soft);
        font-weight: 600;
        background: rgba(148, 163, 184, 0.04);
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      td {
        font-size: 15px;
        color: var(--text);
      }

      .email-tag {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 6px;
        background: rgba(59, 130, 246, 0.08);
        color: var(--text);
      }

      .tag {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 80px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 13px;
        line-height: 1.3;
        font-weight: 700;
      }

      .tag.verified {
        background: #1f2937;
        color: #fff;
      }

      .status-toggle {
        display: inline-flex;
        align-items: center;
        gap: 12px;
      }

      .switch {
        position: relative;
        width: 42px;
        height: 22px;
        background: var(--toggle);
        border-radius: 999px;
        border: 1px solid rgba(17,24,39,0.08);
        transition: background 0.2s ease;
      }

      .switch::before {
        content: "";
        position: absolute;
        top: 2px;
        left: 2px;
        width: 16px;
        height: 16px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.2);
        transition: transform 0.2s ease;
      }

      .switch.on {
        background: var(--primary);
      }

      .switch.on::before {
        transform: translateX(20px);
      }

      .row-actions {
        display: flex;
        justify-content: flex-end;
        color: var(--text-faint);
        font-size: 18px;
      }

      .footer-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 18px;
        color: var(--text-soft);
        font-size: 14px;
      }

      .pager {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .pager button {
        width: 34px;
        height: 30px;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 6px;
        color: var(--text-soft);
        cursor: pointer;
      }

      .pager .page-number {
        width: 34px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 6px;
        color: var(--text);
        font-weight: 600;
      }

      .input-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--line-soft);
      }

      .input-row input {
        flex: 1;
        min-width: 0;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 8px;
        min-height: 42px;
        padding: 0 14px;
        font-size: 15px;
        color: var(--text);
      }

      .settings-section {
        display: flex;
        flex-direction: column;
        gap: 18px;
        margin-top: 14px;
      }

      .settings-box {
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 10px;
        padding: 18px 18px 14px;
      }

      .settings-box .row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }

      .settings-box h3 {
        margin: 0 0 10px;
        font-size: 18px;
      }

      .settings-box p {
        margin: 0;
        color: var(--text-soft);
        font-size: 15px;
      }

      .locked-box {
        margin-top: 24px;
      }

      .table-card {
        margin-top: 18px;
        border: 1px solid var(--line);
        border-radius: 10px;
        overflow: hidden;
        background: var(--panel);
      }

      .table-card table th,
      .table-card table td {
        padding: 16px 18px;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 84px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
      }

      .status-badge.locked {
        background: #f3f4f6;
        color: #6b7280;
      }

      .status-badge.unlocked {
        background: rgba(16, 185, 129, 0.11);
        color: #0a9a69;
      }

      .secondary-button {
        appearance: none;
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 8px;
        padding: 9px 14px;
        font-size: 15px;
        color: var(--text);
        cursor: pointer;
      }

      @media (max-width: 900px) {
        .app-shell { width: min(100vw - 30px, 1360px); }
        .toolbar { grid-template-columns: 1fr; }
        .searchbox, .selectbox, .mini-button { border-left: 1px solid var(--line); border-right: 1px solid var(--line); }
        .tabs { overflow-x: auto; }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <div class="top-row" aria-label="Service state">
        <div class="status-pill"><span class="dot"></span><span>Enabled</span></div>
        <div class="status-pill locked"><span class="dot"></span><span>Locked</span></div>
      </div>

      <nav class="tabs" aria-label="DNS settings sections">
        <button class="tab-button" type="button" data-tab="Overview">Overview</button>
        <button class="tab-button" type="button" data-tab="Activity Log">Activity Log</button>
        <button class="tab-button active" type="button" data-tab="Routing rules">Routing rules</button>
        <button class="tab-button" type="button" data-tab="Destination Addresses">Destination Addresses</button>
        <button class="tab-button" type="button" data-tab="Destination Workers">Destination Workers</button>
        <button class="tab-button" type="button" data-tab="Settings">Settings</button>
      </nav>

      <main>
        <section class="panel" data-panel="Overview">
          <div class="section-header">
            <div>
              <h2>Overview</h2>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="Activity Log">
          <div class="section-header">
            <div>
              <h2>Activity Log</h2>
            </div>
          </div>
        </section>

        <section class="panel active" data-panel="Routing rules">
          <div class="section-header">
            <div>
              <h2>Routing rules</h2>
              <p>Create routing rules and set the action to take on received emails.</p>
            </div>
            <button class="primary-button" type="button">+ Create routing rule</button>
          </div>

          <div class="toolbar" role="search">
            <div class="searchbox">
              <span class="icon">⌕</span>
              <input aria-label="Search routing rules" placeholder="Search" />
            </div>
            <div class="selectbox">
              <span>All domains</span>
              <span class="chev">⌃</span>
            </div>
            <div class="selectbox">
              <span>All actions</span>
              <span class="chev">⌃</span>
            </div>
            <div class="mini-button" aria-label="Refresh">↻</div>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Routing rule</th>
                  <th>Action</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>✦ Catch-all</td>
                  <td><span class="tag" style="background:#f3f4f6;color:#4b5563;">Drop</span></td>
                  <td>
                    <div class="status-toggle">
                      <span class="switch" aria-label="Disabled"></span>
                      <span style="color:var(--text-soft);">Disabled</span>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>hello@randomcaht.online</td>
                  <td><span class="email-tag">✉️ kanishkroy09@gmail.com</span></td>
                  <td>
                    <div class="status-toggle">
                      <span class="switch on" aria-label="Active"></span>
                      <span style="color:var(--text);">Active</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="footer-meta">
            <span>Showing 1 - 1 of 1</span>
            <div class="pager" aria-label="Pagination">
              <button type="button">«</button>
              <button type="button">‹</button>
              <span class="page-number">1</span>
              <button type="button">›</button>
              <button type="button">»</button>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="Destination Addresses">
          <div class="section-header">
            <div>
              <h2>Destination Address</h2>
              <p>Destination addresses are shared across every zone on this account. Manage the address list here, then use a verified address as the target of a routing rule for this zone.</p>
            </div>
          </div>

          <div class="toolbar" role="search">
            <div class="searchbox">
              <span class="icon">⌕</span>
              <input aria-label="Search destination addresses" placeholder="Search" />
            </div>
            <div class="selectbox">
              <span>All</span>
              <span class="chev">⌃</span>
            </div>
            <div class="mini-button" aria-label="Refresh">↻</div>
          </div>

          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Email Address</th>
                  <th>Status</th>
                  <th>Created</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>kanishkroy09@gmail.com</td>
                  <td><span class="tag verified">Verified</span></td>
                  <td>12 hours ago</td>
                  <td class="row-actions">⋯</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="footer-meta">
            <span>Showing 1 - 1 of 1</span>
            <div class="pager" aria-label="Pagination">
              <button type="button">«</button>
              <button type="button">‹</button>
              <span class="page-number">1</span>
              <button type="button">›</button>
              <button type="button">»</button>
            </div>
          </div>

          <div class="input-row">
            <input type="email" aria-label="Add destination email" placeholder="user@example.com" />
            <button class="primary-button" type="button">Add address</button>
          </div>
        </section>

        <section class="panel" data-panel="Destination Workers">
          <div class="section-header">
            <div>
              <h2>Destination Workers</h2>
            </div>
          </div>
        </section>

        <section class="panel" data-panel="Settings">
          <div class="settings-section">
            <div class="settings-box">
              <div class="row">
                <div>
                  <h3>Subaddressing</h3>
                  <p>Use the '+' separator to add detail to addresses matched by your routing rules (address+detail@example.com).</p>
                </div>
                <div class="status-toggle">
                  <span class="switch" aria-label="Enable subaddressing"></span>
                </div>
              </div>
            </div>

            <div class="settings-box locked-box">
              <div class="row">
                <div>
                  <h3>DNS records</h3>
                  <p>DNS records associated with this service.</p>
                </div>
                <button class="secondary-button" type="button">🔓 Unlock</button>
              </div>

              <div class="table-card">
                <table>
                  <thead>
                    <tr>
                      <th>Type</th>
                      <th>Hostname</th>
                      <th>Priority</th>
                      <th>Value</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>MX</td>
                      <td>randomcaht.online</td>
                      <td>65</td>
                      <td>route1.mx.cloudflare.net</td>
                      <td><span class="status-badge locked">Locked</span></td>
                    </tr>
                    <tr>
                      <td>MX</td>
                      <td>randomcaht.online</td>
                      <td>3</td>
                      <td>route2.mx.cloudflare.net</td>
                      <td><span class="status-badge locked">Locked</span></td>
                    </tr>
                    <tr>
                      <td>MX</td>
                      <td>randomcaht.online</td>
                      <td>33</td>
                      <td>route3.mx.cloudflare.net</td>
                      <td><span class="status-badge locked">Locked</span></td>
                    </tr>
                    <tr>
                      <td>TXT</td>
                      <td>cf2024-1._domainkey.randomcaht.online</td>
                      <td></td>
                      <td>"v=DKIM1; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A..."</td>
                      <td><span class="status-badge locked">Locked</span></td>
                    </tr>
                    <tr>
                      <td>TXT</td>
                      <td>randomcaht.online</td>
                      <td></td>
                      <td>"v=spf1 include:_spf.mx.cloudflare.net ~all"</td>
                      <td><span class="status-badge unlocked">Unlocked</span></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <script>
      const tabButtons = document.querySelectorAll('.tab-button');
      const tabPanels = document.querySelectorAll('.panel');

      tabButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const target = button.dataset.tab;
          tabButtons.forEach((btn) => btn.classList.toggle('active', btn === button));
          tabPanels.forEach((panel) => panel.classList.toggle('active', panel.dataset.panel === target));
        });
      });
    </script>
  </body>
</html>
