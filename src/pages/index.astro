---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingHero from '../components/LandingHero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SafetyTrust from '../components/SafetyTrust.astro';
import SetupModal from '../components/SetupModal.astro';
import MatchingView from '../components/MatchingView.astro';
import ChatView from '../components/ChatView.astro';
import DisconnectNotice from '../components/DisconnectNotice.astro';
import Modals from '../components/Modals.astro';

export const prerender = false;

const currentLang = Astro.cookies.get('rc_language')?.value || Astro.url.searchParams.get('lang') || 'en';
---

<BaseLayout lang={currentLang}>
  <Header lang={currentLang} />

  <main id="app-main" class="flex-1 flex flex-col w-full relative">
    <!-- Landing State -->
    <div id="landing-view" class="w-full flex flex-col">
      <LandingHero lang={currentLang} />
      <HowItWorks lang={currentLang} />
      <SafetyTrust lang={currentLang} />
    </div>

    <!-- Active Interactive States -->
    <MatchingView lang={currentLang} />
    <ChatView lang={currentLang} />
    <DisconnectNotice lang={currentLang} />
  </main>

  <!-- Modals & Overlays -->
  <SetupModal lang={currentLang} />
  <Modals lang={currentLang} />

  <div id="footer-container">
    <Footer lang={currentLang} />
  </div>

  <!-- Interactive Client State Script -->
  <script>
    import { ChatClient } from '../scripts/chatClient';
    import { validateNickname } from '../server/sanitizer';
    import type { Gender, MatchPreference, Country, Language, ReportReason } from '../server/types';
    import { COUNTRY_NAMES, LANGUAGE_NAMES } from '../server/constants';

    const client = new ChatClient();

    // DOM Elements
    const landingView = document.getElementById('landing-view');
    const matchingView = document.getElementById('matching-view');
    const chatView = document.getElementById('chat-view');
    const disconnectView = document.getElementById('disconnect-view');
    const setupModal = document.getElementById('setup-modal');
    const footerContainer = document.getElementById('footer-container');

    // Hero / Triggers
    const heroStartBtn = document.getElementById('hero-start-btn');
    const setupCloseBtn = document.getElementById('setup-close-btn');
    const setupForm = document.getElementById('setup-form') as HTMLFormElement;
    const nicknameInput = document.getElementById('setup-nickname') as HTMLInputElement;
    const nicknameError = document.getElementById('setup-nickname-error');
    const matchingCancelBtn = document.getElementById('matching-cancel-btn');
    const matchingPrefDisplay = document.getElementById('matching-pref-display');

    // Chat elements
    const chatStrangerNick = document.getElementById('chat-stranger-nick');
    const chatStrangerAvatar = document.getElementById('chat-stranger-avatar');
    const chatStrangerGender = document.getElementById('chat-stranger-gender');
    const chatStrangerCountry = document.getElementById('chat-stranger-country');
    const chatStrangerLanguage = document.getElementById('chat-stranger-language');
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input') as HTMLInputElement;
    const chatSendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement;
    const chatComposerForm = document.getElementById('chat-composer-form') as HTMLFormElement;
    const coldGateBanner = document.getElementById('cold-gate-banner');
    const chatTypingIndicator = document.getElementById('chat-typing-indicator');
    const chatNextBtn = document.getElementById('chat-next-btn');
    const chatMenuBtn = document.getElementById('chat-menu-btn');
    const chatDropdown = document.getElementById('chat-dropdown');

    // Attachment & Lightbox Elements
    const chatFileInput = document.getElementById('chat-file-input') as HTMLInputElement;
    const chatAttachBtn = document.getElementById('chat-attach-btn');
    const chatMediaPreviewContainer = document.getElementById('chat-media-preview-container');
    const chatImagePreview = document.getElementById('chat-image-preview') as HTMLImageElement;
    const chatVideoPreview = document.getElementById('chat-video-preview') as HTMLVideoElement;
    const chatMediaName = document.getElementById('chat-media-name');
    const chatRemoveMediaBtn = document.getElementById('chat-remove-media-btn');
    const chatLightbox = document.getElementById('chat-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    let currentAttachedMedia: { type: 'image' | 'video'; data: string; name: string } | null = null;

    // Modals
    const modalNext = document.getElementById('modal-next');
    const modalNextCancel = document.getElementById('modal-next-cancel');
    const modalNextConfirm = document.getElementById('modal-next-confirm');

    const modalLeave = document.getElementById('modal-leave');
    const modalLeaveCancel = document.getElementById('modal-leave-cancel');
    const modalLeaveConfirm = document.getElementById('modal-leave-confirm');
    const menuLeaveBtn = document.getElementById('menu-leave-btn');

    const modalReport = document.getElementById('modal-report');
    const modalReportClose = document.getElementById('modal-report-close');
    const modalReportCancel = document.getElementById('modal-report-cancel');
    const reportForm = document.getElementById('report-form') as HTMLFormElement;
    const reportReasonSelect = document.getElementById('report-reason-select') as HTMLSelectElement;
    const reportDetailsInput = document.getElementById('report-details-input') as HTMLTextAreaElement;
    const menuReportBtn = document.getElementById('menu-report-btn');

    const modalBlock = document.getElementById('modal-block');
    const modalBlockCancel = document.getElementById('modal-block-cancel');
    const modalBlockConfirm = document.getElementById('modal-block-confirm');
    const menuBlockBtn = document.getElementById('menu-block-btn');

    const disconnectFindBtn = document.getElementById('disconnect-find-btn');
    const disconnectHomeBtn = document.getElementById('disconnect-home-btn');

    // Form state
    let selectedGender: Gender = 'male';
    let selectedPreference: MatchPreference = 'anyone';
    let selectedCountry: string = 'anywhere';
    let selectedLanguage: string = 'any';

    // UI State Switcher
    function updateUI(c: ChatClient) {
      // Hide all main state views
      landingView?.classList.add('hidden');
      matchingView?.classList.add('hidden');
      chatView?.classList.add('hidden');
      disconnectView?.classList.add('hidden');

      if (c.state === 'LANDING') {
        landingView?.classList.remove('hidden');
        footerContainer?.classList.remove('hidden');
        setupModal?.classList.add('hidden');
      } else if (c.state === 'SETUP') {
        landingView?.classList.remove('hidden');
        setupModal?.classList.remove('hidden');
        nicknameInput?.focus();
      } else if (c.state === 'MATCHING') {
        matchingView?.classList.remove('hidden');
        footerContainer?.classList.add('hidden');
        setupModal?.classList.add('hidden');

        // Show Finding Radar, hide Match Found card
        const matchingRadarContainer = document.getElementById('matching-radar-container');
        const matchFoundContainer = document.getElementById('match-found-container');
        matchingRadarContainer?.classList.remove('hidden');
        matchFoundContainer?.classList.add('hidden');

        if (matchingPrefDisplay) matchingPrefDisplay.textContent = c.preference;
        const matchingCountryDisplay = document.getElementById('matching-country-display');
        const matchingLanguageDisplay = document.getElementById('matching-language-display');
        const matchingPrefDetails = document.getElementById('matching-pref-details');
        if (matchingCountryDisplay && c.country && c.country !== 'anywhere') {
          matchingCountryDisplay.textContent = COUNTRY_NAMES[c.country] || c.country;
          matchingCountryDisplay.classList.remove('hidden');
        } else if (matchingCountryDisplay) {
          matchingCountryDisplay.classList.add('hidden');
        }
        if (matchingLanguageDisplay && c.language && c.language !== 'any') {
          matchingLanguageDisplay.textContent = LANGUAGE_NAMES[c.language] || c.language;
          matchingLanguageDisplay.classList.remove('hidden');
        } else if (matchingLanguageDisplay) {
          matchingLanguageDisplay.classList.add('hidden');
        }
        if (matchingPrefDetails) {
          const hasDetails = (c.country && c.country !== 'anywhere') || (c.language && c.language !== 'any');
          if (hasDetails) {
            matchingPrefDetails.classList.remove('hidden');
          } else {
            matchingPrefDetails.classList.add('hidden');
          }
        }
      } else if (c.state === 'MATCH_FOUND') {
        // MATCH FOUND SEQUENCE (500-700ms animation of avatars gliding together)
        matchingView?.classList.remove('hidden');
        chatView?.classList.add('hidden');
        footerContainer?.classList.add('hidden');
        setupModal?.classList.add('hidden');

        const matchingRadarContainer = document.getElementById('matching-radar-container');
        const matchFoundContainer = document.getElementById('match-found-container');
        const matchFoundStrangerLetter = document.getElementById('match-found-stranger-letter');
        const matchFoundStrangerName = document.getElementById('match-found-stranger-name');

        matchingRadarContainer?.classList.add('hidden');
        matchFoundContainer?.classList.remove('hidden');

        const partnerName = c.partner?.nickname || 'Stranger';
        if (matchFoundStrangerLetter) matchFoundStrangerLetter.textContent = partnerName.charAt(0).toUpperCase();
        if (matchFoundStrangerName) matchFoundStrangerName.textContent = partnerName;

        // Automatically slide into chat view after short celebration
        const matchStartBtn = document.getElementById('match-found-start-btn');
        if (matchStartBtn) {
          matchStartBtn.onclick = () => {
            c.setState('CONNECTED');
          };
        }
        setTimeout(() => {
          if (c.state === 'MATCH_FOUND') {
            c.setState('CONNECTED');
          }
        }, 800);
      } else if (c.state === 'CONNECTING' || c.state === 'CONNECTED') {
        matchingView?.classList.add('hidden');
        chatView?.classList.remove('hidden');
        footerContainer?.classList.add('hidden');
        setupModal?.classList.add('hidden');

        const partnerName = c.partner?.nickname || 'Stranger';
        if (chatStrangerNick) chatStrangerNick.textContent = partnerName;
        if (chatStrangerAvatar) chatStrangerAvatar.textContent = partnerName.charAt(0).toUpperCase();
        if (chatStrangerGender) chatStrangerGender.textContent = c.partner?.gender || 'Anyone';

        // Right sidebar sync
        const sideStrangerAvatar = document.getElementById('side-stranger-avatar');
        const sideStrangerNick = document.getElementById('side-stranger-nick');
        const sideStrangerLoc = document.getElementById('side-stranger-loc');
        const voicePartnerName = document.getElementById('voice-partner-name');

        if (sideStrangerAvatar) sideStrangerAvatar.textContent = partnerName.charAt(0).toUpperCase();
        if (sideStrangerNick) sideStrangerNick.textContent = partnerName;
        if (voicePartnerName) voicePartnerName.textContent = partnerName;

        const locText = c.partner?.country && c.partner.country !== 'anywhere'
          ? `24 yrs, ${COUNTRY_NAMES[c.partner.country] || c.partner.country}`
          : '24 yrs, California, USA';
        if (sideStrangerLoc) sideStrangerLoc.textContent = locText;

        if (chatStrangerCountry) {
          if (c.partner?.country && c.partner.country !== 'anywhere') {
            chatStrangerCountry.textContent = COUNTRY_NAMES[c.partner.country] || c.partner.country;
            chatStrangerCountry.classList.remove('hidden');
          } else {
            chatStrangerCountry.classList.add('hidden');
          }
        }
        if (chatStrangerLanguage) {
          if (c.partner?.language && c.partner.language !== 'any') {
            chatStrangerLanguage.textContent = LANGUAGE_NAMES[c.partner.language] || c.partner.language;
            chatStrangerLanguage.classList.remove('hidden');
          } else {
            chatStrangerLanguage.classList.add('hidden');
          }
        }

        renderMessages(c);
        renderColdGate(c);

        if (chatMessages) {
          chatMessages.classList.remove('animate-slide-left-out');
          chatMessages.classList.add('animate-slide-right-in');
        }

        if (c.isPartnerTyping) {
          chatTypingIndicator?.classList.remove('hidden');
        } else {
          chatTypingIndicator?.classList.add('hidden');
        }
      } else if (c.state === 'DISCONNECTED') {
        disconnectView?.classList.remove('hidden');
        footerContainer?.classList.remove('hidden');
        setupModal?.classList.add('hidden');
      } else if (c.state === 'RATE_LIMITED' || c.state === 'ERROR') {
        alert(c.errorMessage || 'An error occurred.');
        c.setState('LANDING');
      }
    }

    function renderMessages(c: ChatClient) {
      if (!chatMessages) return;

      // Keep welcome banner and append new messages
      const existingCount = chatMessages.querySelectorAll('.message-bubble').length;
      if (existingCount === c.messages.length) return;

      // Re-render message list
      const welcome = chatMessages.firstElementChild;
      chatMessages.innerHTML = '';
      if (welcome) chatMessages.appendChild(welcome);

      c.messages.forEach(msg => {
        const isMe = msg.sender === 'me';
        const wrapper = document.createElement('div');
        wrapper.className = `message-bubble flex flex-col ${isMe ? 'items-end' : 'items-start'} gap-1.5 max-w-[85%] sm:max-w-[75%] ${isMe ? 'self-end' : 'self-start'} animate-bubble-in`;

        const bubble = document.createElement('div');
        bubble.className = isMe
          ? 'p-2.5 rounded-2xl bg-[var(--bubble-me)] text-[var(--bubble-me-text)] rounded-tr-xs border border-[var(--border-subtle)] text-sm shadow-sm flex flex-col gap-2'
          : 'p-2.5 rounded-2xl bg-[var(--bubble-stranger)] text-[var(--bubble-stranger-text)] rounded-tl-xs border border-[var(--border-color)] text-sm shadow-sm flex flex-col gap-2';

        // Render Media if present
        if (msg.mediaData) {
          if (msg.mediaType === 'video') {
            const videoEl = document.createElement('video');
            videoEl.src = msg.mediaData;
            videoEl.controls = true;
            videoEl.className = 'max-w-full rounded-xl max-h-60 object-contain bg-black';
            bubble.appendChild(videoEl);
          } else {
            const imgEl = document.createElement('img');
            imgEl.src = msg.mediaData;
            imgEl.alt = 'Shared photo';
            imgEl.className = 'max-w-full rounded-xl max-h-60 object-cover cursor-pointer hover:opacity-95 transition-opacity';
            imgEl.addEventListener('click', () => {
              if (lightboxImg && chatLightbox) {
                lightboxImg.src = msg.mediaData!;
                chatLightbox.classList.remove('hidden');
              }
            });
            bubble.appendChild(imgEl);
          }
        }

        // Render Text if present
        if (msg.text) {
          const textSpan = document.createElement('span');
          textSpan.className = 'px-1 leading-relaxed';
          textSpan.textContent = msg.text;
          bubble.appendChild(textSpan);
        }

        wrapper.appendChild(bubble);
        chatMessages.appendChild(wrapper);
      });

      chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function renderColdGate(c: ChatClient) {
      if (c.isColdGated) {
        coldGateBanner?.classList.remove('hidden');
        if (chatSendBtn) chatSendBtn.disabled = true;
      } else {
        coldGateBanner?.classList.add('hidden');
        if (chatSendBtn) chatSendBtn.disabled = false;
      }
    }

    client.subscribe(updateUI);

    // Landing Triggers
    heroStartBtn?.addEventListener('click', () => {
      client.startSetup();
    });

    setupCloseBtn?.addEventListener('click', () => {
      client.cancelSetup();
    });

    // Gender selection
    document.querySelectorAll('.gender-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const target = e.currentTarget as HTMLButtonElement;
        const g = target.dataset.gender as Gender;
        if (!g) return;
        selectedGender = g;
        document.querySelectorAll('.gender-btn').forEach(b => {
          b.className = 'gender-btn py-2.5 px-4 rounded-xl text-sm font-semibold transition-all text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer';
        });
        target.className = 'gender-btn py-2.5 px-4 rounded-xl text-sm font-semibold transition-all text-white gradient-accent shadow-sm cursor-pointer';
      });
    });

    // Preference selection
    document.querySelectorAll('.pref-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const target = e.currentTarget as HTMLButtonElement;
        const p = target.dataset.pref as MatchPreference;
        if (!p) return;
        selectedPreference = p;
        document.querySelectorAll('.pref-btn').forEach(b => {
          b.className = 'pref-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-[var(--text-muted)] hover:text-[var(--text-main)] cursor-pointer';
        });
        target.className = 'pref-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-white gradient-accent shadow-sm cursor-pointer';
      });
    });

    const countrySelect = document.getElementById('setup-country') as HTMLSelectElement;
    const languageSelect = document.getElementById('setup-language') as HTMLSelectElement;

    if (countrySelect) {
      selectedCountry = countrySelect.value;
      countrySelect.addEventListener('change', () => {
        selectedCountry = countrySelect.value;
      });
    }

    if (languageSelect) {
      selectedLanguage = languageSelect.value;
      languageSelect.addEventListener('change', () => {
        selectedLanguage = languageSelect.value;
      });
    }

    // Setup Submit
    setupForm?.addEventListener('submit', e => {
      e.preventDefault();
      const rawNick = nicknameInput.value;
      const validation = validateNickname(rawNick);
      if (!validation.isValid || !validation.sanitizedValue) {
        if (nicknameError) {
          nicknameError.textContent = validation.error || 'Invalid nickname';
          nicknameError.classList.remove('hidden');
        }
        return;
      }
      if (nicknameError) nicknameError.classList.add('hidden');

      client.enterQueue(validation.sanitizedValue, selectedGender, selectedPreference, selectedCountry, selectedLanguage);
    });

    // Matching Cancel
    matchingCancelBtn?.addEventListener('click', () => {
      client.cancelQueue();
    });

    // Gallery File Attachment handling
    chatAttachBtn?.addEventListener('click', () => {
      chatFileInput?.click();
    });

    chatFileInput?.addEventListener('change', () => {
      const file = chatFileInput.files?.[0];
      if (!file) return;

      // Validate file size (max 5MB)
      if (file.size > 5 * 1024 * 1024) {
        alert('File is too large. Please select a photo or video under 5MB.');
        chatFileInput.value = '';
        return;
      }

      const isVideo = file.type.startsWith('video/');
      const reader = new FileReader();

      reader.onload = e => {
        const dataUrl = e.target?.result as string;
        currentAttachedMedia = {
          type: isVideo ? 'video' : 'image',
          data: dataUrl,
          name: file.name
        };

        if (chatMediaPreviewContainer && chatMediaName) {
          chatMediaName.textContent = file.name;
          chatMediaPreviewContainer.classList.remove('hidden');

          if (isVideo && chatVideoPreview) {
            chatVideoPreview.src = dataUrl;
            chatVideoPreview.classList.remove('hidden');
            chatImagePreview?.classList.add('hidden');
          } else if (chatImagePreview) {
            chatImagePreview.src = dataUrl;
            chatImagePreview.classList.remove('hidden');
            chatVideoPreview?.classList.add('hidden');
          }
        }
      };

      reader.readAsDataURL(file);
    });

    function clearAttachedMedia() {
      currentAttachedMedia = null;
      if (chatFileInput) chatFileInput.value = '';
      if (chatMediaPreviewContainer) chatMediaPreviewContainer.classList.add('hidden');
      if (chatImagePreview) chatImagePreview.src = '';
      if (chatVideoPreview) chatVideoPreview.src = '';
    }

    chatRemoveMediaBtn?.addEventListener('click', clearAttachedMedia);

    // Lightbox Close
    lightboxClose?.addEventListener('click', () => {
      chatLightbox?.classList.add('hidden');
    });
    chatLightbox?.addEventListener('click', e => {
      if (e.target === chatLightbox) {
        chatLightbox.classList.add('hidden');
      }
    });

    // Chat Message Sending
    chatComposerForm?.addEventListener('submit', e => {
      e.preventDefault();
      const text = chatInput ? chatInput.value : '';
      const media = currentAttachedMedia;

      if (!text.trim() && !media) return;

      const sent = client.sendMessage(text, media?.type, media?.data);
      if (sent) {
        if (chatInput) chatInput.value = '';
        clearAttachedMedia();
      }
    });

    chatInput?.addEventListener('input', () => {
      client.notifyTyping();
    });

    // Dropdown toggle
    chatMenuBtn?.addEventListener('click', () => {
      chatDropdown?.classList.toggle('hidden');
    });

    document.addEventListener('click', e => {
      if (chatDropdown && !chatDropdown.contains(e.target as Node) && e.target !== chatMenuBtn) {
        chatDropdown.classList.add('hidden');
      }
    });

    // Next Stranger Modal
    chatNextBtn?.addEventListener('click', () => {
      modalNext?.classList.remove('hidden');
    });
    modalNextCancel?.addEventListener('click', () => {
      modalNext?.classList.add('hidden');
    });
    modalNextConfirm?.addEventListener('click', () => {
      modalNext?.classList.add('hidden');
      if (chatMessages) {
        chatMessages.classList.add('animate-slide-left-out');
        setTimeout(() => {
          client.nextStranger();
        }, 220);
      } else {
        client.nextStranger();
      }
    });

    // Leave Modal
    menuLeaveBtn?.addEventListener('click', () => {
      chatDropdown?.classList.add('hidden');
      modalLeave?.classList.remove('hidden');
    });
    modalLeaveCancel?.addEventListener('click', () => {
      modalLeave?.classList.add('hidden');
    });
    modalLeaveConfirm?.addEventListener('click', () => {
      modalLeave?.classList.add('hidden');
      client.leaveChat();
    });

    // Report Modal
    menuReportBtn?.addEventListener('click', () => {
      chatDropdown?.classList.add('hidden');
      modalReport?.classList.remove('hidden');
    });
    modalReportClose?.addEventListener('click', () => {
      modalReport?.classList.add('hidden');
    });
    modalReportCancel?.addEventListener('click', () => {
      modalReport?.classList.add('hidden');
    });
    reportForm?.addEventListener('submit', e => {
      e.preventDefault();
      const reason = reportReasonSelect.value as ReportReason;
      const details = reportDetailsInput.value;
      client.submitReport(reason, details);
      modalReport?.classList.add('hidden');
      alert('Report submitted. Thank you.');
    });

    // Block Modal
    menuBlockBtn?.addEventListener('click', () => {
      chatDropdown?.classList.add('hidden');
      modalBlock?.classList.remove('hidden');
    });
    modalBlockCancel?.addEventListener('click', () => {
      modalBlock?.classList.add('hidden');
    });
    modalBlockConfirm?.addEventListener('click', () => {
      modalBlock?.classList.add('hidden');
      client.blockStranger();
    });

    // Disconnect Actions
    disconnectFindBtn?.addEventListener('click', () => {
      client.enterQueue(client.nickname, client.gender, client.preference, client.country, client.language);
    });
    disconnectHomeBtn?.addEventListener('click', () => {
      client.setState('LANDING');
    });

    // Voice Call Interactive Audio-Reactive Modal
    const voiceModal = document.getElementById('voice-call-modal');
    const voiceTimer = document.getElementById('voice-call-timer');
    const voiceMuteBtn = document.getElementById('voice-mute-btn');
    const voiceSpeakerBtn = document.getElementById('voice-speaker-btn');
    const voiceEndBtn = document.getElementById('voice-end-btn');
    const voiceMutedBadge = document.getElementById('voice-muted-badge');
    const ring1 = document.getElementById('voice-ring-1');
    const ring2 = document.getElementById('voice-ring-2');
    const ring3 = document.getElementById('voice-ring-3');
    const centerOrb = document.getElementById('voice-center-orb');
    const chatVoiceCallBtn = document.getElementById('chat-voice-call-btn');
    const quickVoiceBtn = document.getElementById('quick-voice-btn');
    const menuVoiceBtn = document.getElementById('menu-voice-btn');
    const chatMobileVoiceBtn = document.getElementById('chat-mobile-voice-btn');

    let voiceInterval: number | null = null;
    let voiceSeconds = 0;
    let isMuted = false;
    let isSpeakerOn = true;
    let audioCtx: AudioContext | null = null;
    let audioStream: MediaStream | null = null;
    let animationFrameId: number | null = null;

    async function startAudioVisualizer() {
      try {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
          audioStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
          const source = audioCtx.createMediaStreamSource(audioStream);
          const analyser = audioCtx.createAnalyser();
          analyser.fftSize = 64;
          source.connect(analyser);

          const dataArray = new Uint8Array(analyser.frequencyBinCount);

          function renderFrame() {
            if (!voiceModal || voiceModal.classList.contains('hidden')) return;
            animationFrameId = requestAnimationFrame(renderFrame);

            if (isMuted) {
              if (ring1) ring1.style.transform = 'scale(1)';
              if (ring2) ring2.style.transform = 'scale(1)';
              if (ring3) ring3.style.transform = 'scale(1)';
              if (centerOrb) centerOrb.style.transform = 'scale(1)';
              return;
            }

            analyser.getByteFrequencyData(dataArray);
            let sum = 0;
            for (let i = 0; i < dataArray.length; i++) {
              sum += dataArray[i];
            }
            const average = sum / dataArray.length;
            const boost = Math.min(1 + (average / 128) * 0.35, 1.45);

            if (ring1) ring1.style.transform = `scale(${boost * 1.05})`;
            if (ring2) ring2.style.transform = `scale(${boost * 1.15})`;
            if (ring3) ring3.style.transform = `scale(${boost * 1.25})`;
            if (centerOrb) centerOrb.style.transform = `scale(${1 + (average / 128) * 0.15})`;
          }
          renderFrame();
        }
      } catch (err) {
        // Fallback subtle ambient animation if microphone is disabled
      }
    }

    function stopAudioVisualizer() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (audioStream) {
        audioStream.getTracks().forEach(t => t.stop());
        audioStream = null;
      }
      if (audioCtx) {
        audioCtx.close();
        audioCtx = null;
      }
      if (ring1) ring1.style.transform = 'scale(1)';
      if (ring2) ring2.style.transform = 'scale(1)';
      if (ring3) ring3.style.transform = 'scale(1)';
      if (centerOrb) centerOrb.style.transform = 'scale(1)';
    }

    function openVoiceModal() {
      if (chatDropdown) chatDropdown.classList.add('hidden');
      voiceModal?.classList.remove('hidden');
      voiceSeconds = 0;
      isMuted = false;
      voiceMutedBadge?.classList.add('hidden');
      if (voiceTimer) voiceTimer.textContent = '00:00';
      if (voiceInterval) clearInterval(voiceInterval);
      voiceInterval = window.setInterval(() => {
        voiceSeconds++;
        const mins = String(Math.floor(voiceSeconds / 60)).padStart(2, '0');
        const secs = String(voiceSeconds % 60).padStart(2, '0');
        if (voiceTimer) voiceTimer.textContent = `${mins}:${secs}`;
      }, 1000);

      startAudioVisualizer();
    }

    function closeVoiceModal() {
      voiceModal?.classList.add('hidden');
      if (voiceInterval) {
        clearInterval(voiceInterval);
        voiceInterval = null;
      }
      stopAudioVisualizer();
    }

    chatVoiceCallBtn?.addEventListener('click', openVoiceModal);
    quickVoiceBtn?.addEventListener('click', openVoiceModal);
    menuVoiceBtn?.addEventListener('click', openVoiceModal);
    chatMobileVoiceBtn?.addEventListener('click', openVoiceModal);
    voiceEndBtn?.addEventListener('click', closeVoiceModal);

    voiceMuteBtn?.addEventListener('click', () => {
      isMuted = !isMuted;
      voiceMuteBtn.classList.toggle('bg-red-500/20', isMuted);
      voiceMuteBtn.classList.toggle('text-red-400', isMuted);
      if (isMuted) {
        voiceMutedBadge?.classList.remove('hidden');
      } else {
        voiceMutedBadge?.classList.add('hidden');
      }
    });

    voiceSpeakerBtn?.addEventListener('click', () => {
      isSpeakerOn = !isSpeakerOn;
      voiceSpeakerBtn.classList.toggle('opacity-50', !isSpeakerOn);
    });

    // Emoji Picker Popover
    const emojiToggleBtn = document.getElementById('chat-emoji-toggle-btn');
    const emojiPopover = document.getElementById('chat-emoji-popover');

    emojiToggleBtn?.addEventListener('click', () => {
      emojiPopover?.classList.toggle('hidden');
    });

    document.querySelectorAll('.chat-emoji-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const emoji = (e.currentTarget as HTMLElement).textContent?.trim();
        if (emoji && chatInput) {
          chatInput.value += emoji;
          chatInput.focus();
        }
      });
    });

    // Quick Actions
    const quickShareInterestBtn = document.getElementById('quick-share-interest-btn');
    const menuInterestsBtn = document.getElementById('menu-interests-btn');
    const quickClearBtn = document.getElementById('quick-clear-btn');
    const menuClearBtn = document.getElementById('menu-clear-btn');

    function shareInterests() {
      if (chatDropdown) chatDropdown.classList.add('hidden');
      const interestMsg = "Hey! I'm interested in music, gaming, movies & tech. What about you? ✨";
      client.sendMessage(interestMsg);
    }

    function clearChatHistory() {
      if (chatDropdown) chatDropdown.classList.add('hidden');
      client.clearMessages();
    }

    quickShareInterestBtn?.addEventListener('click', shareInterests);
    menuInterestsBtn?.addEventListener('click', shareInterests);
    quickClearBtn?.addEventListener('click', clearChatHistory);
    menuClearBtn?.addEventListener('click', clearChatHistory);

    // Bottom action bar buttons
    document.getElementById('bottom-report-btn')?.addEventListener('click', () => {
      modalReport?.classList.remove('hidden');
    });
    document.getElementById('bottom-block-btn')?.addEventListener('click', () => {
      modalBlock?.classList.remove('hidden');
    });

    // Left Sidebar Filter & Search
    const countryFilter = document.getElementById('chat-sidebar-country-filter') as HTMLSelectElement;
    const searchInput = document.getElementById('chat-sidebar-search') as HTMLInputElement;
    const usersList = document.getElementById('chat-online-users-list');

    function filterOnlineUsers() {
      if (!usersList) return;
      const query = (searchInput?.value || '').toLowerCase().trim();
      const countryVal = countryFilter?.value || 'all';

      Array.from(usersList.children).forEach(child => {
        const text = child.textContent?.toLowerCase() || '';
        const matchesQuery = !query || text.includes(query);
        const matchesCountry = countryVal === 'all' || text.includes(countryVal) || countryVal === 'all';
        (child as HTMLElement).style.display = matchesQuery && matchesCountry ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterOnlineUsers);
    countryFilter?.addEventListener('change', filterOnlineUsers);

    // Mobile Drawers Toggle
    const leftPaneToggle = document.getElementById('chat-toggle-left-pane-btn');
    const rightPaneToggle = document.getElementById('chat-toggle-right-pane-btn');
    const leftSidebar = document.getElementById('chat-left-sidebar');
    const rightSidebar = document.getElementById('chat-right-sidebar');

    leftPaneToggle?.addEventListener('click', () => {
      leftSidebar?.classList.toggle('hidden');
      leftSidebar?.classList.toggle('flex');
    });

    rightPaneToggle?.addEventListener('click', () => {
      rightSidebar?.classList.toggle('hidden');
      rightSidebar?.classList.toggle('flex');
    });
  </script>
</BaseLayout>
