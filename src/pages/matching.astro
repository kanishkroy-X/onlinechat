---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const lang = 'en';
---

<BaseLayout
  title={`Finding Someone... — ${siteConfig.name}`}
  description="Searching for a mutually compatible stranger to chat with in real-time."
  canonical={`${siteConfig.url}/matching`}
  lang={lang}
  noindex={true}
>
  <LandingNavbar lang={lang} />

  <main class="flex-1 w-full max-w-md mx-auto px-4 py-12 flex flex-col items-center justify-center text-center">
    <div class="w-full card-tactile p-8 sm:p-10 shadow-2xl flex flex-col items-center gap-6 animate-modal-in">
      <!-- Radar Pulse -->
      <div class="relative w-28 h-28 flex items-center justify-center my-2">
        <div class="absolute inset-0 rounded-full bg-[var(--primary-soft)] animate-ping opacity-30"></div>
        <div class="w-14 h-14 rounded-full bg-[var(--primary)] text-white flex items-center justify-center shadow-md z-10">
          <Icon name="refresh-cw" class="w-6 h-6 animate-spin" />
        </div>
      </div>

      <!-- Text Status -->
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-black text-[var(--text-primary)] tracking-tight">
          Finding someone...
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] max-w-xs leading-relaxed">
          Searching for an active compatible stranger to start a private text chat with.
        </p>
      </div>

      <!-- Criteria Badge -->
      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--text-muted)] bg-[var(--bg-surface-elevated)] px-4 py-2 rounded-xl border border-[var(--border)]">
        <span>Looking for:</span>
        <span class="text-[var(--text-primary)] capitalize">Anyone</span>
      </div>

      <!-- Cancel Action -->
      <a
        href="/"
        class="btn-secondary text-xs py-2.5 px-5"
      >
        Cancel Matchmaking
      </a>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
