---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getTranslations } from '../i18n/translations';

const lang = 'en';
const t = getTranslations(lang);
---

<BaseLayout
  title="Finding Someone... — randomcaht.online"
  description="Searching for a mutually compatible stranger to chat with in real-time."
  canonical="https://randomcaht.online/matching"
  lang={lang}
>
  <Header lang={lang} />

  <main class="flex-1 w-full max-w-md mx-auto px-4 py-12 flex flex-col items-center justify-center text-center">
    <div class="w-full bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-3xl p-8 sm:p-10 shadow-2xl flex flex-col items-center gap-6 animate-modal-in relative overflow-hidden">
      <!-- Background Ambient Glow -->
      <div class="absolute -top-10 -right-10 w-40 h-40 bg-[#FF808A]/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Sunset System v2: Central Glowing Orb & Concentric Ripple Waves -->
      <div class="relative w-36 h-36 flex items-center justify-center my-4">
        <div class="absolute inset-0 rounded-full sunset-ripple-ring"></div>
        <div class="absolute inset-0 rounded-full sunset-ripple-ring" style="animation-delay: 1000ms;"></div>
        <div class="absolute inset-0 rounded-full sunset-ripple-ring" style="animation-delay: 2000ms;"></div>
        
        <div class="w-14 h-14 rounded-full sunset-radar-orb flex items-center justify-center text-white z-10 animate-float-slow">
          <div class="w-4 h-4 rounded-full bg-[#FFBF92] blur-[2px] opacity-90"></div>
        </div>
      </div>

      <!-- Text Status -->
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl font-extrabold text-[var(--text-main)] tracking-tight">
          Finding someone...
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-muted)] max-w-xs">
          Searching for a compatible stranger to start a private text chat with.
        </p>
      </div>

      <!-- Criteria Badge -->
      <div class="flex items-center gap-2 text-xs font-semibold text-[var(--text-subtle)] bg-[var(--bg-page)] px-4 py-2 rounded-xl border border-[var(--border-color)]">
        <span>Looking for:</span>
        <span class="text-[var(--text-main)] capitalize">Anyone</span>
      </div>

      <!-- Cancel Action -->
      <a
        href="/"
        class="text-xs sm:text-sm font-semibold text-[var(--text-muted)] hover:text-red-500 py-2 px-5 rounded-xl border border-transparent hover:border-red-500/20 transition-all cursor-pointer"
      >
        Cancel Matchmaking
      </a>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
