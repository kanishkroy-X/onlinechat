---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const lang = 'en';
---

<BaseLayout
  title={`Cookie Policy — ${siteConfig.name}`}
  description={`Read how ${siteConfig.name} uses minimal cookies and ephemeral session data to provide a safe, anonymous text chat experience.`}
  canonical={`${siteConfig.url}/cookie-policy`}
  lang={lang}
>
  <LandingNavbar lang={lang} />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-12">
    <div class="card-tactile p-6 sm:p-10 shadow-sm flex flex-col gap-8 text-left">
      <!-- Page Header -->
      <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
          <Icon name="shield-check" class="w-3.5 h-3.5" />
          <span>Legal & Transparency</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
          Cookie Policy
        </h1>
        <p class="text-xs text-[var(--text-muted)]">
          Last Updated: February 2026 &bull; {siteConfig.name}
        </p>
      </div>

      <!-- Content Sections -->
      <div class="max-w-none text-sm text-[var(--text-secondary)] space-y-6 leading-relaxed">
        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">1. Introduction</h2>
          <p>
            At <strong>{siteConfig.name}</strong>, we believe privacy is a fundamental human right. Our platform is designed to be anonymous-by-default with zero account registration, no passwords, and no permanent chat history. This Cookie Policy explains what minimal storage technologies we use and why.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">2. What Technologies We Use</h2>
          <p>
            We use minimal client-side <code>localStorage</code> and session tokens exclusively to remember your chosen theme (Light/Dark mode), user language preference, and maintain active temporary WebSocket connections while you chat.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">3. Categories of Storage We Use</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
            <div class="p-5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[var(--success)]"></span>
                <h3 class="font-bold text-sm text-[var(--text-primary)]">Strictly Necessary (Essential)</h3>
              </div>
              <p class="text-xs text-[var(--text-secondary)]">
                Required for core chat functionality: managing your anonymous session token and maintaining active matchmaking queue status. These do not track identity.
              </p>
            </div>

            <div class="p-5 rounded-xl border border-[var(--border)] bg-[var(--bg-surface-elevated)] flex flex-col gap-2">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-[var(--primary)]"></span>
                <h3 class="font-bold text-sm text-[var(--text-primary)]">Preferences & Theme</h3>
              </div>
              <p class="text-xs text-[var(--text-secondary)]">
                Stores your chosen UI mode (Light/Dark) and language preference on your local device so your display preference is remembered across page views.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">4. Zero Third-Party Advertising Cookies</h2>
          <p>
            We do <strong>not</strong> use third-party advertising cookies, cross-site trackers, or behavioral profiling scripts.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">5. Questions & Contact</h2>
          <p>
            For any questions regarding our Cookie Policy, contact us at <a href={`mailto:${siteConfig.supportEmail}`} class="text-[var(--primary)] font-semibold underline">{siteConfig.supportEmail}</a>.
          </p>
        </section>
      </div>

      <div class="pt-4 border-t border-[var(--border)]">
        <a href="/" class="font-semibold text-[var(--primary)] hover:underline">&larr; Back to Home</a>
      </div>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
