---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const currentLang = Astro.cookies?.get('rc_language')?.value || Astro.url?.searchParams?.get('lang') || 'en';

const voiceFaqItems = [
  {
    q: "How does anonymous random voice chat work?",
    a: "Random Voice Chat connects you in a peer-to-peer WebRTC audio call with a compatible stranger worldwide. You can hear their voice live with ultra-low latency without revealing phone numbers, emails, or personal details."
  },
  {
    q: "Does RandomChat record or store my voice calls?",
    a: "No. Under our Engineering Constitution (CLAUDE.md & SECURITY_GAPS.md), voice audio is streamed peer-to-peer with zero server recordings or audio logging. Your audio stream is 100% ephemeral."
  },
  {
    q: "When is microphone permission requested?",
    a: "We strictly follow explicit consent guardrails. Your browser will only request microphone access when you actively choose to start or join a voice conversation."
  },
  {
    q: "Can I mute my microphone or end the voice call at any time?",
    a: "Yes. The live voice control bar gives you instant, 1-click controls to Mute/Unmute your microphone, toggle speaker, or End the call and switch back to text chat."
  }
];
---

<BaseLayout
  title={`Random Voice Chat — Ephemeral 1-on-1 Voice Calling with Strangers | ${siteConfig.name}`}
  description="Talk live with friendly strangers worldwide in peer-to-peer WebRTC voice chat. Crystal-clear audio, zero voice recording, 100% free."
  canonical={`${siteConfig.url}/random-voice-chat`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 w-full flex flex-col items-center">
    <!-- Hero Section -->
    <section class="w-full py-16 sm:py-24 px-4 max-w-5xl mx-auto flex flex-col items-center text-center gap-8">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold tracking-wide">
        <Icon name="phone" class="w-3.5 h-3.5" />
        <span>P2P WebRTC HD Audio &bull; Zero Server Recordings</span>
      </div>

      <!-- Main Headline -->
      <div class="flex flex-col gap-4 max-w-3xl">
        <h1 class="text-4xl sm:text-6xl font-black text-[var(--text-primary)] tracking-tight leading-[1.1]">
          Random Voice Chat with Strangers Worldwide.
        </h1>
        <p class="text-base sm:text-xl text-[var(--text-secondary)] leading-relaxed max-w-2xl mx-auto">
          Hear real voices, share laughter, and practice languages with genuine people. Powered by secure WebRTC audio with zero audio retention.
        </p>
      </div>

      <!-- Primary Action Island Button -->
      <div class="flex flex-col sm:flex-row items-center gap-4 pt-2">
        <a
          href="/start"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-base shadow-lg hover:shadow-emerald-500/25 transition-all duration-300 active:scale-[0.98]"
        >
          <span>Start Voice Chat</span>
          <span class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center transition-transform group-hover:translate-x-1">
            <Icon name="arrow-right" class="w-4 h-4 text-white" />
          </span>
        </a>
        <a
          href="/random-text-chat"
          class="px-6 py-4 rounded-full border border-[var(--border)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-elevated)] text-[var(--text-primary)] font-bold text-sm transition-colors"
        >
          Switch to Text Chat &rarr;
        </a>
      </div>
    </section>

    <!-- Voice Chat Feature Bento Grid -->
    <section class="w-full py-16 px-4 bg-[var(--bg-surface-elevated)] border-y border-[var(--border)]">
      <div class="max-w-5xl mx-auto flex flex-col gap-10">
        <div class="text-center flex flex-col gap-2 max-w-xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)]">Audio Engineered for Privacy & Clarity</h2>
          <p class="text-sm text-[var(--text-secondary)]">State-of-the-art WebRTC audio engine with intelligent noise suppression and echo cancellation.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-2 rounded-[2rem] bg-black/5 dark:bg-white/5 border border-[var(--border)] ring-1 ring-black/5">
            <div class="h-full p-6 rounded-[calc(2rem-0.5rem)] bg-[var(--bg-surface)] flex flex-col gap-4 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold">
                <Icon name="volume-2" class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-[var(--text-primary)]">Ultra-Low Latency</h3>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                Direct peer-to-peer audio connection with STUN fallback ensures real-time speech without stuttering or audio lag.
              </p>
            </div>
          </div>

          <div class="p-2 rounded-[2rem] bg-black/5 dark:bg-white/5 border border-[var(--border)] ring-1 ring-black/5">
            <div class="h-full p-6 rounded-[calc(2rem-0.5rem)] bg-[var(--bg-surface)] flex flex-col gap-4 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold">
                <Icon name="shield-check" class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-[var(--text-primary)]">Zero Voice Recording</h3>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                Your calls are never stored, transcribed, or monitored on central servers. Complete acoustic privacy from end to end.
              </p>
            </div>
          </div>

          <div class="p-2 rounded-[2rem] bg-black/5 dark:bg-white/5 border border-[var(--border)] ring-1 ring-black/5">
            <div class="h-full p-6 rounded-[calc(2rem-0.5rem)] bg-[var(--bg-surface)] flex flex-col gap-4 shadow-sm">
              <div class="w-12 h-12 rounded-2xl bg-rose-500/10 text-rose-500 flex items-center justify-center font-bold">
                <Icon name="phone-off" class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-[var(--text-primary)]">1-Click End & Block</h3>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                Instant call disconnect and safety controls right at your fingertips. If a conversation turns unpleasant, exit immediately.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="w-full py-16 px-4 max-w-4xl mx-auto flex flex-col gap-10">
      <div class="text-center flex flex-col gap-2">
        <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)]">Voice Chat FAQ</h2>
        <p class="text-sm text-[var(--text-secondary)]">Frequently asked questions regarding anonymous voice calling on {siteConfig.name}.</p>
      </div>

      <div class="flex flex-col gap-4">
        {voiceFaqItems.map((item) => (
          <div class="p-6 rounded-2xl border border-[var(--border)] bg-[var(--bg-surface)] flex flex-col gap-2 shadow-xs">
            <h3 class="font-bold text-base text-[var(--text-primary)] flex items-center gap-2">
              <span class="text-emerald-500">Q:</span> {item.q}
            </h3>
            <p class="text-sm text-[var(--text-secondary)] leading-relaxed pl-6">
              {item.a}
            </p>
          </div>
        ))}
      </div>

      <div class="p-8 rounded-[2rem] bg-emerald-600 text-white flex flex-col sm:flex-row items-center justify-between gap-6 mt-8 shadow-xl">
        <div class="flex flex-col gap-1 text-center sm:text-left">
          <h3 class="text-2xl font-black">Ready to speak with someone new?</h3>
          <p class="text-xs text-white/80">Connect immediately over crystal-clear WebRTC voice.</p>
        </div>
        <a
          href="/start"
          class="px-8 py-3.5 rounded-full bg-white text-emerald-600 font-bold text-sm shadow-md hover:bg-slate-100 transition-colors shrink-0"
        >
          Start Voice Chat Now &rarr;
        </a>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": voiceFaqItems.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />

  <LandingFooter />
</BaseLayout>
