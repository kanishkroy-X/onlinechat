---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getTranslations } from '../../i18n/translations';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { topic: 'general' }, props: { title: 'General Chat', desc: 'Open conversations about everyday life, thoughts, and casual discussions.', icon: '💬', related: ['technology', 'movies', 'music'] } },
    { params: { topic: 'technology' }, props: { title: 'Technology', desc: 'Discuss AI, software, hardware, programming, gadgets, and tech news.', icon: '💻', related: ['gaming', 'study', 'general'] } },
    { params: { topic: 'gaming' }, props: { title: 'Gaming', desc: 'Talk about PC, console, esports, indie games, and your favorite walkthroughs.', icon: '🎮', related: ['technology', 'anime', 'movies'] } },
    { params: { topic: 'music' }, props: { title: 'Music', desc: 'Share song recommendations, favorite artists, albums, and instruments.', icon: '🎵', related: ['movies', 'photography', 'general'] } },
    { params: { topic: 'movies' }, props: { title: 'Movies & TV', desc: 'Discussions around cinema, trending series, classic films, and reviews.', icon: '🎬', related: ['music', 'anime', 'books'] } },
    { params: { topic: 'sports' }, props: { title: 'Sports', desc: 'Football, basketball, cricket, athletics, and major sporting tournaments.', icon: '⚽', related: ['fitness', 'travel', 'general'] } },
    { params: { topic: 'fitness' }, props: { title: 'Fitness & Health', desc: 'Workouts, nutrition, wellness, training routines, and healthy habits.', icon: '🏃', related: ['sports', 'study', 'general'] } },
    { params: { topic: 'travel' }, props: { title: 'Travel & Cultures', desc: 'Stories from different cities, travel itineraries, cultures, and wanderlust.', icon: '✈️', related: ['photography', 'sports', 'books'] } },
    { params: { topic: 'books' }, props: { title: 'Books & Literature', desc: 'Book club discussions, sci-fi novels, philosophy, and poetry.', icon: '📚', related: ['study', 'movies', 'general'] } },
    { params: { topic: 'anime' }, props: { title: 'Anime & Manga', desc: 'Seasonal anime releases, favorite series, manga chapters, and adaptations.', icon: '✨', related: ['gaming', 'movies', 'books'] } },
    { params: { topic: 'study' }, props: { title: 'Study & Career', desc: 'Academic motivation, study techniques, productivity, and career growth.', icon: '🎓', related: ['technology', 'books', 'general'] } },
    { params: { topic: 'photography' }, props: { title: 'Photography & Art', desc: 'Camera gear, digital art, visual aesthetics, and creative projects.', icon: '📷', related: ['travel', 'music', 'technology'] } }
  ];
}

interface Props {
  title: string;
  desc: string;
  icon: string;
  related: string[];
}

const { topic } = Astro.params;
const { title = 'Chat Topic', desc = 'Explore conversations around this topic.', icon = '💬', related = ['general', 'technology'] } = Astro.props;
const lang = 'en';
const t = getTranslations(lang);
---

<BaseLayout
  title={`${title} Chat — randomcaht.online`}
  description={`Join ${title.toLowerCase()} conversations on RandomChat. Meet strangers who share your passion for ${title.toLowerCase()}.`}
  canonical={`https://randomcaht.online/chat-rooms/${topic}`}
  lang={lang}
>
  <Header lang={lang} />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-12 flex flex-col gap-10">
    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 text-xs text-[var(--text-subtle)]">
      <a href="/" class="hover:underline">Home</a>
      <span>&rsaquo;</span>
      <a href="/chat-rooms" class="hover:underline">Chat Topics</a>
      <span>&rsaquo;</span>
      <span class="text-[var(--text-main)] font-semibold">{title}</span>
    </div>

    <!-- Main Topic Banner -->
    <div class="rounded-3xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-8 sm:p-12 shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left relative overflow-hidden">
      <!-- Ambient Glow -->
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#FF808A]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="w-20 h-20 rounded-3xl gradient-accent flex items-center justify-center text-4xl text-white shadow-lg shrink-0">
        {icon}
      </div>

      <div class="flex flex-col gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FF808A]/10 text-[#FF808A] text-xs font-bold w-fit mx-auto sm:mx-0">
          Featured Topic
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-main)] tracking-tight">
          {title} Chat
        </h1>
        <p class="text-sm sm:text-base text-[var(--text-muted)] max-w-xl leading-relaxed">
          {desc}
        </p>

        <!-- CTA & Coming Soon Status -->
        <div class="pt-4 flex flex-col sm:flex-row items-center gap-4">
          <a
            href="/start"
            class="gradient-accent gradient-accent-hover text-white font-bold text-sm px-6 py-3 rounded-xl shadow-md hover:shadow-lg transition-all flex items-center gap-2"
          >
            <span>Start Random Chat</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <span class="text-xs text-[var(--text-subtle)] italic">
            Dedicated persistent topic rooms are coming soon.
          </span>
        </div>
      </div>
    </div>

    <!-- Related Topics -->
    <div class="flex flex-col gap-4">
      <h2 class="text-xl font-bold text-[var(--text-main)]">
        Related Conversation Topics
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {related.map(rel => (
          <a
            href={`/chat-rooms/${rel}`}
            class="p-4 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] hover:border-[#D55882]/40 text-xs font-semibold text-[var(--text-main)] capitalize flex items-center justify-between transition-colors"
          >
            <span>{rel}</span>
            <span class="text-[#FF808A]">&rarr;</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Safety Reminder -->
    <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5 text-xs text-[var(--text-muted)] flex items-start gap-3">
      <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      </svg>
      <p class="leading-relaxed">
        <strong>Community Guidelines:</strong> Keep discussions respectful and fun. Never share private credentials, financial information, or real-life coordinates in public chats.
      </p>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
