---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatView from '../components/ChatView.astro';
import Modals from '../components/Modals.astro';
import MatchingView from '../components/MatchingView.astro';
import { getTranslations } from '../i18n/translations';
import { siteConfig } from '../config/site';

const lang = 'en';
const t = getTranslations(lang);
---

<BaseLayout
  title={`1 on 1 Chat — ${siteConfig.name}`}
  description="Real-time anonymous 1 on 1 chat with strangers. Free, private, zero registration required."
  canonical={`${siteConfig.url}/chat`}
  lang={lang}
  noindex={true}
>
  <main class="flex-1 w-full flex flex-col items-center justify-center p-0 min-h-[100dvh] bg-[#F0F2F5] dark:bg-[#0B0D13]">
    <!-- Matching State Overlay -->
    <div id="standalone-matching-container" class="hidden w-full justify-center">
      <MatchingView lang={lang} />
    </div>

    <!-- Mobile-Optimized 1-on-1 Chat View (Chatib Aesthetic) -->
    <ChatView lang={lang} />
  </main>

  <Modals lang={lang} />
</BaseLayout>

<script>
  import { ChatClient } from '../scripts/chatClient';
  import type { Gender, MatchPreference, Country, Language, ReportReason } from '../server/types';
  import { COUNTRY_NAMES, LANGUAGE_NAMES } from '../server/constants';

  const params = new URLSearchParams(window.location.search);
  const urlNick = params.get('nick');
  const urlGender = params.get('gender') as Gender;
  const urlPref = params.get('pref') as MatchPreference;

  const strangerProfiles = [
    { name: 'Arnob29', bio: 'Male, 29 Yrs, West Bengal, India' },
    { name: 'Priya_K', bio: 'Female, 24 Yrs, Mumbai, India' },
    { name: 'Alex_V', bio: 'Male, 26 Yrs, California, United States' },
    { name: 'Sophia_99', bio: 'Female, 22 Yrs, London, United Kingdom' },
    { name: 'Rohan_M', bio: 'Male, 28 Yrs, New Delhi, India' },
    { name: 'Elena_R', bio: 'Female, 25 Yrs, Toronto, Canada' },
    { name: 'David_X', bio: 'Male, 31 Yrs, Sydney, Australia' },
    { name: 'Zara_Sky', bio: 'Female, 23 Yrs, Berlin, Germany' }
  ];

  let currentProfile = strangerProfiles[Math.floor(Math.random() * strangerProfiles.length)];

  const nick = urlNick || localStorage.getItem('rc_nickname') || ('Stranger' + Math.floor(1000 + Math.random() * 9000));
  const gender = urlGender || ((localStorage.getItem('rc_gender') || 'male') as Gender);
  let pref = urlPref || ((localStorage.getItem('rc_pref') || 'anyone') as MatchPreference);
  const country = (localStorage.getItem('rc_country') || 'anywhere') as Country;
  const language = (localStorage.getItem('rc_language') || 'any') as Language;

  localStorage.setItem('rc_nickname', nick);
  localStorage.setItem('rc_gender', gender);
  localStorage.setItem('rc_pref', pref);
  localStorage.setItem('rc_age_verified_18', 'true');

  const client = new ChatClient();

  // Audio Synth for Sound Effects
  let soundEnabled = true;
  function playSound(type: 'send' | 'receive' | 'star') {
    if (!soundEnabled) return;
    try {
      const audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'send') {
        osc.frequency.setValueAtTime(480, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.1);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.1);
      } else if (type === 'receive') {
        osc.frequency.setValueAtTime(750, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1100, audioCtx.currentTime + 0.12);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.12);
      } else if (type === 'star') {
        osc.frequency.setValueAtTime(523.25, audioCtx.currentTime); // C5
        osc.frequency.setValueAtTime(659.25, audioCtx.currentTime + 0.08); // E5
        osc.frequency.setValueAtTime(783.99, audioCtx.currentTime + 0.16); // G5
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + 0.25);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.25);
      }
    } catch (e) {
      // Audio not supported or blocked by user gesture policy
    }
  }

  // DOM Elements
  const chatStrangerNick = document.getElementById('chat-stranger-nick');
  const chatStrangerBio = document.getElementById('chat-stranger-bio');
  const chatMessages = document.getElementById('chat-messages');
  const chatInput = document.getElementById('chat-input') as HTMLInputElement;
  const chatSendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement;
  const chatComposerForm = document.getElementById('chat-composer-form') as HTMLFormElement;
  const coldGateBanner = document.getElementById('cold-gate-banner');
  const chatTypingIndicator = document.getElementById('chat-typing-indicator');
  const chatMenuBtn = document.getElementById('chat-menu-btn');
  const chatDropdown = document.getElementById('chat-dropdown');

  // Sound Toggle
  const chatSoundToggleBtn = document.getElementById('chat-sound-toggle-btn');
  const soundIconOn = document.getElementById('sound-icon-on');
  const soundIconOff = document.getElementById('sound-icon-off');

  chatSoundToggleBtn?.addEventListener('click', () => {
    soundEnabled = !soundEnabled;
    if (soundEnabled) {
      soundIconOn?.classList.remove('hidden');
      soundIconOff?.classList.add('hidden');
      playSound('send');
    } else {
      soundIconOn?.classList.add('hidden');
      soundIconOff?.classList.remove('hidden');
    }
  });

  // Mobile Drawer Elements
  const chatDrawerToggleBtn = document.getElementById('chat-drawer-toggle-btn');
  const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
  const drawerBackdrop = document.getElementById('drawer-backdrop');
  const drawerCloseBtn = document.getElementById('drawer-close-btn');

  function openDrawer() {
    mobileNavDrawer?.classList.remove('hidden');
  }
  function closeDrawer() {
    mobileNavDrawer?.classList.add('hidden');
  }
  chatDrawerToggleBtn?.addEventListener('click', openDrawer);
  drawerBackdrop?.addEventListener('click', closeDrawer);
  drawerCloseBtn?.addEventListener('click', closeDrawer);

  // Favorite Heart Toggle
  const chatFavoriteBtn = document.getElementById('chat-favorite-btn');
  let isFavorite = false;
  chatFavoriteBtn?.addEventListener('click', () => {
    isFavorite = !isFavorite;
    if (isFavorite) {
      chatFavoriteBtn.classList.add('text-rose-500');
      chatFavoriteBtn.classList.remove('text-gray-400');
      playSound('star');
    } else {
      chatFavoriteBtn.classList.remove('text-rose-500');
      chatFavoriteBtn.classList.add('text-gray-400');
    }
  });

  // Quick Emoji Tray & Presets
  const chatEmojiBtn = document.getElementById('chat-emoji-btn');
  const quickEmojiTray = document.getElementById('quick-emoji-tray');
  const chatGifBtn = document.getElementById('chat-gif-btn');
  const quickGifTray = document.getElementById('quick-gif-tray');
  const chatStarBtn = document.getElementById('chat-star-btn');

  chatEmojiBtn?.addEventListener('click', () => {
    quickEmojiTray?.classList.toggle('hidden');
    quickGifTray?.classList.add('hidden');
  });

  document.querySelectorAll('.emoji-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const emoji = btn.textContent || '';
      if (chatInput) {
        chatInput.value += emoji;
        chatInput.focus();
      }
    });
  });

  chatGifBtn?.addEventListener('click', () => {
    quickGifTray?.classList.toggle('hidden');
    quickEmojiTray?.classList.add('hidden');
  });

  document.querySelectorAll('.gif-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.textContent || '';
      if (text) {
        client.sendMessage(text);
        playSound('send');
        quickGifTray?.classList.add('hidden');
      }
    });
  });

  chatStarBtn?.addEventListener('click', () => {
    client.sendMessage('⭐ Sent you a star!');
    playSound('star');
  });

  // Inline Ended Card & Reconnect
  const inlineChatEndedCard = document.getElementById('inline-chat-ended-card');
  const endedCardNick = document.getElementById('ended-card-nick');
  const endedFindMatchBtn = document.getElementById('ended-find-match-btn');
  const endedCardReportBtn = document.getElementById('ended-card-report-btn');
  const menuNextBtn = document.getElementById('menu-next-btn');

  function startNextMatch() {
    currentProfile = strangerProfiles[Math.floor(Math.random() * strangerProfiles.length)];
    client.partner = {
      nickname: currentProfile.name,
      gender: pref === 'anyone' ? 'anyone' : pref,
      country: 'anywhere',
      language: 'any'
    };
    client.clearMessages();
    client.setState('CONNECTED');
    inlineChatEndedCard?.classList.add('hidden');
    updateUI(client);
    playSound('receive');
  }

  endedFindMatchBtn?.addEventListener('click', startNextMatch);
  document.getElementById('chat-header-next-btn')?.addEventListener('click', startNextMatch);
  menuNextBtn?.addEventListener('click', () => {
    chatDropdown?.classList.add('hidden');
    startNextMatch();
  });

  // Modals & Report
  const modalLeave = document.getElementById('modal-leave');
  const modalLeaveCancel = document.getElementById('modal-leave-cancel');
  const modalLeaveConfirm = document.getElementById('modal-leave-confirm');
  const menuLeaveBtn = document.getElementById('menu-leave-btn');
  const modalReport = document.getElementById('modal-report');
  const modalReportClose = document.getElementById('modal-report-close');
  const modalReportCancel = document.getElementById('modal-report-cancel');
  const reportForm = document.getElementById('report-form') as HTMLFormElement;
  const reportReasonSelect = document.getElementById('report-reason-select') as HTMLSelectElement;
  const reportDetailsInput = document.getElementById('report-details-input') as HTMLTextAreaElement;
  const menuReportBtn = document.getElementById('menu-report-btn');
  const modalBlock = document.getElementById('modal-block');
  const modalBlockCancel = document.getElementById('modal-block-cancel');
  const modalBlockConfirm = document.getElementById('modal-block-confirm');
  const menuBlockBtn = document.getElementById('menu-block-btn');

  // Media
  const chatFileInput = document.getElementById('chat-file-input') as HTMLInputElement;
  const chatAttachBtn = document.getElementById('chat-attach-btn');
  const chatMediaPreviewContainer = document.getElementById('chat-media-preview-container');
  const chatImagePreview = document.getElementById('chat-image-preview') as HTMLImageElement;
  const chatVideoPreview = document.getElementById('chat-video-preview') as HTMLVideoElement;
  const chatMediaName = document.getElementById('chat-media-name');
  const chatRemoveMediaBtn = document.getElementById('chat-remove-media-btn');
  const chatLightbox = document.getElementById('chat-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightbox-close');

  let currentAttachedMedia: { type: 'image' | 'video'; data: string; name: string } | null = null;

  function updateUI(c: ChatClient) {
    const rawPartner = c.partner?.nickname || currentProfile.name;
    const partnerDisplay = rawPartner.replace('@', '');

    if (chatStrangerNick) chatStrangerNick.textContent = partnerDisplay;
    if (chatStrangerBio) chatStrangerBio.textContent = currentProfile.bio;
    if (endedCardNick) endedCardNick.textContent = partnerDisplay;

    if (c.state === 'DISCONNECTED') {
      inlineChatEndedCard?.classList.remove('hidden');
      if (chatMessages) {
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }
    } else {
      inlineChatEndedCard?.classList.add('hidden');
    }

    renderMessages(c);
    renderColdGate(c);

    if (c.isPartnerTyping) {
      chatTypingIndicator?.classList.remove('hidden');
    } else {
      chatTypingIndicator?.classList.add('hidden');
    }
  }

  function renderMessages(c: ChatClient) {
    if (!chatMessages) return;
    
    const bubbles = chatMessages.querySelectorAll('.dynamic-user-bubble');
    if (bubbles.length === c.messages.length) return;

    const hadNewMsg = c.messages.length > bubbles.length;

    c.messages.forEach((msg, idx) => {
      if (idx < bubbles.length) return;

      const isMe = msg.sender === 'me';
      const wrapper = document.createElement('div');
      wrapper.className = `dynamic-user-bubble message-bubble flex flex-col ${isMe ? 'items-end self-end' : 'items-start self-start'} gap-0.5 max-w-[85%] sm:max-w-[75%] animate-msg-in`;

      const bubble = document.createElement('div');
      bubble.className = isMe
        ? 'px-3.5 py-2.5 rounded-2xl bg-[var(--primary)] text-white rounded-tr-xs text-sm shadow-xs font-normal'
        : 'px-3.5 py-2.5 rounded-2xl bg-[var(--bg-surface)] text-[var(--text-primary)] rounded-tl-xs border border-[var(--border)] text-sm shadow-xs font-normal';

      if (msg.mediaData) {
        if (msg.mediaType === 'video') {
          const videoEl = document.createElement('video');
          videoEl.src = msg.mediaData;
          videoEl.controls = true;
          videoEl.className = 'max-w-full rounded-xl max-h-60 object-contain bg-black my-1';
          bubble.appendChild(videoEl);
        } else {
          const imgEl = document.createElement('img');
          imgEl.src = msg.mediaData;
          imgEl.alt = 'Shared photo';
          imgEl.className = 'max-w-full rounded-xl max-h-60 object-cover cursor-pointer hover:opacity-95 transition-opacity my-1';
          imgEl.addEventListener('click', () => {
            if (lightboxImg && chatLightbox) {
              lightboxImg.src = msg.mediaData!;
              chatLightbox.classList.remove('hidden');
            }
          });
          bubble.appendChild(imgEl);
        }
      }

      if (msg.text) {
        const textSpan = document.createElement('span');
        textSpan.className = 'leading-relaxed break-words';
        textSpan.textContent = msg.text;
        bubble.appendChild(textSpan);
      }

      wrapper.appendChild(bubble);

      const timeSpan = document.createElement('span');
      timeSpan.className = `text-[10px] text-gray-400 ${isMe ? 'pr-1' : 'pl-1'}`;
      const now = new Date();
      timeSpan.textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      wrapper.appendChild(timeSpan);

      if (inlineChatEndedCard && inlineChatEndedCard.parentNode === chatMessages) {
        chatMessages.insertBefore(wrapper, inlineChatEndedCard);
      } else {
        chatMessages.appendChild(wrapper);
      }
    });

    chatMessages.scrollTop = chatMessages.scrollHeight;

    if (hadNewMsg) {
      const lastMsg = c.messages[c.messages.length - 1];
      if (lastMsg) {
        playSound(lastMsg.sender === 'me' ? 'send' : 'receive');
      }
    }
  }

  function renderColdGate(c: ChatClient) {
    if (c.isColdGated) {
      coldGateBanner?.classList.remove('hidden');
      if (chatSendBtn) chatSendBtn.disabled = true;
    } else {
      coldGateBanner?.classList.add('hidden');
      if (chatSendBtn) chatSendBtn.disabled = false;
    }
  }

  client.subscribe(updateUI);

  // Attachments
  chatAttachBtn?.addEventListener('click', () => chatFileInput?.click());
  chatFileInput?.addEventListener('change', () => {
    const file = chatFileInput.files?.[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
      alert('File size exceeds 5MB limit.');
      chatFileInput.value = '';
      return;
    }
    const isVideo = file.type.startsWith('video/');
    const reader = new FileReader();
    reader.onload = e => {
      const data = e.target?.result as string;
      currentAttachedMedia = {
        type: isVideo ? 'video' : 'image',
        data,
        name: file.name
      };

      if (chatMediaPreviewContainer && chatMediaName) {
        chatMediaName.textContent = file.name;
        chatMediaPreviewContainer.classList.remove('hidden');
        if (isVideo && chatVideoPreview) {
          chatVideoPreview.src = data;
          chatVideoPreview.classList.remove('hidden');
          chatImagePreview?.classList.add('hidden');
        } else if (chatImagePreview) {
          chatImagePreview.src = data;
          chatImagePreview.classList.remove('hidden');
          chatVideoPreview?.classList.add('hidden');
        }
      }
    };
    reader.readAsDataURL(file);
  });

  chatRemoveMediaBtn?.addEventListener('click', () => {
    currentAttachedMedia = null;
    if (chatFileInput) chatFileInput.value = '';
    chatMediaPreviewContainer?.classList.add('hidden');
    chatImagePreview?.classList.add('hidden');
    chatVideoPreview?.classList.add('hidden');
  });

  lightboxClose?.addEventListener('click', () => chatLightbox?.classList.add('hidden'));

  // Composer Form
  chatComposerForm?.addEventListener('submit', e => {
    e.preventDefault();
    const text = chatInput?.value?.trim() || '';
    if (!text && !currentAttachedMedia) return;

    if (currentAttachedMedia) {
      client.sendMessage(text || undefined, currentAttachedMedia.type, currentAttachedMedia.data);
      currentAttachedMedia = null;
      if (chatFileInput) chatFileInput.value = '';
      chatMediaPreviewContainer?.classList.add('hidden');
    } else {
      client.sendMessage(text);
    }

    if (chatInput) {
      chatInput.value = '';
      chatInput.focus();
    }
    quickEmojiTray?.classList.add('hidden');
    quickGifTray?.classList.add('hidden');
  });

  // Typing throttle
  let typingTimer: number | null = null;
  chatInput?.addEventListener('input', () => {
    client.notifyTyping();
    if (typingTimer) clearTimeout(typingTimer);
    typingTimer = window.setTimeout(() => {
      // typing timeout
    }, 1500);
  });

  // Dropdown Menu Toggle
  chatMenuBtn?.addEventListener('click', e => {
    e.stopPropagation();
    chatDropdown?.classList.toggle('hidden');
  });

  document.addEventListener('click', e => {
    if (chatDropdown && !chatDropdown.contains(e.target as Node) && e.target !== chatMenuBtn) {
      chatDropdown.classList.add('hidden');
    }
  });

  // Report & Block Triggers
  endedCardReportBtn?.addEventListener('click', () => modalReport?.classList.remove('hidden'));
  menuReportBtn?.addEventListener('click', () => {
    chatDropdown?.classList.add('hidden');
    modalReport?.classList.remove('hidden');
  });

  modalReportClose?.addEventListener('click', () => modalReport?.classList.add('hidden'));
  modalReportCancel?.addEventListener('click', () => modalReport?.classList.add('hidden'));
  reportForm?.addEventListener('submit', e => {
    e.preventDefault();
    const reason = reportReasonSelect.value as ReportReason;
    const details = reportDetailsInput.value;
    client.submitReport(reason, details);
    modalReport?.classList.add('hidden');
    alert('Report submitted. Thank you for keeping the community safe.');
  });

  menuBlockBtn?.addEventListener('click', () => {
    chatDropdown?.classList.add('hidden');
    modalBlock?.classList.remove('hidden');
  });
  modalBlockCancel?.addEventListener('click', () => modalBlock?.classList.add('hidden'));
  modalBlockConfirm?.addEventListener('click', () => {
    modalBlock?.classList.add('hidden');
    client.blockStranger();
    inlineChatEndedCard?.classList.remove('hidden');
  });

  menuLeaveBtn?.addEventListener('click', () => {
    chatDropdown?.classList.add('hidden');
    modalLeave?.classList.remove('hidden');
  });
  modalLeaveCancel?.addEventListener('click', () => modalLeave?.classList.add('hidden'));
  modalLeaveConfirm?.addEventListener('click', () => {
    modalLeave?.classList.add('hidden');
    client.leaveChat();
    inlineChatEndedCard?.classList.remove('hidden');
  });

  document.getElementById('menu-clear-btn')?.addEventListener('click', () => {
    chatDropdown?.classList.add('hidden');
    client.clearMessages();
  });

  // Initialize Session
  client.partner = {
    nickname: currentProfile.name,
    gender: pref === 'anyone' ? 'anyone' : pref,
    country: 'anywhere',
    language: 'any'
  };
  client.enterQueue(nick, gender, pref, country, language);
  client.setState('CONNECTED');
  updateUI(client);
</script>
