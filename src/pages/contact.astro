---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

import { getLangFromUrl } from '../i18n/utils';

const currentLang = Astro.currentLocale || getLangFromUrl(Astro.url) || 'en';
---

<BaseLayout
  title={`Contact Support & Safety — ${siteConfig.name}`}
  description={`Contact the ${siteConfig.name} support and safety team for general questions, abuse reports, technical issues, or privacy inquiries.`}
  canonical={`${siteConfig.url}/contact`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 flex flex-col gap-8">
    <!-- Header -->
    <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2 text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
        <Icon name="help-circle" class="w-3.5 h-3.5" />
        <span>Support & Safety</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        Contact {siteConfig.name}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)]">
        Have feedback, questions, or safety concerns? Reach out to our team.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Direct Email Cards -->
      <div class="flex flex-col gap-4 text-xs text-[var(--text-secondary)] text-left">
        <div class="card-tactile p-5 flex flex-col gap-2">
          <span class="font-bold text-sm text-[var(--text-primary)]">Direct Email Support</span>
          <a href={`mailto:${siteConfig.supportEmail}`} class="text-[var(--primary)] font-mono font-bold text-sm hover:underline">{siteConfig.supportEmail}</a>
          <p class="text-[11px] text-[var(--text-muted)] mt-1">
            Official support, abuse reports, privacy inquiries, and technical questions.
          </p>
        </div>
        <div class="card-tactile p-5 flex flex-col gap-1.5">
          <span class="font-bold text-xs text-[var(--text-primary)]">Response Time</span>
          <p class="text-[11px] text-[var(--text-muted)]">
            Our team reviews all incoming messages and typically replies within 24 to 48 hours.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="md:col-span-2 card-tactile p-6 sm:p-8 flex flex-col gap-5 text-left">
        <h2 class="text-lg font-bold text-[var(--text-primary)]">Send a Message</h2>

        <form id="contact-form" class="flex flex-col gap-4">
          <!-- Name -->
          <div class="flex flex-col gap-1">
            <label for="contact-name" class="text-xs font-semibold text-[var(--text-primary)]">Your Name or Nickname</label>
            <input
              id="contact-name"
              type="text"
              required
              placeholder="e.g. Alex"
              class="px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-input)] text-sm text-[var(--text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]"
            />
          </div>

          <!-- Email -->
          <div class="flex flex-col gap-1">
            <label for="contact-email" class="text-xs font-semibold text-[var(--text-primary)]">Your Email (for response)</label>
            <input
              id="contact-email"
              type="email"
              required
              placeholder="name@example.com"
              class="px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-input)] text-sm text-[var(--text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]"
            />
          </div>

          <!-- Reason -->
          <div class="flex flex-col gap-1">
            <label for="contact-reason" class="text-xs font-semibold text-[var(--text-primary)]">Inquiry Reason</label>
            <select
              id="contact-reason"
              class="px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-input)] text-sm text-[var(--text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)]"
            >
              <option value="general">General Question</option>
              <option value="abuse">Abuse / Safety Report</option>
              <option value="technical">Technical Problem</option>
              <option value="privacy">Privacy Question</option>
              <option value="business">Partnership / Other</option>
            </select>
          </div>

          <!-- Message -->
          <div class="flex flex-col gap-1">
            <label for="contact-message" class="text-xs font-semibold text-[var(--text-primary)]">Message</label>
            <textarea
              id="contact-message"
              rows="4"
              required
              placeholder="Please describe your question or issue in detail..."
              class="px-4 py-2.5 rounded-xl border border-[var(--border)] bg-[var(--bg-input)] text-sm text-[var(--text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] resize-none"
            ></textarea>
          </div>

          <!-- Notice & Submit Button -->
          <div class="pt-2 flex flex-col gap-3">
            <span id="contact-status" class="hidden text-xs text-emerald-600 dark:text-emerald-400 font-semibold">✓ Message sent! Our team will respond within 24-48 hours.</span>
            <button
              type="submit"
              class="btn-primary text-sm py-3 px-6 shadow-md"
            >
              <span>Send Message</span>
              <Icon name="send" class="w-4 h-4" />
            </button>
            <span class="text-[11px] text-[var(--text-muted)] text-center">
              Direct inquiries are encrypted in transit. Please do not submit passwords or sensitive documents.
            </span>
          </div>
        </form>
      </div>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('contact-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (statusEl) {
      statusEl.classList.remove('hidden');
      form.reset();
      setTimeout(() => {
        statusEl.classList.add('hidden');
      }, 4000);
    }
  });
</script>
