---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingNavbar from '../components/landing/LandingNavbar.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Icon from '../components/icons/Icon.astro';
import { siteConfig } from '../config/site';

const currentLang = Astro.cookies?.get('rc_language')?.value || Astro.url?.searchParams?.get('lang') || 'en';
---

<BaseLayout
  title={`500 — Server Error | ${siteConfig.name}`}
  canonical={`${siteConfig.url}/500`}
  lang={currentLang}
  noindex={true}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 flex flex-col items-center justify-center text-center p-6 my-12">
    <div class="max-w-md mx-auto flex flex-col items-center gap-6 p-8 sm:p-10 card-tactile shadow-xl animate-modal-in">
      <div class="w-16 h-16 rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center">
        <Icon name="shield-check" class="w-8 h-8" />
      </div>

      <div class="flex flex-col gap-2">
        <span class="text-xs font-bold uppercase tracking-widest text-[var(--danger)]">Error 500</span>
        <h1 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)]">
          Server error
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          Something unexpected occurred on our end. Please refresh or try again in a few moments.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full">
        <a
          href="/"
          class="btn-secondary text-xs py-3 px-5 w-full text-center"
        >
          Back Home
        </a>
        <a
          href="/start"
          class="btn-primary text-xs py-3 px-5 w-full text-center"
        >
          <span>Try Again</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </main>

  <LandingFooter />
</BaseLayout>
