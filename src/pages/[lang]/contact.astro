---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingNavbar from '../../components/landing/LandingNavbar.astro';
import LandingFooter from '../../components/landing/LandingFooter.astro';
import Icon from '../../components/icons/Icon.astro';
import { siteConfig } from '../../config/site';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as SupportedLang;
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

export const prerender = true;
---

<BaseLayout
  title={`${t.nav.contact} — ${siteConfig.name}`}
  description={`${t.nav.contact} support team for ${siteConfig.name}.`}
  canonical={`${siteConfig.url}/${currentLang}/contact`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 flex flex-col gap-8">
    <!-- Header -->
    <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2 text-left">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
        <Icon name="help-circle" class="w-3.5 h-3.5" />
        <span>{t.nav.contact}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        {t.nav.contact} — {siteConfig.name}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)]">
        {t.brand.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Direct Email Cards -->
      <div class="flex flex-col gap-4 text-xs text-[var(--text-secondary)] text-left">
        <div class="card-tactile p-5 flex flex-col gap-2">
          <span class="font-bold text-sm text-[var(--text-primary)]">Email Support</span>
          <a href={`mailto:${siteConfig.supportEmail}`} class="text-[var(--primary)] font-mono font-bold text-sm hover:underline">{siteConfig.supportEmail}</a>
          <p class="text-[11px] text-[var(--text-muted)] mt-1">
            {siteConfig.name} Official Support
          </p>
        </div>
      </div>

      <!-- Quick Info -->
      <div class="md:col-span-2 card-tactile p-6 sm:p-8 flex flex-col gap-5 text-left">
        <h2 class="text-lg font-bold text-[var(--text-primary)]">{t.safetyBanner.title}</h2>
        <p class="text-sm text-[var(--text-secondary)]">
          {t.safetyBanner.tip1}
        </p>
        <p class="text-sm text-[var(--text-secondary)]">
          {t.safetyBanner.tip2}
        </p>
        <div class="pt-4 border-t border-[var(--border)]">
          <a href={translatePath('/start')} class="btn-primary text-xs py-2.5 px-5">
            <span>{t.nav.startChat}</span>
            <Icon name="arrow-right" class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="pt-6 border-t border-[var(--border)] flex items-center justify-between">
      <a href={translatePath('/')} class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] underline">&larr; {siteConfig.name}</a>
    </div>
  </main>

  <LandingFooter lang={currentLang} />
</BaseLayout>
