---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingNavbar from '../../components/landing/LandingNavbar.astro';
import LandingFooter from '../../components/landing/LandingFooter.astro';
import Icon from '../../components/icons/Icon.astro';
import { siteConfig } from '../../config/site';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as SupportedLang;
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

export const prerender = true;
---

<BaseLayout
  title={`Cookie Policy — ${siteConfig.name}`}
  description={`${siteConfig.name} Cookie Policy & Minimal Storage`}
  canonical={`${siteConfig.url}/${currentLang}/cookie-policy`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 py-12">
    <div class="card-tactile p-6 sm:p-10 shadow-sm flex flex-col gap-8 text-left">
      <!-- Page Header -->
      <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
          <Icon name="shield-check" class="w-3.5 h-3.5" />
          <span>{t.safetyBanner.title}</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
          Cookie Policy
        </h1>
        <p class="text-xs text-[var(--text-muted)]">
          {siteConfig.name} &bull; {t.footer.disclaimer}
        </p>
      </div>

      <!-- Content Sections -->
      <div class="max-w-none text-sm text-[var(--text-secondary)] space-y-6 leading-relaxed">
        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">1. {t.brand.noAccount}</h2>
          <p>
            {t.brand.description}
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="text-xl font-bold text-[var(--text-primary)]">2. {t.safetyBanner.title}</h2>
          <p>
            {t.safetyBanner.tip1}
          </p>
          <p>
            {t.safetyBanner.tip3}
          </p>
        </section>
      </div>

      <!-- Back Action -->
      <div class="pt-6 border-t border-[var(--border)] flex items-center justify-between">
        <a href={translatePath('/')} class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] underline">&larr; {siteConfig.name}</a>
        <a href={translatePath('/start')} class="btn-primary text-xs py-2.5 px-5">
          <span>{t.nav.startChat}</span>
          <Icon name="arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </main>

  <LandingFooter lang={currentLang} />
</BaseLayout>
