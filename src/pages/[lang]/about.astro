---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LandingNavbar from '../../components/landing/LandingNavbar.astro';
import LandingFooter from '../../components/landing/LandingFooter.astro';
import Icon from '../../components/icons/Icon.astro';
import { siteConfig } from '../../config/site';
import { useTranslations, useTranslatedPath } from '../../i18n/utils';
import type { SupportedLang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
    { params: { lang: 'pt' } },
    { params: { lang: 'ko' } },
    { params: { lang: 'it' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as SupportedLang;
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);

export const prerender = true;
---

<BaseLayout
  title={`${t.nav.about} — ${siteConfig.name}`}
  description={`${t.brand.description}`}
  canonical={`${siteConfig.url}/${currentLang}/about`}
  lang={currentLang}
>
  <LandingNavbar lang={currentLang} />

  <main class="flex-1 max-w-3xl mx-auto px-4 py-12 flex flex-col gap-8">
    <!-- Header -->
    <div class="border-b border-[var(--border)] pb-6 flex flex-col gap-2">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] text-xs font-bold w-fit">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        <span>{t.nav.about}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] tracking-tight">
        {siteConfig.name} — {t.brand.tagline}
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)]">
        {t.hero.subheadline}
      </p>
    </div>

    <!-- Core Philosophy -->
    <div class="max-w-none text-sm text-[var(--text-secondary)] space-y-6 leading-relaxed">
      <div class="card-tactile p-6 flex flex-col gap-3">
        <h2 class="text-lg font-bold text-[var(--text-primary)]">{t.safetyBanner.title}</h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
          {t.brand.description}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs">
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            {t.brand.noAccount}
          </div>
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            {t.brand.freeInstant}
          </div>
          <div class="p-3 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border)] text-center font-semibold text-[var(--text-primary)]">
            {t.safetyBanner.ageNotice}
          </div>
        </div>
      </div>

      <section class="space-y-2">
        <h2 class="text-xl font-bold text-[var(--text-primary)]">{t.howItWorks.title}</h2>
        <p>
          {t.howItWorks.step1Title}: {t.howItWorks.step1Desc}
        </p>
        <p>
          {t.howItWorks.step2Title}: {t.howItWorks.step2Desc}
        </p>
        <p>
          {t.howItWorks.step3Title}: {t.howItWorks.step3Desc}
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-xl font-bold text-[var(--text-primary)]">{t.nav.safety}</h2>
        <p>
          {t.safetyBanner.tip1}
        </p>
        <p>
          {t.safetyBanner.tip2}
        </p>
        <p>
          {t.safetyBanner.tip3}
        </p>
      </section>
    </div>

    <!-- CTA -->
    <div class="pt-6 border-t border-[var(--border)] flex items-center justify-between">
      <a href={translatePath('/')} class="text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] underline">&larr; {siteConfig.name}</a>
      <a href={translatePath('/start')} class="btn-primary text-xs py-2.5 px-5">
        <span>{t.nav.startChat}</span>
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </main>

  <LandingFooter lang={currentLang} />
</BaseLayout>
