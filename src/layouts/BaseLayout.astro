---
import '../styles/global.css';
import AgeGateModal from '../components/AgeGateModal.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { siteConfig } from '../config/site';
import { getLangFromUrl, getHreflangLinks } from '../i18n/utils';
import { languageOgLocales, type SupportedLang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  canonical = siteConfig.url,
  lang,
  ogImage = `${siteConfig.url}/og-image.png`,
  noindex = false
} = Astro.props;

// Determine language from prop, Astro.currentLocale, or URL path (e.g. /es, /ja)
const currentLang = (lang || Astro.currentLocale || getLangFromUrl(Astro.url) || 'en') as SupportedLang;
const isRtl = (currentLang as string) === 'ar';
const hreflangLinks = getHreflangLinks(Astro.url);
const currentOgLocale = languageOgLocales[currentLang] || 'en_US';
const alternateOgLocales = Object.entries(languageOgLocales)
  .filter(([l]) => l !== currentLang)
  .map(([, og]) => og);
---

<!doctype html>
<html lang={currentLang} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Hreflang Markup for International SEO -->
    {hreflangLinks.map(item => (
      <link rel="alternate" hreflang={item.lang} href={item.url} />
    ))}

    <!-- Preconnect & DNS-Prefetch for Font Delivery Performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" />
    </noscript>

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    <meta name="theme-color" content="#0E1015" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentOgLocale} />
    {alternateOgLocales.map(loc => (
      <meta property="og:locale:alternate" content={loc} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteConfig.url}/#website`,
          "url": siteConfig.url,
          "name": siteConfig.name,
          "description": siteConfig.description,
          "inLanguage": currentLang,
          "potentialAction": {
            "@type": "EntryPoint",
            "urlTemplate": `${siteConfig.url}/chat`,
            "actionPlatform": [
              "http://schema.org/DesktopWebPlatform",
              "http://schema.org/MobileWebPlatform"
            ]
          }
        },
        {
          "@type": "WebApplication",
          "@id": `${siteConfig.url}/#webapp`,
          "name": siteConfig.name,
          "url": siteConfig.url,
          "description": siteConfig.description,
          "applicationCategory": "CommunicationApplication",
          "operatingSystem": "All",
          "browserRequirements": "Requires JavaScript. Requires HTML5.",
          "inLanguage": currentLang,
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      ]
    })} />

    <!-- Zero-FOUC Theme & Language Script -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches) || stored === 'system';
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        const savedLang = localStorage.getItem('rc_language');
        if (savedLang) {
          document.documentElement.lang = savedLang;
          document.documentElement.dir = savedLang === 'ar' ? 'rtl' : 'ltr';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-[var(--bg-page)] text-[var(--text-primary)] font-sans selection:bg-[var(--primary)] selection:text-white">
    <!-- Accessible Skip to Main Content Link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Accessible Screen Reader Announcer -->
    <div id="sr-announcer" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

    <!-- 18+ Age Verification Modal -->
    <AgeGateModal />

    <!-- Cookie Consent Banner -->
    <CookieConsent lang={currentLang} />

    <slot />

    <!-- Client-side script initialization -->
    <script>
      import { initTheme } from '../scripts/theme';
      initTheme();
    </script>
  </body>
</html>
