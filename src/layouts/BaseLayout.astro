---
import '../styles/global.css';
import AgeGateModal from '../components/AgeGateModal.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  lang?: string;
}

const {
  title = 'randomcaht.online — Free Anonymous Random Text Chat',
  description = 'Connect and chat with compatible strangers instantly. Free, anonymous-by-default random text chat. No account, no signup required.',
  canonical = 'https://randomcaht.online',
  lang = 'en'
} = Astro.props;

const currentLang = Astro.cookies.get('rc_language')?.value || Astro.url.searchParams.get('lang') || lang || 'en';
const isRtl = currentLang === 'ar';
---

<!doctype html>
<html lang={currentLang} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GJTQW9LZ5W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GJTQW9LZ5W');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#07111B" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="RandomChat" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Zero-FOUC Theme & Language Script -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches) || stored === 'system';
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        const savedLang = localStorage.getItem('rc_language');
        if (savedLang) {
          document.documentElement.lang = savedLang;
          document.documentElement.dir = savedLang === 'ar' ? 'rtl' : 'ltr';
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-[var(--bg-page)] text-[var(--text-primary)] font-sans selection:bg-[#6C4DFF] selection:text-white">
    <!-- Accessible Screen Reader Announcer -->
    <div id="sr-announcer" class="sr-only" aria-live="assertive" aria-atomic="true"></div>

    <!-- 18+ Age Verification Modal -->
    <AgeGateModal />

    <!-- Cookie Consent Banner -->
    <CookieConsent lang={currentLang} />

    <slot />

    <!-- Client-side script initialization -->
    <script>
      import { initTheme } from '../scripts/theme';
      initTheme();
    </script>
  </body>
</html>
