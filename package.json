{
  "name": "randomcaht-online",
  "type": "module",
  "version": "1.0.0",
  "description": "Free, anonymous-by-default random text-chat platform",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "deploy:workers": "astro build && wrangler deploy",
    "deploy:pages": "astro build && wrangler pages deploy dist --project-name randomcaht-online",
    "deploy:preview": "astro build && wrangler deploy --temporary",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "astro": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.123.0"
  }
}
